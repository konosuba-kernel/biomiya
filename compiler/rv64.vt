// Typed slots to RV64. No source text or AST is visible in this module.
module bootstrap::rv64;
import bootstrap::model;
import bootstrap::image;
import bootstrap::ir;
import bootstrap::target;
static mut panic_symbol:u32 = 0;
static mut copy_symbol:u32 = 0;
static mut labels:[65537]u32 = zero;
// Only this target owns frame offsets; semantic Slots remain unchanged.
// Every active slot is assigned before emission, so old entries need no clearing.
static mut frame_offsets:[32769]usize = zero;
// Includes definitions and references, including sparse labels in malformed IR.
static mut label_high:u32 = 0;
// Explicit DFS storage bounds type validation independently of machine call depth.
static mut type_state:[8193]u8 = zero;
static mut type_stack:[8193]model::TypeEntry = zero;
static mut type_edge:[8193]u32 = zero;
static mut label_defs:[65537]u8 = zero;
static mut save:usize = 0;
static mut result_pointer:usize = 0;
static mut frame_size:usize = 0;
static mut frame_align:usize = 16;
static mut current:u32 = 0;
static mut checked_revision:u32 = 0;
static mut here:model::Span = zero;
fn bad() -> () {
    unsafe {
        model::fail(model::ERROR_INTERNAL, here.file, here.start as usize);
    }
    return ();
}

fn reg(n:u32) -> () {
    if n >= 32_u32 {
        bad();
    }
    return ();
}

pub fn r(f7:u32, f3:u32, rd:u32, a:u32, b:u32) -> () {
    reg(rd);
    reg(a);
    reg(b);
    image::word((f7 << 25_u32) | (b << 20_u32) | (a << 15_u32) | (f3 << 12_u32) | (rd << 7_u32) | 51_u32);
    return ();
}

pub fn i(opcode:u32, f3:u32, rd:u32, a:u32, n:usize) -> () {
    reg(rd);
    reg(a);
    image::word((((n & 4095_usize) as u32) << 20_u32) | (a << 15_u32) | (f3 << 12_u32) | (rd << 7_u32) | opcode);
    return ();
}

pub fn s(f3:u32, rs:u32, base:u32, n:usize) -> () {
    reg(rs);
    reg(base);
    let v:u32 = (n & 4095_usize) as u32;
    image::word(((v >> 5_u32) << 25_u32) | (rs << 20_u32) | (base << 15_u32) | (f3 << 12_u32) | ((v & 31_u32) << 7_u32) | 35_u32);
    return ();
}

pub fn constant(rd:u32, n:usize) -> () {
    if n <= 2047_usize || n >= 18446744073709549568_usize {
        i(19, 0, rd, 0, n);
        return ();
    }
    let lo:usize = n & 4095_usize;
    var high:usize = n >> 12_usize;
    if n >= 9223372036854775808_usize {
        high = high | 18442240474082181120_usize;
    }
    if lo >= 2048_usize {
        high = high+%1_usize;
    }
    constant(rd, high);
    i(19, 1, rd, rd, 12);
    if lo != 0_usize {
        i(19, 0, rd, rd, lo);
    }
    return ();
}

pub fn transfer(rd:u32, target:u32, jump:bool) -> () {
    reg(rd);
    if !jump && rd == 0_u32 {
        bad();
    }
    if jump && rd != 0_u32 && rd != 1_u32 {
        bad();
    }
    image::fixup(image::text_position(), target, rd, jump);
    return ();
}

pub fn branch(f3:u32, a:u32, b:u32, target:u32) -> () {
    reg(a);
    reg(b);
    if f3 != 0_u32 && f3 != 1_u32 && f3 != 6_u32 && f3 != 7_u32 {
        bad();
    }
    image::word((b << 20_u32) | (a << 15_u32) | ((f3 ^ 1_u32) << 12_u32) | 1536_u32 | 99_u32);
    transfer(0, target, true);
    return ();
}

fn mark(id:u32) -> () {
    image::define(id, 1, image::text_position());
    return ();
}

fn mov(dst:u32, src:u32) -> () {
    i(19, 0, dst, src, 0);
    return ();
}

fn address(rd:u32, base:u32, off:usize) -> () {
    if off <= 2047_usize {
        i(19, 0, rd, base, off);
    } else {
        var temp:u32 = rd;
        if rd == base {
            temp = 29;
        }
        constant(temp, off);
        r(0, 0, rd, base, temp);
    }
    return ();
}

fn load(rd:u32, base:u32, off:usize, size:usize) -> () {
    if size == 0_usize {
        constant(rd, 0);
        return ();
    }
    var f3:u32 = 3;
    if size == 1_usize {
        f3 = 4;
    } else if size == 4_usize {
        f3 = 6;
    } else if size != 8_usize {
        bad();
    }
    if off <= 2047_usize {
        i(3, f3, rd, base, off);
    } else {
        address(31, base, off);
        i(3, f3, rd, 31, 0);
    }
    return ();
}

fn store(rs:u32, base:u32, off:usize, size:usize) -> () {
    if size == 0_usize {
        return ();
    }
    var f3:u32 = 3;
    if size == 1_usize {
        f3 = 0;
    } else if size == 4_usize {
        f3 = 2;
    } else if size != 8_usize {
        bad();
    }
    if off <= 2047_usize {
        s(f3, rs, base, off);
    } else {
        address(31, base, off);
        s(f3, rs, 31, 0);
    }
    return ();
}

fn info(id:model::TypeId) -> model::Type {
    unsafe {
        if model::is_no_type(id) || model::type_index(id) > model::type_count() {
            bad();
        }
        let ty:model::Type = model::get_type(id);
        if ty.kind == model::TYPE_INVALID || ty.kind > model::TYPE_ENUM || ty.align == 0_usize || ty.align > 4096_usize || (ty.align & (ty.align-1_usize)) != 0_usize {
            bad();
        }
        var expected:usize = ty.size;
        if ty.kind == model::TYPE_UNIT {
            expected = 0;
        }
        if ty.kind == model::TYPE_BOOL || ty.kind == model::TYPE_U8 {
            expected = 1;
        }
        if ty.kind == model::TYPE_U32 {
            expected = 4;
        }
        if ty.kind == model::TYPE_USIZE || ty.kind == model::TYPE_POINTER {
            expected = 8;
        }
        if ty.kind == model::TYPE_SLICE {
            expected = 16;
        }
        if ty.size != expected {
            bad();
        }
        if ty.kind == model::TYPE_POINTER || ty.kind == model::TYPE_ARRAY || ty.kind == model::TYPE_SLICE {
            if model::is_no_type(ty.element) || model::type_index(ty.element) > model::type_count() {
                bad();
            }
        }
        if ty.kind == model::TYPE_ENUM {
            if ty.owner == 0_u32 || ty.owner > model::decl_count() || ty.flags != 0_u32 || ty.count == 0_u32 {
                bad();
            }
            let owner:model::Decl = model::get_decl(ty.owner);
            if owner.kind != model::DECL_ENUM || !model::same_type(owner.ty, id) {
                bad();
            }
        }
        return ty;
    }
}

// Only value edges require completed child layout. Pointers and slices terminate.
fn layout_child(ty:model::Type, edge:u32) -> model::TypeId {
    if ty.kind == model::TYPE_ARRAY && edge == 0_u32 {
        return ty.element;
    }
    if ty.kind == model::TYPE_STRUCT || ty.kind == model::TYPE_ENUM {
        unsafe {
            if ty.count != 0_u32 && (ty.first == 0_u32 || ty.first > model::field_count() || ty.count > model::field_count()-ty.first+1_u32) {
                bad();
            }
            if edge < ty.count {
                return model::get_field(ty.first+edge).ty;
            }
        }
    }
    return model::no_type();
}

fn finite_layouts() -> () {
    unsafe {
        if model::type_count() == 0_u32 || model::type_count() > 8192_u32 || model::field_count() > 32768_u32 {
            bad();
        }
        var cleared:u32 = 1;
        while cleared <= model::type_count() {
            type_state[cleared as usize] = 0;
            cleared = cleared+1_u32;
        }
        var root:model::TypeId = model::first_type();
        while !model::is_no_type(root) {
            if type_state[model::type_index(root) as usize] == 0_u8 {
                var depth:usize = 1;
                type_stack[depth] = model::TypeEntry::Value(root);
                type_edge[depth] = 0;
                type_state[model::type_index(root) as usize] = 1;
                while depth != 0_usize {
                    let id:model::TypeId = model::entry_type(type_stack[depth]);
                    let child:model::TypeId = layout_child(info(id), type_edge[depth]);
                    if model::is_no_type(child) {
                        type_state[model::type_index(id) as usize] = 2;
                        depth = depth-1_usize;
                    } else {
                        let checked:model::Type = info(child);
                        type_edge[depth] = type_edge[depth]+1_u32;
                        if type_state[model::type_index(child) as usize] == 1_u8 {
                            bad();
                        }
                        if type_state[model::type_index(child) as usize] == 0_u8 {
                            if depth >= 8192_usize {
                                bad();
                            }
                            depth = depth+1_usize;
                            type_stack[depth] = model::TypeEntry::Value(child);
                            type_edge[depth] = 0;
                            type_state[model::type_index(child) as usize] = 1;
                        }
                    }
                }
            }
            root = model::next_type(root);
        }
    }
    return ();
}

fn layouts() -> () {
    finite_layouts();
    unsafe {
        var id:model::TypeId = model::first_type();
        while !model::is_no_type(id) {
            let ty:model::Type = info(id);
            var size:usize = ty.size;
            var alignment:usize = ty.align;
            if ty.kind <= model::TYPE_POINTER {
                alignment = ty.size;
                if alignment == 0_usize {
                    alignment = 1;
                }
            }
            if ty.kind == model::TYPE_POINTER || ty.kind == model::TYPE_SLICE {
                if ty.flags > model::TYPE_CONST {
                    bad();
                }
            }
            if ty.kind == model::TYPE_SLICE {
                alignment = 8;
            }
            if ty.kind == model::TYPE_ARRAY {
                let element:model::Type = info(ty.element);
                alignment = element.align;
                if ty.b != 0_u32 && element.size > 67108864_usize/(ty.b as usize) {
                    bad();
                }
                size = element.size*(ty.b as usize);
            }
            if ty.kind == model::TYPE_STRUCT {
                if ty.count != 0_u32 && (ty.first == 0_u32 || ty.first > model::field_count() || ty.count > model::field_count()-ty.first+1_u32) {
                    bad();
                }
                size = 0;
                alignment = 1;
                var field:u32 = 0;
                while field < ty.count {
                    let item:model::Field = model::get_field(ty.first+field);
                    let ft:model::Type = info(item.ty);
                    size = image::aligned(size, ft.align);
                    if item.offset != size || ft.size > 67108864_usize-size {
                        bad();
                    }
                    size = size+ft.size;
                    if ft.align > alignment {
                        alignment = ft.align;
                    }
                    field = field+1_u32;
                }
                size = image::aligned(size, alignment);
            }
            if ty.kind == model::TYPE_ENUM {
                // Tag is always u32; every variant shares one aligned payload.
                // Explicit Unit payload and a nullary tag have distinct flags.
                size = 0;
                alignment = 4;
                var field:u32 = 0;
                while field < ty.count {
                    let item:model::Field = model::get_field(ty.first+field);
                    let payload:model::Type = info(item.ty);
                    if item.flags != 0_u32 && item.flags != model::FLAG_PAYLOAD {
                        bad();
                    }
                    if item.flags == 0_u32 && !model::same_type(item.ty, model::unit_type()) {
                        bad();
                    }
                    if item.offset != (ty.b as usize) {
                        bad();
                    }
                    if payload.align > alignment {
                        alignment = payload.align;
                    }
                    if payload.size > size {
                        size = payload.size;
                    }
                    field = field+1_u32;
                }
                let payload:usize = image::aligned(4, alignment);
                if (ty.b as usize) != payload || size > 67108864_usize-payload {
                    bad();
                }
                size = image::aligned(size+payload, alignment);
            }
            if ty.size != size || ty.align != alignment {
                bad();
            }
            id = model::next_type(id);
        }
    }
    return ();
}

fn slot(id:ir::SlotId) -> ir::Slot {
    return ir::get_slot(id);
}

fn frame_offset(id:ir::SlotId) -> usize {
    unsafe {
        return frame_offsets[ir::slot_index(id) as usize];
    }
}

fn scalar(ty:model::Type) -> bool {
    return ty.kind <= model::TYPE_POINTER;
}

fn integer(ty:model::Type) -> bool {
    return ty.kind >= model::TYPE_U8 && ty.kind <= model::TYPE_USIZE;
}

fn stype(id:ir::SlotId) -> model::Type {
    return info(slot(id).ty);
}

fn same(a:ir::SlotId, b:ir::SlotId) -> () {
    if !model::same_type(slot(a).ty, slot(b).ty) {
        bad();
    }
    return ();
}

fn value(id:ir::SlotId, rd:u32) -> () {
    let item:ir::Slot = slot(id);
    let ty:model::Type = info(item.ty);
    if !scalar(ty) {
        bad();
    }
    load(rd, 2, frame_offset(id), ty.size);
    return ();
}

fn destination(id:ir::SlotId, rd:u32) -> () {
    address(rd, 2, frame_offset(id));
    return ();
}

fn normalize(rd:u32, ty:model::Type) -> () {
    if ty.kind == model::TYPE_U8 {
        i(19, 1, rd, rd, 56);
        i(19, 5, rd, rd, 56);
    }
    if ty.kind == model::TYPE_U32 {
        i(19, 1, rd, rd, 32);
        i(19, 5, rd, rd, 32);
    }
    return ();
}

fn extension(rd:u32, ty:model::Type) -> () {
    if ty.kind >= model::TYPE_BOOL && ty.kind <= model::TYPE_U32 {
        i(27, 0, rd, rd, 0);
    }
    return ();
}

fn panic() -> () {
    unsafe {
        transfer(1, panic_symbol, true);
    }
    image::word(3221229683);
    return ();
}

fn guard(f3:u32, a:u32, b:u32) -> () {
    let good:u32 = image::fresh();
    branch(f3, a, b, good);
    panic();
    mark(good);
    return ();
}

// memmove with t0 destination, t1 source; no argument registers are clobbered.
fn copy(size:usize) -> () {
    if size == 0_usize {
        return ();
    }
    constant(7, size);
    unsafe {
        transfer(1, copy_symbol, true);
    }
    return ();
}

fn copy_body() -> () {
    let backward:u32 = image::fresh();
    let forward:u32 = image::fresh();
    let reverse:u32 = image::fresh();
    let done:u32 = image::fresh();
    branch(0, 5, 6, done);
    branch(6, 6, 5, backward);
    mark(forward);
    load(28, 6, 0, 1);
    store(28, 5, 0, 1);
    i(19, 0, 5, 5, 1);
    i(19, 0, 6, 6, 1);
    i(19, 0, 7, 7, 18446744073709551615);
    branch(1, 7, 0, forward);
    transfer(0, done, true);
    mark(backward);
    r(0, 0, 5, 5, 7);
    r(0, 0, 6, 6, 7);
    mark(reverse);
    i(19, 0, 5, 5, 18446744073709551615);
    i(19, 0, 6, 6, 18446744073709551615);
    load(28, 6, 0, 1);
    store(28, 5, 0, 1);
    i(19, 0, 7, 7, 18446744073709551615);
    branch(1, 7, 0, reverse);
    mark(done);
    i(103, 0, 0, 1, 0);
    return ();
}

fn declaration(id:u32) -> model::Decl {
    unsafe {
        if id == 0_u32 || id > model::decl_count() {
            bad();
        }
        let decl:model::Decl = model::get_decl(id);
        if decl.kind != model::DECL_FUNCTION && decl.kind != model::DECL_EXTERN {
            bad();
        }
        if decl.count > 256_u32 || (decl.count != 0_u32 && (decl.first == 0_u32 || decl.first > model::param_count() || decl.count > model::param_count()-decl.first+1_u32)) {
            bad();
        }
        let result:model::Type = info(decl.ty);
        var p:u32 = 0;
        while p < decl.count {
            let ty:model::Type = info(model::get_param(decl.first+p).ty);
            if decl.kind == model::DECL_EXTERN && (!scalar(ty) || ty.kind == model::TYPE_UNIT) {
                bad();
            }
            p = p+1_u32;
        }
        if decl.kind == model::DECL_EXTERN && (!scalar(result) || (decl.flags & model::FLAG_UNSAFE) == 0_u32) {
            bad();
        }
        if decl.symbol == 0_u32 || decl.symbol > image::symbol_count() {
            bad();
        }
        return decl;
    }
}

fn positions(decl:model::Decl) -> usize {
    var n:usize = 0;
    let result:model::Type = info(decl.ty);
    if !scalar(result) && result.size != 0_usize {
        n = 1;
    }
    var p:u32 = 0;
    unsafe {
        while p < decl.count {
            if info(model::get_param(decl.first+p).ty).size != 0_usize {
                n = n+1_usize;
            }
            p = p+1_u32;
        }
    }
    return n;
}

fn outgoing_size(decl:model::Decl) -> usize {
    let n:usize = positions(decl);
    if n <= 8_usize {
        return 0;
    }
    return image::aligned((n-8_usize)*8_usize, 16);
}

fn incoming(position:usize, rd:u32) -> () {
    if position < 8_usize {
        mov(rd, 10_u32+(position as u32));
    } else {
        load(rd, 8, (position-8_usize)*8_usize, 8);
    }
    return ();
}

fn outgoing(position:usize, rs:u32) -> () {
    if position < 8_usize {
        mov(10_u32+(position as u32), rs);
    } else {
        store(rs, 2, (position-8_usize)*8_usize, 8);
    }
    return ();
}

fn label(value:ir::LabelId) -> u32 {
    let id:u32 = ir::label_index(value);
    unsafe {
        if id == 0_u32 || id > 65536_u32 {
            bad();
        }
        if id > label_high {
            label_high = id;
        }
        if labels[id as usize] == 0_u32 {
            labels[id as usize] = image::fresh();
        }
        return labels[id as usize];
    }
}

enum Flow {
    Next,
    Label(ir::LabelId),
    End,
    Call(u32)
}

fn check_result(value:ir::Destination, ty:model::TypeId) -> () {
    match value {
        ir::Destination::Unit => {
            if !model::same_type(ty, model::unit_type()) {
                bad();
            }
        },
        ir::Destination::Slot(id) => {
            if !model::same_type(slot(id).ty, ty) {
                bad();
            }
        },
    }
    return ();
}

fn result_slot(value:ir::Destination) -> ir::SlotId {
    match value {
        ir::Destination::Unit => {
            bad();
            return ir::no_slot();
        },
        ir::Destination::Slot(id) => {
            return id;
        },
    }
}

fn check_pointer(address:ir::SlotId, value:ir::SlotId, writable:bool) -> () {
    let ptr:model::Type = stype(address);
    if ptr.kind != model::TYPE_POINTER || !model::same_type(ptr.element, slot(value).ty) || writable && (ptr.flags & model::TYPE_CONST) != 0_u32 {
        bad();
    }
    return ();
}

fn validate(inst:ir::Inst, decl:model::Decl) -> Flow {
    unsafe {
        here = inst.span;
    }
    match inst.instruction {
        ir::Instruction::Empty => {
            bad();
        },
        ir::Instruction::Value(item) => {
            let ty:model::Type = stype(item.destination);
            if !scalar(ty) {
                bad();
            }
            if (ty.kind == model::TYPE_UNIT || ty.kind == model::TYPE_POINTER) && item.bits != 0_usize {
                bad();
            }
            if ty.kind == model::TYPE_BOOL && item.bits > 1_usize {
                bad();
            }
            if ty.kind == model::TYPE_U8 && item.bits > 255_usize {
                bad();
            }
            if ty.kind == model::TYPE_U32 && item.bits > 4294967295_usize {
                bad();
            }
        },
        ir::Instruction::Copy(item) => {
            same(item.destination, item.source);
        },
        ir::Instruction::LocalAddress(item) => {
            let ty:model::Type = stype(item.destination);
            let source:model::Type = stype(item.source);
            if ty.kind != model::TYPE_POINTER {
                bad();
            }
            let size:usize = info(ty.element).size;
            if item.offset > source.size || size > source.size-item.offset {
                bad();
            }
        },
        ir::Instruction::SymbolAddress(item) => {
            if stype(item.destination).kind != model::TYPE_POINTER {
                bad();
            }
            unsafe {
                if item.symbol == 0_u32 || item.symbol > image::symbol_count() {
                    bad();
                }
            }
        },
        ir::Instruction::Load(item) => {
            check_pointer(item.address, item.destination, false);
        },
        ir::Instruction::Store(item) => {
            check_pointer(item.address, item.value, true);
        },
        ir::Instruction::Offset(item) => {
            if stype(item.destination).kind != model::TYPE_POINTER || stype(item.address).kind != model::TYPE_POINTER || stype(item.bytes).kind != model::TYPE_USIZE || stype(item.destination).flags != stype(item.address).flags {
                bad();
            }
        },
        ir::Instruction::Binary(item) => {
            same(item.left, item.right);
            let ty:model::Type = stype(item.left);
            var comparison:bool = false;
            var ordered:bool = false;
            match item.operator {
                ir::BinaryOperator::Add => {
                },
                ir::BinaryOperator::Sub => {
                },
                ir::BinaryOperator::Mul => {
                },
                ir::BinaryOperator::Div => {
                },
                ir::BinaryOperator::Rem => {
                },
                ir::BinaryOperator::WrapAdd => {
                },
                ir::BinaryOperator::WrapSub => {
                },
                ir::BinaryOperator::WrapMul => {
                },
                ir::BinaryOperator::Shl => {
                },
                ir::BinaryOperator::Shr => {
                },
                ir::BinaryOperator::BitAnd => {
                },
                ir::BinaryOperator::BitOr => {
                },
                ir::BinaryOperator::BitXor => {
                },
                ir::BinaryOperator::Eq => {
                    comparison = true;
                },
                ir::BinaryOperator::Ne => {
                    comparison = true;
                },
                ir::BinaryOperator::Lt => {
                    comparison = true;
                    ordered = true;
                },
                ir::BinaryOperator::Le => {
                    comparison = true;
                    ordered = true;
                },
                ir::BinaryOperator::Gt => {
                    comparison = true;
                    ordered = true;
                },
                ir::BinaryOperator::Ge => {
                    comparison = true;
                    ordered = true;
                },
            }
            if comparison {
                if stype(item.destination).kind != model::TYPE_BOOL || (!integer(ty) && ty.kind != model::TYPE_BOOL && ty.kind != model::TYPE_POINTER) || ordered && !integer(ty) {
                    bad();
                }
            } else {
                same(item.destination, item.left);
                if !integer(ty) {
                    bad();
                }
            }
        },
        ir::Instruction::Unary(item) => {
            same(item.destination, item.operand);
            let ty:model::Type = stype(item.operand);
            match item.operator {
                ir::UnaryOperator::Not => {
                    if ty.kind != model::TYPE_BOOL {
                        bad();
                    }
                },
                ir::UnaryOperator::BitNot => {
                    if !integer(ty) {
                        bad();
                    }
                },
                ir::UnaryOperator::Neg => {
                    if !integer(ty) {
                        bad();
                    }
                },
            }
        },
        ir::Instruction::Cast(item) => {
            if !integer(stype(item.destination)) || !integer(stype(item.source)) {
                bad();
            }
        },
        ir::Instruction::Bitcast(item) => {
            let a:model::Type = stype(item.source);
            let b:model::Type = stype(item.destination);
            if a.kind == model::TYPE_POINTER && b.kind == model::TYPE_POINTER {
                if !model::same_type(a.element, b.element) || (a.flags & model::TYPE_CONST) > (b.flags & model::TYPE_CONST) {
                    bad();
                }
            } else if !((a.kind == model::TYPE_POINTER && b.kind == model::TYPE_USIZE) || (a.kind == model::TYPE_USIZE && b.kind == model::TYPE_POINTER)) {
                bad();
            }
        },
        ir::Instruction::Bounds(item) => {
            if stype(item.index).kind != model::TYPE_USIZE || stype(item.length).kind != model::TYPE_USIZE {
                bad();
            }
        },
        ir::Instruction::Call(item) => {
            let target:model::Decl = declaration(item.callee);
            if target.count != ir::argument_count(item.arguments) {
                bad();
            }
            var p:u32 = 0;
            while p < target.count {
                if !model::same_type(slot(ir::argument(item.arguments, p)).ty, model::get_param(target.first+p).ty) {
                    bad();
                }
                p = p+1_u32;
            }
            check_result(item.result, target.ty);
            return Flow::Call(item.callee);
        },
        ir::Instruction::Label(id) => {
            let ignored:u32 = label(id);
            return Flow::Label(id);
        },
        ir::Instruction::Jump(id) => {
            let ignored:u32 = label(id);
            return Flow::End;
        },
        ir::Instruction::Branch(item) => {
            if stype(item.condition).kind != model::TYPE_BOOL {
                bad();
            }
            let yes:u32 = label(item.yes);
            let no:u32 = label(item.no);
            return Flow::End;
        },
        ir::Instruction::Return(value) => {
            check_result(value, decl.ty);
            return Flow::End;
        },
        ir::Instruction::Panic => {
            return Flow::End;
        },
    }
    return Flow::Next;
}

fn save_result(id:ir::SlotId) -> () {
    store(5, 2, frame_offset(id), stype(id).size);
    return ();
}

fn binary(item:ir::Binary) -> () {
    let ty:model::Type = stype(item.left);
    value(item.left, 6);
    value(item.right, 7);
    var checked:bool = false;
    var normalize_result:bool = true;
    match item.operator {
        ir::BinaryOperator::Add => {
            r(0, 0, 5, 6, 7);
            guard(7, 5, 6);
            checked = true;
        },
        ir::BinaryOperator::Sub => {
            guard(7, 6, 7);
            r(32, 0, 5, 6, 7);
            checked = true;
        },
        ir::BinaryOperator::Mul => {
            r(1, 0, 5, 6, 7);
            r(1, 3, 28, 6, 7);
            guard(0, 28, 0);
            checked = true;
        },
        ir::BinaryOperator::Div => {
            guard(1, 7, 0);
            r(1, 5, 5, 6, 7);
        },
        ir::BinaryOperator::Rem => {
            guard(1, 7, 0);
            r(1, 7, 5, 6, 7);
        },
        ir::BinaryOperator::WrapAdd => {
            r(0, 0, 5, 6, 7);
        },
        ir::BinaryOperator::WrapSub => {
            r(32, 0, 5, 6, 7);
        },
        ir::BinaryOperator::WrapMul => {
            r(1, 0, 5, 6, 7);
        },
        ir::BinaryOperator::Shl => {
            constant(28, ty.size*8_usize);
            guard(6, 7, 28);
            r(0, 1, 5, 6, 7);
        },
        ir::BinaryOperator::Shr => {
            constant(28, ty.size*8_usize);
            guard(6, 7, 28);
            r(0, 5, 5, 6, 7);
        },
        ir::BinaryOperator::BitAnd => {
            r(0, 7, 5, 6, 7);
        },
        ir::BinaryOperator::BitOr => {
            r(0, 6, 5, 6, 7);
        },
        ir::BinaryOperator::BitXor => {
            r(0, 4, 5, 6, 7);
        },
        ir::BinaryOperator::Eq => {
            r(0, 4, 5, 6, 7);
            i(19, 3, 5, 5, 1);
            normalize_result = false;
        },
        ir::BinaryOperator::Ne => {
            r(0, 4, 5, 6, 7);
            r(0, 3, 5, 0, 5);
            normalize_result = false;
        },
        ir::BinaryOperator::Lt => {
            r(0, 3, 5, 6, 7);
            normalize_result = false;
        },
        ir::BinaryOperator::Le => {
            r(0, 3, 5, 7, 6);
            i(19, 4, 5, 5, 1);
            normalize_result = false;
        },
        ir::BinaryOperator::Gt => {
            r(0, 3, 5, 7, 6);
            normalize_result = false;
        },
        ir::BinaryOperator::Ge => {
            r(0, 3, 5, 6, 7);
            i(19, 4, 5, 5, 1);
            normalize_result = false;
        },
    }
    if checked && ty.size < 8_usize {
        mov(28, 5);
        normalize(28, ty);
        guard(0, 5, 28);
    }
    if normalize_result {
        normalize(5, ty);
    }
    save_result(item.destination);
    return ();
}

fn call(item:ir::Call) -> () {
    let target:model::Decl = declaration(item.callee);
    let result:model::Type = info(target.ty);
    var position:usize = 0;
    if result.size != 0_usize && !scalar(result) {
        destination(result_slot(item.result), 10);
        position = 1;
    }
    var p:u32 = 0;
    while p < target.count {
        let ty:model::Type = info(model::get_param(target.first+p).ty);
        if ty.size != 0_usize {
            let arg:ir::SlotId = ir::argument(item.arguments, p);
            if scalar(ty) {
                value(arg, 5);
                extension(5, ty);
            } else {
                destination(arg, 5);
            }
            outgoing(position, 5);
            position = position+1_usize;
        }
        p = p+1_u32;
    }
    transfer(1, target.symbol, true);
    if result.size != 0_usize && scalar(result) {
        store(10, 2, frame_offset(result_slot(item.result)), result.size);
    }
    return ();
}

fn store_instruction(item:ir::Store) -> () {
    let ty:model::Type = stype(item.value);
    if scalar(ty) {
        value(item.value, 5);
        value(item.address, 6);
        store(5, 6, 0, ty.size);
    } else {
        value(item.address, 5);
        destination(item.value, 6);
        copy(ty.size);
    }
    return ();
}

fn return_instruction(item:ir::Destination, result:model::Type) -> () {
    if result.size != 0_usize {
        let source:ir::SlotId = result_slot(item);
        if scalar(result) {
            value(source, 10);
            extension(10, result);
        } else {
            unsafe {
                load(5, 2, result_pointer, 8);
            }
            destination(source, 6);
            copy(result.size);
        }
    }
    unsafe {
        mov(30, 8);
        load(1, 2, save, 8);
        load(8, 2, save+8_usize, 8);
        mov(2, 30);
    }
    i(103, 0, 0, 1, 0);
    return ();
}

fn instruction(inst:ir::Inst, decl:model::Decl) -> () {
    match inst.instruction {
        ir::Instruction::Empty => {
            bad();
        },
        ir::Instruction::Value(item) => {
            constant(5, item.bits);
            save_result(item.destination);
        },
        ir::Instruction::Copy(item) => {
            destination(item.destination, 5);
            destination(item.source, 6);
            copy(stype(item.destination).size);
        },
        ir::Instruction::LocalAddress(item) => {
            address(5, 2, frame_offset(item.source)+item.offset);
            save_result(item.destination);
        },
        ir::Instruction::SymbolAddress(item) => {
            transfer(5, item.symbol, false);
            save_result(item.destination);
        },
        ir::Instruction::Load(item) => {
            let ty:model::Type = stype(item.destination);
            if scalar(ty) {
                value(item.address, 6);
                load(5, 6, 0, ty.size);
                save_result(item.destination);
            } else {
                destination(item.destination, 5);
                value(item.address, 6);
                copy(ty.size);
            }
        },
        ir::Instruction::Store(item) => {
            store_instruction(item);
        },
        ir::Instruction::Offset(item) => {
            value(item.address, 6);
            value(item.bytes, 7);
            r(0, 0, 5, 6, 7);
            guard(7, 5, 6);
            save_result(item.destination);
        },
        ir::Instruction::Binary(item) => {
            binary(item);
        },
        ir::Instruction::Unary(item) => {
            value(item.operand, 5);
            match item.operator {
                ir::UnaryOperator::Not => {
                    i(19, 3, 5, 5, 1);
                },
                ir::UnaryOperator::BitNot => {
                    i(19, 4, 5, 5, 18446744073709551615);
                    normalize(5, stype(item.destination));
                },
                ir::UnaryOperator::Neg => {
                    guard(0, 5, 0);
                },
            }
            save_result(item.destination);
        },
        ir::Instruction::Cast(item) => {
            value(item.source, 5);
            normalize(5, stype(item.destination));
            save_result(item.destination);
        },
        ir::Instruction::Bitcast(item) => {
            value(item.source, 5);
            save_result(item.destination);
        },
        ir::Instruction::Bounds(item) => {
            value(item.index, 5);
            value(item.length, 6);
            guard(6, 5, 6);
        },
        ir::Instruction::Call(item) => {
            call(item);
        },
        ir::Instruction::Label(id) => {
            mark(label(id));
        },
        ir::Instruction::Jump(id) => {
            transfer(0, label(id), true);
        },
        ir::Instruction::Branch(item) => {
            value(item.condition, 5);
            branch(1, 5, 0, label(item.yes));
            transfer(0, label(item.no), true);
        },
        ir::Instruction::Return(value) => {
            return_instruction(value, info(decl.ty));
        },
        ir::Instruction::Panic => {
            panic();
        },
    }
    return ();
}

pub fn verify_function(id:u32) -> () {
    unsafe {
        current = 0;
    }
    layouts();
    let decl:model::Decl = declaration(id);
    if decl.kind != model::DECL_FUNCTION {
        bad();
    }
    unsafe {
        if !ir::is_sealed() || ir::current_function() != id || ir::parameter_slot_count() != decl.count || ir::inst_count() == 0_u32 {
            bad();
        }
        here = ir::get_inst(1).span;
        // Clear the previous function's entire touched range before resetting it.
        // Entries above that range are zero by induction from static initialization.
        var j:usize = 1;
        while j <= (label_high as usize) {
            labels[j] = 0;
            label_defs[j] = 0;
            j = j+1_usize;
        }
        label_high = 0;
        var outgoing:usize = 0;
        var at:u32 = 1;
        var terminated:bool = true;
        while at <= ir::inst_count() {
            let inst:ir::Inst = ir::get_inst(at);
            here = inst.span;
            let flow:Flow = validate(inst, decl);
            match flow {
                Flow::Label(id) => {
                    let n:u32 = ir::label_index(id);
                    if !terminated || label_defs[n as usize] != 0_u8 || at == 1_u32 && n != 1_u32 {
                        bad();
                    }
                    label_defs[n as usize] = 1;
                    terminated = false;
                },
                Flow::Next => {
                    if terminated {
                        bad();
                    }
                },
                Flow::End => {
                    if terminated {
                        bad();
                    }
                    terminated = true;
                },
                Flow::Call(target) => {
                    if terminated {
                        bad();
                    }
                    let amount:usize = outgoing_size(declaration(target));
                    if amount > outgoing {
                        outgoing = amount;
                    }
                },
            }
            at = at+1_u32;
        }
        if !terminated {
            bad();
        }
        j = 1;
        while j <= (label_high as usize) {
            if labels[j] != 0_u32 && label_defs[j] == 0_u8 {
                bad();
            }
            j = j+1_usize;
        }
        save = outgoing;
        result_pointer = outgoing+16_usize;
        frame_size = outgoing+24_usize;
        frame_align = 16;
        at = 1;
        while at <= ir::slot_count() {
            let ty:model::Type = info(ir::get_slot(ir::slot_id(at)).ty);
            if ty.align > frame_align {
                frame_align = ty.align;
            }
            frame_size = image::aligned(frame_size, ty.align);
            frame_offsets[at as usize] = frame_size;
            var size:usize = ty.size;
            if size == 0_usize {
                size = 1;
            }
            if size > 262144_usize || frame_size > 262144_usize-size {
                model::limit(frame_size+size, 262144);
            }
            frame_size = frame_size+size;
            at = at+1_u32;
        }
        frame_size = image::aligned(frame_size, 16);
        if frame_size+frame_align-16_usize > 262144_usize {
            model::limit(frame_size+frame_align-16_usize, 262144);
        }
        if frame_size+frame_align-16_usize > model::max_frame {
            model::max_frame = frame_size+frame_align-16_usize;
        }
        // Parameter mapping is semantic IR; validate before any machine emission.
        var parameter:u32 = 0;
        while parameter < decl.count {
            let arg:ir::SlotId = ir::get_parameter_slot(parameter+1_u32);
            if !model::same_type(slot(arg).ty, model::get_param(decl.first+parameter).ty) {
                bad();
            }
            var prior:u32 = 0;
            while prior < parameter {
                if ir::slot_index(ir::get_parameter_slot(prior+1_u32)) == ir::slot_index(arg) {
                    bad();
                }
                prior = prior+1_u32;
            }
            parameter = parameter+1_u32;
        }
        current = id;
        checked_revision = ir::function_revision();
    }
    return ();
}

pub fn emit_function(id:u32) -> () {
    unsafe {
        if id == 0_u32 || current != id || ir::current_function() != id || checked_revision != ir::function_revision() {
            bad();
        }
        // A verification ticket is consumed once; analysis between phases is read-only.
        current = 0;
        let decl:model::Decl = model::get_decl(id);
        mark(decl.symbol);
        mov(30, 2);
        constant(31, frame_size);
        r(32, 0, 2, 2, 31);
        if frame_align > 16_usize {
            constant(31, 0_usize-%frame_align);
            r(0, 7, 2, 2, 31);
        }
        store(1, 2, save, 8);
        store(8, 2, save+8_usize, 8);
        mov(8, 30);
        let result:model::Type = info(decl.ty);
        var position:usize = 0;
        if result.size != 0_usize && !scalar(result) {
            store(10, 2, result_pointer, 8);
            position = 1;
        }
        var p:u32 = 0;
        while p < decl.count {
            let arg:ir::SlotId = ir::get_parameter_slot(p+1_u32);
            let param:model::Param = model::get_param(decl.first+p);
            let ty:model::Type = info(param.ty);
            if ty.size != 0_usize {
                if scalar(ty) {
                    incoming(position, 5);
                    store(5, 2, frame_offset(arg), ty.size);
                } else {
                    incoming(position, 6);
                    destination(arg, 5);
                    copy(ty.size);
                }
                position = position+1_usize;
            }
            p = p+1_u32;
        }
        var at:u32 = 1;
        while at <= ir::inst_count() {
            instruction(ir::get_inst(at), decl);
            at = at+1_u32;
        }
    }
    return ();
}

// Entry preparation has no caller stack. a0/a1 survive BSS clearing. x27 is
// the user parameter block, or zero for privileged code. Interrupts stay off.
fn machine_entry() -> () {
    let stack: u32 = image::fresh();
    let stack_bytes: usize = target::layout().stack;
    image::data(stack, true, 16, "", stack_bytes);
    image::word(0x10017073); // csrrci x0, sstatus, 2 (clear SIE).
    transfer(5, image::bss_boundary(false), false);
    transfer(6, image::bss_boundary(true), false);
    let again: u32 = image::fresh();
    let done: u32 = image::fresh();
    mark(again);
    branch(0, 5, 6, done);
    store(0, 5, 0, 1);
    i(19, 0, 5, 5, 1);
    transfer(0, again, true);
    mark(done);
    transfer(2, stack, false);
    constant(5, stack_bytes);
    r(0, 0, 2, 2, 5);
    mov(27, 0);
    return ();
}

// __suba_halt / __suba_exit must be supplied by the profile's S0 runtime and
// must not return. A returned machine entry reports 102; checked panic is 101.
fn terminate(machine_panic: u32) -> () {
    match target::layout().profile {
        target::Profile::LinuxUser => {
            constant(17, 93);
            image::word(115);
            image::word(3221229683);
        },
        target::Profile::SubaUser => { transfer(0, image::symbol("__suba_exit"), true); },
        target::Profile::SubaBoot => {
            transfer(1, machine_panic, true);
            transfer(0, image::symbol("__suba_halt"), true);
        },
        target::Profile::SubaKernel => {
            transfer(1, machine_panic, true);
            transfer(0, image::symbol("__suba_halt"), true);
        },
    }
    return ();
}

pub fn start_bound(entry: u32, machine_panic: u32, trap: u32) -> u32 {
    let first: u32 = image::fresh();
    mark(first);
    match target::layout().profile {
        target::Profile::LinuxUser => { mov(27, 2); },
        target::Profile::SubaUser => { mov(27, 10); },
        target::Profile::SubaBoot => { machine_entry(); },
        target::Profile::SubaKernel => { machine_entry(); },
    }
    transfer(1, entry, true);
    if target::machine() { constant(10, 102); }
    terminate(machine_panic);
    unsafe {
        panic_symbol = image::fresh();
        mark(panic_symbol);
    }
    constant(10, 101);
    terminate(machine_panic);
    if trap != 0_u32 {
        // Tail transfer preserves the S0 caller's ra and aligned stack. The
        // assembly caller owns saving all interrupted registers and trap CSRs.
        mark(image::symbol("__suba_trap_dispatch"));
        transfer(0, trap, true);
    }
    unsafe {
        copy_symbol = image::fresh();
        mark(copy_symbol);
    }
    copy_body();
    return first;
}

// Existing internal backend probes select the default Linux profile.
pub fn start(entry: u32) -> u32 { return start_bound(entry, 0, 0); }
