struct Binding { name:u32, slot:u32, mutable:bool, depth:u32 }
struct Place { address:u32, ty:u32, writable:bool, global_mut:bool }
struct Loop { exit:u32, again:u32, cleanup:u32, has_break:bool }
static mut bindings:[8193]Binding = [Binding {name:0,slot:0,mutable:false,depth:0};8193];
static mut binding_count:u32 = 0;
static mut depth:u32 = 0;
static mut unsafe_depth:u32 = 0;
static mut defers:[1025]ir::Fragment = [ir::Fragment {first:0,count:0,labels:0,label_count:0,closed:false};1025];
static mut defer_count:u32 = 0;
static mut in_defer:bool = false;
static mut loops:[257]Loop = [Loop {exit:0,again:0,cleanup:0,has_break:false};257];
static mut loop_count:u32 = 0;
static mut output_type:u32 = 0;
static mut file:u32 = 0;
static mut expression_depth:u32 = 0;
static mut place_depth:u32 = 0;
pub static mut max_bindings:usize = 0;
pub static mut max_defers:usize = 0;
pub static mut max_loops:usize = 0;

fn location(node:u32) -> () { let n:parse::Node = parse::get(node); unsafe { ir::location = model::Span {file:file,start:n.start,end:n.start+1_u32}; types::token.file = file; types::token.start = n.start; } return (); }
fn require_unsafe() -> () { unsafe { if unsafe_depth == 0_u32 { types::fail(4); } } return (); }
fn local(name:u32) -> u32 { unsafe { var i:u32 = binding_count; while i != 0_u32 { if bindings[i as usize].name == name { return i; } i = i-1_u32; } } return 0; }
fn bind(name:u32,ty:u32,mutable:bool) -> u32 {
    unsafe {
        var i:u32 = binding_count; while i != 0_u32 && bindings[i as usize].depth == depth { if bindings[i as usize].name == name { types::fail(2); } i = i-1_u32; }
        if binding_count >= 8192_u32 { model::limit((binding_count as usize)+1_usize,8192); }
        let slot:u32 = ir::slot(ty); binding_count = binding_count+1_u32; if (binding_count as usize) > max_bindings { max_bindings = binding_count as usize; } bindings[binding_count as usize] = Binding {name:name,slot:slot,mutable:mutable,depth:depth}; return slot;
    }
}
fn same(value:u32,ty:u32) -> u32 { if ty != 0_u32 && ir::type_of(value) != ty { types::fail(3); } return value; }
fn access(place:Place) -> () { if place.global_mut { require_unsafe(); } return (); }
fn read(place:Place) -> u32 { access(place); return ir::load(place.address,place.ty); }
fn projection(base:Place,ty:u32,offset:usize,writable:bool) -> Place { return Place {address:ir::offset(base.address,ir::value(5,offset),ty,!writable),ty:ty,writable:writable,global_mut:base.global_mut}; }
fn slot_place(slot:u32,writable:bool) -> Place { let ty:u32 = ir::type_of(slot); return Place {address:ir::local_address(slot,ty,0,!writable),ty:ty,writable:writable,global_mut:false}; }
fn field(base:Place,name:u32) -> Place {
    let t:model::Type = types::info(base.ty); let raw:[]const u8 = types::text(name);
    if t.kind == 8_u32 {
        if model::equal(raw,"data") { return projection(base,types::pointer(t.a,t.flags != 0_u32),0,false); }
        if model::equal(raw,"len") { return projection(base,5,8,false); }
        types::fail(2);
    }
    if t.kind != 9_u32 { types::fail(3); }
    unsafe { var i:u32 = 0; while i < t.count { let f:model::Field = model::fields[(t.first+i) as usize]; if f.name == name { return projection(base,f.ty,f.offset,base.writable); } i = i+1_u32; } }
    types::fail(2); return base;
}
fn is_place(node:u32) -> bool {
    var current:u32 = node;
    loop {
        let n:parse::Node = parse::get(current);
        if n.tag == 10_u32 || n.tag == 11_u32 { current = n.a; continue; }
        if n.tag == 5_u32 { if local(n.a) != 0_u32 { return true; } unsafe { let id:u32 = types::resolve(file,n.a,false); return id != 0_u32 && model::decls[id as usize].kind == 5_u32; } }
        return n.tag == 6_u32 && n.a == 4_u32;
    }
    return false;
}
fn base_place(node:u32) -> Place { if is_place(node) { return place(node); } let value:u32 = expr(node,0); if types::scalar(ir::type_of(value)) { types::fail(3); } return slot_place(value,false); }
fn index(base:Place,node:u32) -> Place {
    let t:model::Type = types::info(base.ty);
    var address:u32 = base.address; var length:u32 = 0; var writable:bool = base.writable;
    if t.kind == 7_u32 { length = ir::value(5,t.b as usize); }
    else { if t.kind == 8_u32 {
        require_unsafe(); access(base);
        address = read(projection(base,types::pointer(t.a,t.flags != 0_u32),0,false));
        length = read(projection(base,5,8,false)); writable = t.flags == 0_u32;
    } else { types::fail(3); } }
    let ix:u32 = expr(node,5); ir::emit(12,0,ix,length,0,0,0);
    let bytes:u32 = ir::binary(3,ix,ir::value(5,types::info(t.a).size),5);
    return Place {address:ir::offset(address,bytes,t.a,!writable),ty:t.a,writable:writable,global_mut:base.global_mut};
}
fn place(node:u32) -> Place {
    unsafe { if place_depth >= 64_u32 { model::limit_at((place_depth as usize)+1_usize,64,file,parse::get(node).start as usize); } place_depth = place_depth+1_u32; }
    let result:Place = place_inner(node); unsafe { place_depth = place_depth-1_u32; } return result;
}
fn place_inner(node:u32) -> Place {
    location(node); let n:parse::Node = parse::get(node);
    if n.tag == 5_u32 {
        let binding:u32 = local(n.a);
        unsafe {
            if binding != 0_u32 { let b:Binding = bindings[binding as usize]; return slot_place(b.slot,b.mutable); }
            let id:u32 = types::resolve(file,n.a,false); if id == 0_u32 { types::fail(2); } let d:model::Decl = model::decls[id as usize]; if d.kind != 5_u32 { types::fail(3); }
            let writable:bool = (d.flags&4_u32) != 0_u32;
            return Place {address:ir::symbol_address(d.symbol,d.ty,!writable),ty:d.ty,writable:writable,global_mut:writable};
        }
    }
    if n.tag == 6_u32 && n.a == 4_u32 {
        require_unsafe(); let address:u32 = expr(n.b,0); let t:model::Type = types::info(ir::type_of(address)); if t.kind != 6_u32 { types::fail(3); }
        return Place {address:address,ty:t.a,writable:t.flags == 0_u32,global_mut:false};
    }
    if n.tag == 10_u32 { return field(place(n.a),n.b); }
    if n.tag == 11_u32 { return index(place(n.a),n.b); }
    types::fail(3); return Place {address:0,ty:0,writable:false,global_mut:false};
}
fn slice(element:u32,const_:bool,address:u32,length:u32) -> u32 {
    var flags:u32 = 0; if const_ { flags = 1; }
    let ty:u32 = types::intern(8,element,0,flags); let result:u32 = ir::slot(ty);
    ir::store(ir::local_address(result,types::pointer(element,const_),0,false),address);
    ir::store(ir::local_address(result,5,8,false),length); return result;
}
fn result(ty:u32,tag:u32,payload:u32) -> u32 {
    let result:u32 = ir::slot(ty); let t:model::Type = types::info(ty);
    ir::store(ir::local_address(result,4,0,false),ir::value(4,tag as usize));
    ir::store(ir::local_address(result,ir::type_of(payload),t.first as usize,false),payload); return result;
}
fn cleanup(mark:u32) -> () { unsafe { var i:u32 = defer_count; while i > mark { if ir::closed { return (); } ir::instantiate(defers[i as usize]); i = i-1_u32; } } return (); }
fn try_value(node:u32) -> u32 {
    unsafe { if in_defer { types::fail(3); } }
    let value:u32 = expr(node,0); let t:model::Type = types::info(ir::type_of(value));
    unsafe {
        let target:model::Type = types::info(output_type);
        if t.kind != 10_u32 || target.kind != 10_u32 || t.b != target.b { types::fail(3); }
        let tag:u32 = ir::load(ir::local_address(value,4,0,true),4);
        let condition:u32 = ir::binary(14,tag,ir::value(4,0),2); let yes:u32 = ir::label_id(); let no:u32 = ir::label_id(); ir::branch(condition,yes,no);
        ir::label(no); let payload:u32 = ir::load(ir::local_address(value,t.b,t.first as usize,true),t.b); let returned:u32 = result(output_type,1,payload);
        cleanup(0); if !ir::closed { ir::emit(17,0,returned,0,0,0,0); }
        ir::label(yes); return ir::load(ir::local_address(value,t.a,t.first as usize,true),t.a);
    }
}
fn arity(first:u32,wanted:u32) -> () { var id:u32 = first; var n:u32 = 0; while id != 0_u32 { n = n+1_u32; id = parse::get(id).next; } if n != wanted { types::fail(3); } return (); }
fn builtin(name:[]const u8,first:u32) -> u32 {
    var raw:[]const u8 = name;
    if raw.len > 6_usize && model::equal(types::view(raw,0,6),"core::") { raw = types::view(raw,6,raw.len); }
    if model::equal(raw,"panic") { arity(first,0); ir::emit(18,0,0,0,0,0,0); ir::ensure(); return ir::value(1,0); }
    if model::equal(raw,"addr_of") || model::equal(raw,"addr_of_mut") {
        arity(first,1); let p:Place = place(first); let mutable:bool = model::equal(raw,"addr_of_mut");
        if parse::get(first).tag != 5_u32 { access(p); }
        if mutable && !p.writable { types::fail(3); }
        let ty:u32 = types::pointer(p.ty,!mutable); if ir::type_of(p.address) == ty { return p.address; } return ir::bitcast(p.address,ty);
    }
    if model::equal(raw,"addr") {
        arity(first,1); let value:u32 = expr(first,0); if types::info(ir::type_of(value)).kind != 6_u32 { types::fail(3); } return ir::bitcast(value,5);
    }
    if model::equal(raw,"ptr_const") {
        arity(first,1); let value:u32 = expr(first,0); let t:model::Type = types::info(ir::type_of(value)); if t.kind != 6_u32 { types::fail(3); } return ir::bitcast(value,types::pointer(t.a,true));
    }
    if model::equal(raw,"ptr_add") || model::equal(raw,"ptr_add_bytes") {
        arity(first,2); require_unsafe(); let value:u32 = expr(first,0); let t:model::Type = types::info(ir::type_of(value)); if t.kind != 6_u32 { types::fail(3); }
        var bytes:u32 = expr(parse::get(first).next,5); if model::equal(raw,"ptr_add") { bytes = ir::binary(3,bytes,ir::value(5,types::info(t.a).size),5); }
        return ir::offset(value,bytes,t.a,t.flags != 0_u32);
    }
    if model::equal(raw,"slice_of") || model::equal(raw,"slice_of_mut") {
        arity(first,1); let p:Place = place(first); access(p); let t:model::Type = types::info(p.ty); if t.kind != 7_u32 { types::fail(3); }
        let mutable:bool = model::equal(raw,"slice_of_mut"); if mutable && !p.writable { types::fail(3); }
        let address:u32 = ir::offset(p.address,ir::value(5,0),t.a,!mutable); return slice(t.a,!mutable,address,ir::value(5,t.b as usize));
    }
    if model::equal(raw,"slice_from_raw_parts") || model::equal(raw,"slice_from_raw_parts_mut") {
        arity(first,2); require_unsafe(); var address:u32 = expr(first,0); let t:model::Type = types::info(ir::type_of(address)); if t.kind != 6_u32 { types::fail(3); }
        let mutable:bool = model::equal(raw,"slice_from_raw_parts_mut"); if mutable && t.flags != 0_u32 { types::fail(3); }
        let length:u32 = expr(parse::get(first).next,5); let ty:u32 = types::pointer(t.a,!mutable); if ir::type_of(address) != ty { address = ir::bitcast(address,ty); }
        return slice(t.a,!mutable,address,length);
    }
    if model::equal(raw,"slice_const") {
        arity(first,1); let value:u32 = expr(first,0); let t:model::Type = types::info(ir::type_of(value)); if t.kind != 8_u32 { types::fail(3); }
        let address:u32 = ir::load(ir::local_address(value,types::pointer(t.a,t.flags != 0_u32),0,true),types::pointer(t.a,t.flags != 0_u32));
        let readonly:u32 = ir::bitcast(address,types::pointer(t.a,true)); return slice(t.a,true,readonly,ir::load(ir::local_address(value,5,8,true),5));
    }
    if model::equal(raw,"read") || model::equal(raw,"write") || model::equal(raw,"copy_bytes") || model::equal(raw,"fill_bytes") || model::equal(raw,"atomic_load") || model::equal(raw,"atomic_store") { types::fail(5); }
    types::fail(2); return 0;
}
fn call(name:u32,first:u32) -> u32 {
    if local(name) != 0_u32 { types::fail(3); }
    unsafe {
        let id:u32 = types::resolve(file,name,false);
        if id == 0_u32 { return builtin(types::text(name),first); }
        let d:model::Decl = model::decls[id as usize]; if d.kind != 2_u32 && d.kind != 3_u32 { types::fail(3); }
        if (d.flags&2_u32) != 0_u32 { require_unsafe(); }
        arity(first,d.count); var values:[256]u32 = [0;256]; var i:u32 = 0; var arg:u32 = first;
        while i < d.count { values[i as usize] = expr(arg,model::params[(d.first+i) as usize].ty); arg = parse::get(arg).next; i = i+1_u32; }
        let begin:u32 = model::arg_count+1_u32; i = 0; while i < d.count { let ignored:u32 = model::add_arg(values[i as usize]); i = i+1_u32; }
        var result:u32 = 0; if d.ty != 1_u32 { result = ir::slot(d.ty); }
        ir::emit(13,result,id,begin,d.count,0,0); if result == 0_u32 { result = ir::value(1,0); } return result;
    }
}
fn binary(n:parse::Node,expected:u32) -> u32 {
    if n.a >= 20_u32 {
        let result:u32 = ir::slot(2); let left:u32 = expr(n.b,2); let yes:u32 = ir::label_id(); let no:u32 = ir::label_id(); let end:u32 = ir::label_id();
        if n.a == 20_u32 { ir::branch(left,yes,no); } else { ir::branch(left,no,yes); }
        ir::label(no); var bits:usize = 0; if n.a == 21_u32 { bits = 1; } ir::emit(2,result,ir::value(2,bits),0,0,0,0); ir::jump(end);
        ir::label(yes); let right:u32 = expr(n.c,2); ir::emit(2,result,right,0,0,0,0); ir::jump(end); ir::label(end); return result;
    }
    var want:u32 = expected; if n.a >= 14_u32 { want = 0; }
    let left:u32 = expr(n.b,want); let right:u32 = expr(n.c,want); let ty:u32 = ir::type_of(left); if ir::type_of(right) != ty { types::fail(3); }
    if n.a >= 14_u32 {
        if n.a >= 16_u32 && !types::integer(ty) { types::fail(3); }
        if n.a <= 15_u32 && !types::scalar(ty) { types::fail(3); }
        return ir::binary(n.a,left,right,2);
    }
    if !types::integer(ty) { types::fail(3); } return ir::binary(n.a,left,right,ty);
}
fn repeat(ty:u32,element:u32,length:u32,value:u32) -> u32 {
    let result:u32 = ir::slot(ty); let counter:u32 = ir::value(5,0); let test:u32 = ir::label_id(); let body:u32 = ir::label_id(); let done:u32 = ir::label_id();
    ir::jump(test); ir::label(test); let condition:u32 = ir::binary(16,counter,ir::value(5,length as usize),2); ir::branch(condition,body,done);
    ir::label(body); let bytes:u32 = ir::binary(3,counter,ir::value(5,types::info(element).size),5);
    let address:u32 = ir::offset(ir::local_address(result,ty,0,false),bytes,element,false); ir::store(address,value);
    let next:u32 = ir::binary(1,counter,ir::value(5,1),5); ir::emit(2,counter,next,0,0,0,0); ir::jump(test); ir::label(done); return result;
}
fn expr(node:u32,expected:u32) -> u32 {
    unsafe { if expression_depth >= 64_u32 { model::limit_at((expression_depth as usize)+1_usize,64,file,parse::get(node).start as usize); } expression_depth = expression_depth+1_u32; }
    let result:u32 = expr_inner(node,expected); unsafe { expression_depth = expression_depth-1_u32; } return result;
}
fn expr_inner(node:u32,expected:u32) -> u32 {
    location(node); let n:parse::Node = parse::get(node); var value:u32 = 0;
    if n.tag == 1_u32 {
        var ty:u32 = n.a; if ty == 0_u32 { ty = expected; } if ty == 0_u32 || !types::integer(ty) || n.bits > types::max(ty) { types::fail(3); }
        value = ir::value(ty,n.bits);
    } else { if n.tag == 2_u32 { value = ir::value(2,n.bits); }
    else { if n.tag == 3_u32 { value = ir::value(1,0); }
    else { if n.tag == 4_u32 { if expected == 0_u32 || types::info(expected).kind != 6_u32 { types::fail(3); } value = ir::value(expected,0); }
    else { if n.tag == 5_u32 {
        if is_place(node) { value = read(place(node)); }
        else { unsafe { let id:u32 = types::resolve(file,n.a,false); if id == 0_u32 { types::fail(2); } let d:model::Decl = model::decls[id as usize]; if d.kind != 4_u32 { types::fail(5); } value = ir::value(d.ty,d.bits); } }
    } else { if n.tag == 6_u32 {
        if n.a == 4_u32 { value = read(place(node)); }
        else { var want:u32 = expected; if n.a == 1_u32 { want = 2; } let operand:u32 = expr(n.b,want); let ty:u32 = ir::type_of(operand); if n.a == 3_u32 || n.a == 2_u32 && !types::integer(ty) { types::fail(3); } value = ir::slot(ty); ir::emit(9,value,operand,0,0,n.a,0); }
    } else { if n.tag == 7_u32 { value = binary(n,expected); }
    else { if n.tag == 8_u32 { let operand:u32 = expr(n.a,0); if !types::integer(ir::type_of(operand)) || !types::integer(n.b) { types::fail(3); } value = ir::cast(operand,n.b); }
    else { if n.tag == 9_u32 { value = call(n.a,n.b); }
    else { if n.tag == 10_u32 {
        let base:Place = base_place(n.a); let t:model::Type = types::info(base.ty);
        if t.kind == 7_u32 { access(base); if !model::equal(types::text(n.b),"len") { types::fail(2); } value = ir::value(5,t.b as usize); }
        else { value = read(field(base,n.b)); }
    } else { if n.tag == 11_u32 { value = read(index(base_place(n.a),n.b)); }
    else { if n.tag == 12_u32 {
        value = ir::slot(n.a); let t:model::Type = types::info(n.a); var seen:[256]u32 = [0;256]; var p:u32 = n.b; var found:u32 = 0;
        while p != 0_u32 {
            let pair:parse::Node = parse::get(p); var index:u32 = 0;
            unsafe { while index < t.count && model::fields[(t.first+index) as usize].name != pair.a { index = index+1_u32; } }
            if index == t.count { types::fail(2); }
            unsafe { if seen[index as usize] != 0_u32 { types::fail(3); } seen[index as usize] = 1;
                let f:model::Field = model::fields[(t.first+index) as usize]; let v:u32 = expr(pair.b,f.ty); ir::store(ir::local_address(value,f.ty,f.offset,false),v);
            }
            found = found+1_u32; p = pair.next;
        }
        if found != t.count { types::fail(3); }
    } else { if n.tag == 13_u32 || n.tag == 14_u32 {
        if expected == 0_u32 { types::fail(3); } let t:model::Type = types::info(expected); if t.kind != 7_u32 { types::fail(3); }
        if n.tag == 14_u32 { if n.b != t.b { types::fail(3); } value = repeat(expected,t.a,t.b,expr(n.a,t.a)); }
        else { value = ir::slot(expected); var p:u32 = n.a; var index:u32 = 0;
            while p != 0_u32 { if index >= t.b { types::fail(3); } let v:u32 = expr(p,t.a); ir::store(ir::local_address(value,t.a,(index as usize)*types::info(t.a).size,false),v); index = index+1_u32; p = parse::get(p).next; }
            if index != t.b { types::fail(3); }
        }
    } else { if n.tag == 15_u32 { let t:model::Type = types::info(n.a); var ty:u32 = t.a; if n.b == 1_u32 { ty = t.b; } value = result(n.a,n.b,expr(n.c,ty)); }
    else { if n.tag == 16_u32 { value = try_value(n.a); }
    else { if n.tag == 17_u32 { value = ir::value(5,types::info(n.a).size); }
    else { if n.tag == 18_u32 { value = ir::value(5,types::info(n.a).align); }
    else { if n.tag == 19_u32 { require_unsafe(); value = ir::bitcast(expr(n.b,5),types::pointer(n.a,false)); }
    else { if n.tag == 20_u32 { let symbol:u32 = parse::string_data(n.a); value = slice(3,true,ir::symbol_address(symbol,3,true),ir::value(5,types::text(n.a).len)); }
    else { types::fail(7); } } } } } } } } } } } } } } } } } } }
    return same(value,expected);
}

fn statement(node:u32) -> bool {
    location(node); let n:parse::Node = parse::get(node);
    if n.tag == 114_u32 { return true; }
    if n.tag == 101_u32 { return block(node); }
    if n.tag == 105_u32 { unsafe { unsafe_depth = unsafe_depth+1_u32; } let falls:bool = block(n.a); unsafe { unsafe_depth = unsafe_depth-1_u32; } return falls; }
    if n.tag == 102_u32 {
        unsafe { if n.c == 0_u32 && (n.d == 0_u32 || in_defer) { types::fail(3); } }
        var value:u32 = 0; if n.c != 0_u32 { value = expr(n.c,n.b); }
        let target:u32 = bind(n.a,n.b,n.d != 0_u32); if value != 0_u32 { ir::emit(2,target,value,0,0,0,0); } return true;
    }
    if n.tag == 103_u32 {
        // Typecheck an address computation once, but execute RHS before LHS.
        let mark:ir::Mark = ir::begin_capture(); let target:Place = place(n.a); access(target); if !target.writable { types::fail(3); }
        let fragment:ir::Fragment = ir::end_capture(mark); let value:u32 = expr(n.b,target.ty); ir::instantiate(fragment); ir::store(target.address,value); return true;
    }
    if n.tag == 104_u32 { let ignored:u32 = expr(n.a,0); return true; }
    if n.tag == 106_u32 {
        let condition:u32 = expr(n.a,2); let yes:u32 = ir::label_id(); let no:u32 = ir::label_id(); let end:u32 = ir::label_id(); ir::branch(condition,yes,no);
        ir::label(yes); let a:bool = block(n.b); ir::jump(end);
        ir::label(no); var b:bool = true; if n.c != 0_u32 { b = block(n.c); } ir::jump(end);
        if a || b { ir::label(end); } return a || b;
    }
