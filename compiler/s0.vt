// Bounded assembly adapter grammar; no source-language parser dependency.
module bootstrap::s0;
import bootstrap::model;
import bootstrap::image;
import bootstrap::rv64;
static mut input:[]const u8 = "";
static mut at:usize = 0;
static mut end:usize = 0;
static mut file_id:u32 = 0;
static mut line_start:usize = 0;
fn bad() -> () {
    unsafe {
        model::fail(model::ERROR_PARSE, file_id, line_start);
    }
    return ();
}

fn space(ch:u8) -> bool {
    return ch == 32_u8 || ch == 9_u8 || ch == 13_u8;
}

fn skip() -> () {
    unsafe {
        while at < end && space(input[at]) {
            at = at+1_usize;
        }
    }
    return ();
}

fn token() -> []const u8 {
    skip();
    unsafe {
        let first:usize = at;
        while at < end && !space(input[at]) && input[at] != 44_u8 && input[at] != 40_u8 && input[at] != 41_u8 && input[at] != 58_u8 {
            at = at+1_usize;
        }
        if at == first {
            bad();
        }
        return core::slice_from_raw_parts(core::ptr_add(input.data, first), at-first);
    }
}

fn punct(ch:u8) -> () {
    skip();
    unsafe {
        if at >= end || input[at] != ch {
            bad();
        }
        at = at+1_usize;
    }
    return ();
}

fn done() -> () {
    skip();
    unsafe {
        if at != end {
            bad();
        }
    }
    return ();
}

fn register() -> u32 {
    let text:[]const u8 = token();
    unsafe {
        if text.len < 2_usize || text[0] != 120_u8 {
            bad();
        }
        var n:u32 = 0;
        var j:usize = 1;
        while j < text.len {
            let ch:u8 = text[j];
            if ch < 48_u8 || ch > 57_u8 {
                bad();
            }
            n = n*10_u32+((ch-48_u8) as u32);
            if n > 31_u32 {
                bad();
            }
            j = j+1_usize;
        }
        return n;
    }
}

fn immediate(shift:bool) -> usize {
    let text:[]const u8 = token();
    var j:usize = 0;
    var negative:bool = false;
    var base:usize = 10;
    unsafe {
        if text[0] == 45_u8 {
            negative = true;
            j = 1;
        }
        if j+2_usize <= text.len && text[j] == 48_u8 && text[j+1_usize] == 120_u8 {
            base = 16;
            j = j+2_usize;
        }
        if j == text.len {
            bad();
        }
        var n:usize = 0;
        while j < text.len {
            let ch:u8 = text[j];
            var digit:usize = 99;
            if ch >= 48_u8 && ch <= 57_u8 {
                digit = (ch-48_u8) as usize;
            }
            if ch >= 97_u8 && ch <= 102_u8 {
                digit = (ch-87_u8) as usize;
            }
            if digit >= base || n > 2048_usize {
                bad();
            }
            n = n*base+digit;
            j = j+1_usize;
        }
        if shift {
            if negative || n > 63_usize {
                bad();
            }
        } else if negative {
            if n > 2048_usize {
                bad();
            }
        } else if n > 2047_usize {
            bad();
        }
        if negative {
            return 0_usize-%n;
        }
        return n;
    }
}

// CSR addresses and zimm are unsigned fields, not signed I-format immediates.
fn unsigned_field(maximum:usize) -> u32 {
    let text:[]const u8 = token();
    var at_digit:usize = 0;
    var base:usize = 10;
    // SAFETY: token borrows the source for this parse call. Each access below
    // is bounded by the token length; parsing does not replace its storage.
    unsafe {
        if text.len >= 2_usize && text[0] == 48_u8 && text[1] == 120_u8 {
            base = 16;
            at_digit = 2;
        }
        if at_digit == text.len { bad(); }
        var value:usize = 0;
        while at_digit < text.len {
            let ch:u8 = text[at_digit];
            var digit:usize = 99;
            if ch >= 48_u8 && ch <= 57_u8 { digit = (ch-48_u8) as usize; }
            if ch >= 97_u8 && ch <= 102_u8 { digit = (ch-87_u8) as usize; }
            if digit >= base || digit > maximum { bad(); }
            if value > (maximum-digit)/base { bad(); }
            value = value*base+digit;
            at_digit = at_digit+1_usize;
        }
        return value as u32;
    }
}

// A bounded machine-boundary extension. Encodings are checked against Clang
// by check_q_s0_system.py; that assembler is never used to build a Q image.
fn system_operation(op:[]const u8) -> bool {
    var function:u32 = 0;
    if model::equal(op, "csrrw") { function = 1; }
    if model::equal(op, "csrrs") { function = 2; }
    if model::equal(op, "csrrc") { function = 3; }
    if model::equal(op, "csrrwi") { function = 5; }
    if model::equal(op, "csrrsi") { function = 6; }
    if model::equal(op, "csrrci") { function = 7; }
    if function != 0_u32 {
        let destination:u32 = register();
        punct(44);
        let csr:u32 = unsigned_field(4095);
        punct(44);
        var source:u32 = 0;
        if function < 4_u32 { source = register(); }
        else { source = unsigned_field(31); }
        done();
        image::word((csr << 20_u32) | (source << 15_u32) | (function << 12_u32) |
            (destination << 7_u32) | 115_u32);
        return true;
    }
    if model::equal(op, "sfence.vma") {
        let address:u32 = register();
        punct(44);
        let asid:u32 = register();
        done();
        image::word(301990003_u32 | (asid << 20_u32) | (address << 15_u32));
        return true;
    }
    if model::equal(op, "align") {
        let alignment:usize = unsigned_field(4096) as usize;
        done();
        if alignment < 4_usize || (alignment & (alignment-1_usize)) != 0_usize {
            bad();
        }
        // Text begins at a 4096-byte aligned VA for every supported profile.
        // Emit at most 1023 whole RV64 NOPs; labels after this line see padding.
        while (image::text_position() & (alignment-1_usize)) != 0_usize {
            image::word(19);
        }
        return true;
    }
    var word:u32 = 0;
    if model::equal(op, "sret") { word = 270532723; }
    if model::equal(op, "wfi") { word = 273678451; }
    // The only fence form is the conservative full iorw,iorw barrier.
    if model::equal(op, "fence") { word = 267386895; }
    if model::equal(op, "fence.i") { word = 4111; }
    if word != 0_u32 {
        done();
        image::word(word);
        return true;
    }
    return false;
}

fn letter(ch:u8) -> bool {
    return (ch >= 65_u8 && ch <= 90_u8) || (ch >= 97_u8 && ch <= 122_u8) || ch == 95_u8 || ch == 46_u8;
}

fn named(text:[]const u8) -> u32 {
    unsafe {
        if text.len == 0_usize || !letter(text[0]) || (text.len == 1_usize && text[0] == 46_u8) {
            bad();
        }
        var j:usize = 1;
        while j < text.len {
            if !letter(text[j]) && !(text[j] >= 48_u8 && text[j] <= 57_u8) {
                bad();
            }
            j = j+1_usize;
        }
        if text.len >= 2_usize && text[0] == 46_u8 && text[1] == 76_u8 {
            var prefix:[11]u8 = [0;11];
            prefix[0] = 46;
            prefix[1] = 76;
            j = 0;
            while j < 8_usize {
                let nibble:u8 = (((file_id as usize) >> ((7_usize-j)*4_usize)) & 15_usize) as u8;
                var ch:u8 = nibble+48_u8;
                if nibble >= 10_u8 { ch = nibble+87_u8; }
                prefix[2_usize+j] = ch;
                j = j+1_usize;
            }
            prefix[10] = 95;
            let suffix:[]const u8 = core::slice_from_raw_parts(core::ptr_add(text.data, 2), text.len-2_usize);
            return image::named(model::name_parts(core::slice_of(prefix), suffix), model::SYMBOL_UNSPECIFIED);
        }
        return image::symbol(text);
    }
}

fn target() -> u32 {
    return named(token());
}

fn operation(op:[]const u8) -> () {
    if system_operation(op) { return (); }
    var f3:u32 = 0;
    var f7:u32 = 0;
    var kind:u32 = 0;
    if model::equal(op, "add") {
        kind = 1;
    }
    if model::equal(op, "sub") {
        kind = 1;
        f7 = 32;
    }
    if model::equal(op, "mul") {
        kind = 1;
        f7 = 1;
    }
    if model::equal(op, "mulhu") {
        kind = 1;
        f7 = 1;
        f3 = 3;
    }
    if model::equal(op, "divu") {
        kind = 1;
        f7 = 1;
        f3 = 5;
    }
    if model::equal(op, "remu") {
        kind = 1;
        f7 = 1;
        f3 = 7;
    }
    if model::equal(op, "and") {
        kind = 1;
        f3 = 7;
    }
    if model::equal(op, "or") {
        kind = 1;
        f3 = 6;
    }
    if model::equal(op, "xor") {
        kind = 1;
        f3 = 4;
    }
    if model::equal(op, "sltu") {
        kind = 1;
        f3 = 3;
    }
    if model::equal(op, "sll") {
        kind = 1;
        f3 = 1;
    }
    if model::equal(op, "srl") {
        kind = 1;
        f3 = 5;
    }
    if kind == 1_u32 {
        let rd:u32 = register();
        punct(44);
        let a:u32 = register();
        punct(44);
        let b:u32 = register();
        done();
        rv64::r(f7, f3, rd, a, b);
        return ();
    }
    var opcode:u32 = 19;
    var shift:bool = false;
    if model::equal(op, "addi") {
        kind = 2;
    }
    if model::equal(op, "addiw") {
        kind = 2;
        opcode = 27;
    }
    if model::equal(op, "xori") {
        kind = 2;
        f3 = 4;
    }
    if model::equal(op, "sltiu") {
        kind = 2;
        f3 = 3;
    }
    if model::equal(op, "slli") {
        kind = 2;
        f3 = 1;
        shift = true;
    }
    if model::equal(op, "srli") {
        kind = 2;
        f3 = 5;
        shift = true;
    }
    if kind == 2_u32 {
        let rd:u32 = register();
        punct(44);
        let a:u32 = register();
        punct(44);
        let n:usize = immediate(shift);
        done();
        rv64::i(opcode, f3, rd, a, n);
        return ();
    }
    if model::equal(op, "lbu") {
        kind = 3;
        f3 = 4;
        opcode = 3;
    }
    if model::equal(op, "lwu") {
        kind = 3;
        f3 = 6;
        opcode = 3;
    }
    if model::equal(op, "ld") {
        kind = 3;
        f3 = 3;
        opcode = 3;
    }
    if model::equal(op, "jalr") {
        kind = 3;
        f3 = 0;
        opcode = 103;
    }
    if model::equal(op, "sb") {
        kind = 4;
        f3 = 0;
    }
    if model::equal(op, "sh") {
        kind = 4;
        f3 = 1;
    }
    if model::equal(op, "sw") {
        kind = 4;
        f3 = 2;
    }
    if model::equal(op, "sd") {
        kind = 4;
        f3 = 3;
    }
    if kind == 3_u32 || kind == 4_u32 {
        let rd:u32 = register();
        punct(44);
        let n:usize = immediate(false);
        punct(40);
        let base:u32 = register();
        punct(41);
        done();
        if kind == 3_u32 {
            rv64::i(opcode, f3, rd, base, n);
        } else {
            rv64::s(f3, rd, base, n);
        }
        return ();
    }
    if model::equal(op, "beq") {
        kind = 5;
        f3 = 0;
    }
    if model::equal(op, "bne") {
        kind = 5;
        f3 = 1;
    }
    if model::equal(op, "bltu") {
        kind = 5;
        f3 = 6;
    }
    if model::equal(op, "bgeu") {
        kind = 5;
        f3 = 7;
    }
    if kind == 5_u32 {
        let a:u32 = register();
        punct(44);
        let b:u32 = register();
        punct(44);
        let id:u32 = target();
        done();
        rv64::branch(f3, a, b, id);
        return ();
    }
    if model::equal(op, "address") {
        let rd:u32 = register();
        punct(44);
        let id:u32 = target();
        done();
        if rd == 0_u32 {
            bad();
        }
        rv64::transfer(rd, id, false);
        return ();
    }
    if model::equal(op, "call") || model::equal(op, "jump") {
        let id:u32 = target();
        done();
        var rd:u32 = 0;
        if model::equal(op, "call") {
            rd = 1;
        }
        rv64::transfer(rd, id, true);
        return ();
    }
    if model::equal(op, "ecall") {
        done();
        image::word(115);
        return ();
    }
    if model::equal(op, "unimp") {
        done();
        image::word(3221229683);
        return ();
    }
    unsafe {
        model::fail(model::ERROR_UNSUPPORTED, file_id, line_start);
    }
    return ();
}

pub fn parse(file:u32, bytes:[]const u8) -> () {
    unsafe {
        input = bytes;
        file_id = file;
        var first:usize = 0;
        while first < input.len {
            var next:usize = first;
            while next < input.len && input[next] != 10_u8 {
                next = next+1_usize;
            }
            end = first;
            while end < next && input[end] != 35_u8 {
                end = end+1_usize;
            }
            line_start = first;
            at = first;
            skip();
            if at < end {
                let op:[]const u8 = token();
                skip();
                if at < end && input[at] == 58_u8 {
                    at = at+1_usize;
                    done();
                    let id:u32 = named(op);
                    if image::get_symbol(id).defined != 0_u32 {
                        bad();
                    }
                    image::define(id, 1, image::text_position());
                } else {
                    operation(op);
                }
            }
            first = next;
            if first < input.len {
                first = first+1_usize;
            }
        }
    }
    return ();
}
