extern abi(C) fn __b2_syscall6(n:usize, a:usize, b:usize, c:usize, d:usize, e:usize, f:usize) -> usize;
pub struct Span {
    pub file:u32,
    pub start:u32,
    pub end:u32
}

pub struct Source {
    pub path:[]const u8,
    pub bytes:[]const u8,
    pub module_id:u32,
    pub import_first:u32,
    pub import_count:u32
}

pub struct Token {
    pub kind:u32,
    pub file:u32,
    pub start:u32,
    pub end:u32,
    pub number:usize,
    pub suffix:u32
}

pub struct Name {
    pub bytes:[]const u8,
    pub hash:usize
}

pub struct Import {
    pub file:u32,
    pub module_id:u32,
    pub alias:u32,
    pub span:Span
}

// Type contract: kind is TYPE_*. a is pointee/element TypeId for POINTER,
// ARRAY and SLICE, or owning DeclId for STRUCT/ENUM.
// b is ARRAY length or ENUM payload byte offset; otherwise zero. flags is TYPE_CONST
// only for POINTER/SLICE. size/align are bytes (align zero means pending layout).
// first/count select fields for STRUCT or variants for ENUM.
// Other kinds leave first/count zero. IDs remain stable for this compilation.
pub struct Type {
    pub kind:u32,
    pub a:u32,
    pub b:u32,
    pub flags:u32,
    pub size:usize,
    pub align:usize,
    pub first:u32,
    pub count:u32
}

pub struct Field {
    pub name:u32,
    pub ty:u32,
    pub flags:u32,
    pub offset:usize,
    pub span:Span
}

// Decl contract: kind is DECL_*; name/module_id are NameIds, file is FileId.
// flags combines FLAG_PUBLIC, FLAG_UNSAFE (including extern), FLAG_MUTABLE.
// ty is a TypeId (return type for functions); first/count select ParamIds for
// functions. start/end delimit declaration/body source bytes; init_start/end
// delimit initializer bytes. symbol is SymbolId, bits is CONST scalar value.
// state is 0 before preparation and 2 after completion; the in-progress
// marker belongs to types::preparing rather than this completed record.
pub struct Decl {
    pub kind:u32,
    pub name:u32,
    pub module_id:u32,
    pub file:u32,
    pub flags:u32,
    pub ty:u32,
    pub first:u32,
    pub count:u32,
    pub start:u32,
    pub end:u32,
    pub init_start:u32,
    pub init_end:u32,
    pub symbol:u32,
    pub bits:usize,
    pub state:u32
}

pub struct Param {
    pub name:u32,
    pub ty:u32,
    pub span:Span
}

// Slot contract: semantic TypeId, SLOT_PARAMETER flags and source provenance.
// Frame byte offsets live only in rv64's private target table. Slot has no
// target-layout field; completed semantic slots are read-only to the backend.
// SlotIds, InstIds and argument ranges live only until reset_function().
pub struct Slot {
    pub ty:u32,
    pub flags:u32,
    pub span:Span
}

// Inst contract: op is IR_*; span is diagnostic provenance. Unused operands
// are zero. dst/a/b refer to SlotIds except for the explicit exceptions below.
// VALUE: dst <- bits. COPY: dst <- a (aggregate snapshot/copy).
// LOCAL_ADDRESS: dst <- address of slot a plus byte offset bits.
// SYMBOL_ADDRESS: dst <- address of SymbolId a. LOAD: dst <- *a.
// STORE: *a <- b. OFFSET: dst <- pointer a plus byte count in slot b.
// BINARY: dst <- a BIN_aux b. UNARY: dst <- UNARY_aux a.
// CAST/BITCAST: dst <- converted a; destination slot supplies target TypeId.
// BOUNDS: require usize slots a < b, otherwise panic.
// CALL: a is stable DeclId; b/c are first/count in model::args (SlotIds).
//       dst is return SlotId, or zero for unit. aux/bits are unused.
// LABEL/JUMP: a is LabelId. BRANCH: a is bool SlotId; b/c are yes/no LabelIds.
// RETURN: a is returned SlotId, or zero for unit. PANIC: no operands.
// LABEL opens a block. JUMP/BRANCH/RETURN/PANIC terminate it. IDs and ranges
// use one-based indexes; zero is absent, never a valid non-unit value slot.
pub struct Inst {
    pub op:u32,
    pub dst:u32,
    pub a:u32,
    pub b:u32,
    pub c:u32,
    pub aux:u32,
    pub bits:usize,
    pub span:Span
}

pub struct Data {
    pub symbol:u32,
    pub region:u32,
    pub align:usize,
    pub size:usize,
    pub first:usize,
    pub count:usize
}

pub struct DataRelocation {
    pub object:u32,
    pub offset:usize,
    pub target:u32,
    pub addend:usize
}

pub struct Symbol {
    pub name:u32,
    pub region:u32,
    pub offset:usize,
    pub size:usize,
    pub align:usize,
    pub defined:u32,
    pub kind:u32
}

pub struct Fixup {
    pub region:u32,
    pub kind:u32,
    pub offset:usize,
    pub symbol:u32,
    pub addend:usize
}

