module bootstrap::init;
import bootstrap::model;
import bootstrap::image;
import bootstrap::types;
import bootstrap::parse;
const ZERO:u32 = 0;
const SCALAR:u32 = 1;
const ADDRESS:u32 = 2;
const STRING:u32 = 3;
const GROUP:u32 = 4;
const REPEAT:u32 = 5;
// Checked data contains concrete types, resolved values and child offsets.
// Serialization consumes this tree without inspecting AST nodes or names.
struct InitData {
    kind:u32,
    ty:model::TypeId,
    first:u32,
    next:u32,
    target:u32,
    offset:usize,
    bits:usize,
    all_zero:bool,
    data:*const u8
}

enum DataEntry {
    Empty,
    Value(InitData)
}

static mut records:[32769]DataEntry = zero;
static mut count:u32 = 0;
static mut depth:u32 = 0;
fn record(id:u32) -> InitData {
    unsafe {
        if id == 0_u32 || id > count {
            types::fail(model::ERROR_INTERNAL);
        }
        loop {
            match records[id as usize] {
                DataEntry::Empty => {
                    types::fail(model::ERROR_INTERNAL);
                },
                DataEntry::Value(value) => {
                    return value;
                }
            }
        }
    }
}

fn add(kind:u32, ty:model::TypeId, offset:usize, bits:usize, target:u32) -> u32 {
    unsafe {
        if count >= 32768_u32 {
            types::limit((count as usize)+1_usize, 32768);
        }
        count = count+1_u32;
        records[count as usize] = DataEntry::Value(make InitData {
            kind:kind,
            ty:ty,
            first:0,
            next:0,
            target:target,
            offset:offset,
            bits:bits,
            all_zero:kind == ZERO || (kind == SCALAR && bits == 0_usize),
            data:null
        });
        return count;
    }
}

fn append(parent:u32, tail:u32, child:u32) -> u32 {
    unsafe {
        if tail == 0_u32 {
            {
                var data:InitData = record(parent);
                data.first = child;
                records[parent as usize] = DataEntry::Value(data);
            }
        } else {
            {
                var data:InitData = record(tail);
                data.next = child;
                records[tail as usize] = DataEntry::Value(data);
            }
        }
    }
    return child;
}

fn static_address(call:parse::Call, file:u32, ty:model::TypeId) -> u32 {
    let t:model::Type = types::info(ty);
    let name:[]const u8 = types::text(call.callee);
    let mutable:bool = model::equal(name, "core::addr_of_mut");
    if !mutable && !model::equal(name, "core::addr_of") {
        types::fail(model::ERROR_UNSUPPORTED);
    }
    if parse::is_none(call.arguments) || !parse::is_none(parse::next(call.arguments)) {
        types::fail(model::ERROR_UNSUPPORTED);
    }
    let name_id:model::NameId = parse::name_of(call.arguments);
    if model::is_no_name(name_id) {
        types::fail(model::ERROR_UNSUPPORTED);
    }
    let id:u32 = types::resolve(file, name_id, false);
    if id == 0_u32 {
        types::fail(model::ERROR_NAME);
    }
    unsafe {
        let d:model::Decl = model::get_decl(id);
        if d.kind != model::DECL_STATIC || t.kind != model::TYPE_POINTER || !model::same_type(t.element, d.ty) {
            types::fail(model::ERROR_TYPE);
        }
        if mutable && (d.flags&model::FLAG_MUTABLE) == 0_u32 {
            types::fail(model::ERROR_PERMISSION);
        }
        if t.flags == model::TYPE_MUTABLE && !mutable {
            types::fail(model::ERROR_TYPE);
        }
        return d.symbol;
    }
}

fn build(node:parse::NodeId, ty:model::TypeId, offset:usize) -> u32 {
    types::locate(parse::location(node));
    unsafe {
        if depth >= 64_u32 {
            types::limit((depth as usize)+1_usize, 64);
        }
        depth = depth+1_u32;
    }
    let result:u32 = build_inner(node, ty, offset);
    unsafe {
        depth = depth-1_u32;
    }
    return result;
}

fn build_variant(arguments:parse::NodeId, called:bool, ty:model::TypeId, offset:usize, v:types::Variant) -> u32 {
    if !model::same_type(v.ty, ty) || called != v.has_payload {
        types::fail(model::ERROR_TYPE);
    }
    if v.has_payload && (parse::is_none(arguments) || !parse::is_none(parse::next(arguments))) {
        types::fail(model::ERROR_TYPE);
    }
    let result:u32 = add(GROUP, ty, offset, 0, 0);
    let tag:u32 = add(SCALAR, model::u32_type(), 0, v.tag as usize, 0);
    var tail:u32 = append(result, 0, tag);
    var all:bool = v.tag == 0_u32;
    if v.has_payload {
        let child:u32 = build(arguments, v.payload, v.offset);
        tail = append(result, tail, child);
        unsafe {
            all = all && record(child).all_zero;
        }
    }
    unsafe {
        {
            var data:InitData = record(result);
            data.all_zero = all;
            records[result as usize] = DataEntry::Value(data);
        }
    }
    return result;
}

fn build_record(value:parse::RecordValue, span:model::Span, ty:model::TypeId, offset:usize) -> u32 {
    let t:model::Type = types::info(ty);
    if t.kind != model::TYPE_STRUCT || !model::same_type(types::named_type(span.file, value.type_name, false), ty) {
        model::diagnose(model::ERROR_TYPE, span);
    }
    let result:u32 = add(GROUP, ty, offset, 0, 0);
    var tail:u32 = 0;
    var seen:[256]u32 = [0;256];
    var item:parse::NodeId = value.fields;
    var found:u32 = 0;
    var all:bool = true;
    unsafe {
        while !parse::is_none(item) {
            let pair:parse::FieldValue = parse::field_value(item);
            var index:u32 = 0;
            while index < t.count && !model::same_name(model::get_field((t.first+index)).name, pair.name) {
                index = index+1_u32;
            }
            if index == t.count {
                model::diagnose(model::ERROR_NAME, parse::location(item));
            }
            if seen[index as usize] != 0_u32 {
                model::diagnose(model::ERROR_TYPE, parse::location(item));
            }
            seen[index as usize] = 1;
            let f:model::Field = model::get_field((t.first+index));
            if !types::field_visible(ty, f.flags, span.file) {
                model::diagnose(model::ERROR_NAME, parse::location(item));
            }
            let child:u32 = build(pair.value, f.ty, f.offset);
            // Recursive initializers locate their own errors; resume this record afterward.
            types::locate(span);
            tail = append(result, tail, child);
            if !record(child).all_zero {
                all = false;
            }
            found = found+1_u32;
            item = parse::next(item);
        }
        if found != t.count {
            model::diagnose(model::ERROR_TYPE, span);
        }
        {
            var data:InitData = record(result);
            data.all_zero = all;
            records[result as usize] = DataEntry::Value(data);
        }
    }
    return result;
}

fn build_array(first:parse::NodeId, ty:model::TypeId, offset:usize) -> u32 {
    let t:model::Type = types::info(ty);
    if t.kind != model::TYPE_ARRAY {
        types::fail(model::ERROR_TYPE);
    }
    let stride:usize = types::info(t.element).size;
    let result:u32 = add(GROUP, ty, offset, 0, 0);
    var item:parse::NodeId = first;
    var i:u32 = 0;
    var tail:u32 = 0;
    var all:bool = true;
    while !parse::is_none(item) {
        if i >= t.b {
            types::fail(model::ERROR_TYPE);
        }
        let child:u32 = build(item, t.element, (i as usize)*stride);
        tail = append(result, tail, child);
        unsafe {
            if !record(child).all_zero {
                all = false;
            }
        }
        item = parse::get(item).next;
        i = i+1_u32;
    }
    if i != t.b {
        types::fail(model::ERROR_TYPE);
    }
    unsafe {
        {
            var data:InitData = record(result);
            data.all_zero = all;
            records[result as usize] = DataEntry::Value(data);
        }
    }
    return result;
}

fn build_repeat(value:parse::RepeatValue, ty:model::TypeId, offset:usize) -> u32 {
    let t:model::Type = types::info(ty);
    if t.kind != model::TYPE_ARRAY || types::repeat_length(value.length) != t.b {
        types::fail(model::ERROR_TYPE);
    }
    let child:u32 = build(value.value, t.element, 0);
    let result:u32 = add(REPEAT, ty, offset, types::info(t.element).size, t.b);
    unsafe {
        {
            var data:InitData = record(result);
            data.first = child;
            records[result as usize] = DataEntry::Value(data);
        }
        {
            var data:InitData = record(result);
            data.all_zero = t.b == 0_u32 || record(child).all_zero;
            records[result as usize] = DataEntry::Value(data);
        }
    }
    return result;
}

fn build_scalar(node:parse::NodeId, ty:model::TypeId, offset:usize) -> u32 {
    if !types::integer(ty) && !model::same_type(ty, model::bool_type()) {
        types::fail(model::ERROR_TYPE);
    }
    let value:types::Constant = types::constant_value(node, ty);
    return add(SCALAR, ty, offset, value.bits, 0);
}

fn build_inner(node:parse::NodeId, ty:model::TypeId, offset:usize) -> u32 {
    let n:parse::Node = parse::get(node);
    let t:model::Type = types::info(ty);
    match n.syntax {
        parse::Syntax::Zero => {
            types::check_zero(ty, n.span.file);
            return add(ZERO, ty, offset, 0, 0);
        },
        parse::Syntax::String(name) => {
            if t.kind != model::TYPE_SLICE || !model::same_type(t.element, model::u8_type()) || t.flags != model::TYPE_CONST {
                types::fail(model::ERROR_TYPE);
            }
            let bytes:[]const u8 = types::text(name);
            let result:u32 = add(STRING, ty, offset, bytes.len, 0);
            unsafe {
                {
                    var data:InitData = record(result);
                    data.data = bytes.data;
                    records[result as usize] = DataEntry::Value(data);
                }
            }
            return result;
        },
        parse::Syntax::Name(name) => {
            let v:types::Variant = types::variant(n.span.file, name);
            if v.found {
                return build_variant(parse::nil(), false, ty, offset, v);
            }
            return build_scalar(node, ty, offset);
        },
        parse::Syntax::Call(call) => {
            let v:types::Variant = types::variant(n.span.file, call.callee);
            if v.found {
                return build_variant(call.arguments, true, ty, offset, v);
            }
            return add(ADDRESS, ty, offset, 0, static_address(call, n.span.file, ty));
        },
        parse::Syntax::Record(value) => {
            return build_record(value, n.span, ty, offset);
        },
        parse::Syntax::Array(first) => {
            return build_array(first, ty, offset);
        },
        parse::Syntax::Repeat(value) => {
            return build_repeat(value, ty, offset);
        },
        parse::Syntax::Unit => {
            if !model::same_type(ty, model::unit_type()) {
                types::fail(model::ERROR_TYPE);
            }
            return add(ZERO, ty, offset, 0, 0);
        },
        parse::Syntax::Null => {
            if t.kind != model::TYPE_POINTER {
                types::fail(model::ERROR_TYPE);
            }
            return add(ZERO, ty, offset, 0, 0);
        },
        parse::Syntax::Integer(_) => {
            return build_scalar(node, ty, offset);
        },
        parse::Syntax::Boolean(_) => {
            return build_scalar(node, ty, offset);
        },
        parse::Syntax::Unary(_) => {
            return build_scalar(node, ty, offset);
        },
        parse::Syntax::Binary(_) => {
            return build_scalar(node, ty, offset);
        },
        parse::Syntax::Cast(_) => {
            return build_scalar(node, ty, offset);
        },
        parse::Syntax::Empty => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Field(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Index(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::FieldValue(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::SizeOf(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::AlignOf(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Pointer(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::VariantPattern(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Wildcard => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::MatchArm(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Block(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Bind(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Assign(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Expression(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Unsafe(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::If(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::While(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Loop(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Return(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Break => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Continue => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Defer(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Match(_) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::EmptyStatement => {
            types::fail(model::ERROR_TYPE);
        },
    }
    return 0;
}


pub fn string_data(name:model::NameId) -> u32 {
    return string_bytes(types::text(name));
}

fn string_bytes(bytes:[]const u8) -> u32 {
    var size:usize = bytes.len;
    if size == 0_usize { size = 1; }
    let symbol:u32 = image::named(model::no_name(), model::SYMBOL_DATA);
    let object:u32 = image::object(symbol, 2, 1, size);
    var i:usize = 0;
    unsafe {
        while i < bytes.len { image::write_scalar(object, i, bytes[i] as usize, 1); i = i+1_usize; }
    }
    return symbol;
}

fn relocation(object:u32, offset:usize, target:u32) -> () {
    image::relocate(make model::DataRelocation {
        object:object,
        offset:offset,
        target:target,
        addend:0
    });
    return ();
}

fn serialize(id:u32, object:u32, base:usize) -> () {
    unsafe {
        let r:InitData = record(id);
        let offset:usize = base+r.offset;
        if r.kind == ZERO {
            return ();
        }
        if r.kind == SCALAR {
            image::write_scalar(object, offset, r.bits, types::info(r.ty).size);
            return ();
        }
        if r.kind == ADDRESS {
            relocation(object, offset, r.target);
            return ();
        }
        if r.kind == STRING {
            relocation(object, offset, string_bytes(core::slice_from_raw_parts(r.data, r.bits)));
            image::write_scalar(object, offset+8_usize, r.bits, 8);
            return ();
        }
        if r.kind == GROUP {
            var child:u32 = r.first;
            while child != 0_u32 {
                serialize(child, object, offset);
                child = record(child).next;
            }
            return ();
        }
        if r.kind != REPEAT {
            types::fail(model::ERROR_INTERNAL);
        }
        if r.target == 0_u32 {
            return ();
        }
        let first:u32 = image::relocation_count()+1_u32;
        serialize(r.first, object, offset);
        let last:u32 = image::relocation_count();
        var i:u32 = 1;
        while i < r.target {
            let displacement:usize = (i as usize)*r.bits;
            image::copy_data(object, offset+displacement, offset, r.bits);
            var ref:u32 = first;
            while ref <= last {
                let item:model::DataRelocation = image::get_relocation(ref);
                if item.object == object && item.offset >= offset && item.offset < offset+r.bits {
                    image::relocate(make model::DataRelocation {
                        object:object,
                        offset:item.offset+displacement,
                        target:item.target,
                        addend:item.addend
                    });
                }
                ref = ref+1_u32;
            }
            i = i+1_u32;
        }
    }
    return ();
}

pub fn collect() -> () {
    unsafe {
        var id:u32 = 1;
        while id <= model::decl_count() {
            let d:model::Decl = model::get_decl(id);
            if d.kind == model::DECL_STATIC {
                count = 0;
                depth = 0;
                let value:u32 = build(parse::header(id).init, d.ty, 0);
                let t:model::Type = types::info(d.ty);
                var region:u32 = 2;
                if (d.flags&model::FLAG_MUTABLE) != 0_u32 {
                    region = 3;
                    if record(value).all_zero {
                        region = 4;
                    }
                }
                var size:usize = t.size;
                if size == 0_usize {
                    size = 1;
                }
                let object:u32 = image::object(d.symbol, region, t.align, size);
                if region != 4_u32 {
                    serialize(value, object, 0);
                }
            }
            id = id+1_u32;
        }
        count = 0;
    }
    return ();
}
