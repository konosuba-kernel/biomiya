// Typed slots to RV64. No source text or AST is visible in this module.
module bootstrap::rv64;
import bootstrap::model;
import bootstrap::image;
static mut panic_symbol:u32 = 0;
static mut copy_symbol:u32 = 0;
static mut labels:[65537]u32 = [0; 65537];
// Explicit DFS storage bounds type validation independently of machine call depth.
static mut type_state:[8193]u8 = [0; 8193];
static mut type_stack:[8193]u32 = [0; 8193];
static mut type_edge:[8193]u32 = [0; 8193];
static mut label_defs:[65537]u8 = [0; 65537];
static mut save:usize = 0;
static mut result_pointer:usize = 0;
static mut frame_size:usize = 0;
static mut frame_align:usize = 16;
static mut current:u32 = 0;
static mut here:model::Span = model::Span {
    file:0,start:0,end:0
};

fn bad() -> () {
    unsafe {
        model::fail(7,here.file,here.start as usize);
    }
    return ();
}

fn reg(n:u32) -> () {
    if n >= 32_u32 {
        bad();
    }
    return ();
}

pub fn r(f7:u32,f3:u32,rd:u32,a:u32,b:u32) -> () {
    reg(rd);
    reg(a);
    reg(b);
    image::word((f7 << 25_u32) | (b << 20_u32) | (a << 15_u32) | (f3 << 12_u32) | (rd << 7_u32) | 51_u32);
    return ();
}

pub fn i(opcode:u32,f3:u32,rd:u32,a:u32,n:usize) -> () {
    reg(rd);
    reg(a);
    image::word((((n & 4095_usize) as u32) << 20_u32) | (a << 15_u32) | (f3 << 12_u32) | (rd << 7_u32) | opcode);
    return ();
}

pub fn s(f3:u32,rs:u32,base:u32,n:usize) -> () {
    reg(rs);
    reg(base);
    let v:u32 = (n & 4095_usize) as u32;
    image::word(((v >> 5_u32) << 25_u32) | (rs << 20_u32) | (base << 15_u32) | (f3 << 12_u32) | ((v & 31_u32) << 7_u32) | 35_u32);
    return ();
}

pub fn constant(rd:u32,n:usize) -> () {
    if n <= 2047_usize || n >= 18446744073709549568_usize {
        i(19,0,rd,0,n);
        return ();
    }
    let lo:usize = n & 4095_usize;
    var high:usize = n >> 12_usize;
    if n >= 9223372036854775808_usize {
        high = high | 18442240474082181120_usize;
    }
    if lo >= 2048_usize {
        high = high+%1_usize;
    }
    constant(rd,high);
    i(19,1,rd,rd,12);
    if lo != 0_usize {
        i(19,0,rd,rd,lo);
    }
    return ();
}

pub fn transfer(rd:u32,target:u32,jump:bool) -> () {
    reg(rd);
    if !jump && rd == 0_u32 {
        bad();
    }
    if jump && rd != 0_u32 && rd != 1_u32 {
        bad();
    }
    image::fixup(image::text_position(),target,rd,jump);
    return ();
}

pub fn branch(f3:u32,a:u32,b:u32,target:u32) -> () {
    reg(a);
    reg(b);
    if f3 != 0_u32 && f3 != 1_u32 && f3 != 6_u32 && f3 != 7_u32 {
        bad();
    }
    image::word((b << 20_u32) | (a << 15_u32) | ((f3 ^ 1_u32) << 12_u32) | 1536_u32 | 99_u32);
    transfer(0,target,true);
    return ();
}

fn mark(id:u32) -> () {
    image::define(id,1,image::text_position());
    return ();
}

fn mov(dst:u32,src:u32) -> () {
    i(19,0,dst,src,0);
    return ();
}

fn address(rd:u32,base:u32,off:usize) -> () {
    if off <= 2047_usize {
        i(19,0,rd,base,off);
    }
    else {
        var temp:u32 = rd;
        if rd == base {
            temp = 29;
        }
        constant(temp,off);
        r(0,0,rd,base,temp);
    }
    return ();
}

fn load(rd:u32,base:u32,off:usize,size:usize) -> () {
    if size == 0_usize {
        constant(rd,0);
        return ();
    }
    var f3:u32 = 3;
    if size == 1_usize {
        f3 = 4;
    }
    else {
        if size == 4_usize {
            f3 = 6;
        }
        else {
            if size != 8_usize {
                bad();
            }
        }
    }
    if off <= 2047_usize {
        i(3,f3,rd,base,off);
    }
    else {
        address(31,base,off);
        i(3,f3,rd,31,0);
    }
    return ();
}

fn store(rs:u32,base:u32,off:usize,size:usize) -> () {
    if size == 0_usize {
        return ();
    }
    var f3:u32 = 3;
    if size == 1_usize {
        f3 = 0;
    }
    else {
        if size == 4_usize {
            f3 = 2;
        }
        else {
            if size != 8_usize {
                bad();
            }
        }
    }
    if off <= 2047_usize {
        s(f3,rs,base,off);
    }
    else {
        address(31,base,off);
        s(f3,rs,31,0);
    }
    return ();
}

fn info(id:u32) -> model::Type {
    unsafe {
        if id == 0_u32 || id > model::type_count {
            bad();
        }
        let ty:model::Type = model::types[id as usize];
        if ty.kind == 0_u32 || ty.kind > 10_u32 || ty.align == 0_usize || ty.align > 4096_usize || (ty.align & (ty.align-1_usize)) != 0_usize {
            bad();
        }
        var expected:usize = ty.size;
        if ty.kind == 1_u32 {
            expected = 0;
        }
        if ty.kind == 2_u32 || ty.kind == 3_u32 {
            expected = 1;
        }
        if ty.kind == 4_u32 {
            expected = 4;
        }
        if ty.kind == 5_u32 || ty.kind == 6_u32 {
            expected = 8;
        }
        if ty.kind == 8_u32 {
            expected = 16;
        }
        if ty.size != expected {
            bad();
        }
        if ty.kind == 6_u32 || ty.kind == 7_u32 || ty.kind == 8_u32 || ty.kind == 10_u32 {
            if ty.a == 0_u32 || ty.a > model::type_count {
                bad();
            }
        }
        if ty.kind == 10_u32 {
            if ty.b == 0_u32 || ty.b > model::type_count {
                bad();
            }
        }
        return ty;
    }
}
// Only value edges require completed child layout. Pointers and slices terminate.

fn layout_child(ty:model::Type,edge:u32) -> u32 {
    if ty.kind == 7_u32 && edge == 0_u32 {
        return ty.a;
    }
    if ty.kind == 10_u32 {
        if edge == 0_u32 {
            return ty.a;
        }
        if edge == 1_u32 {
            return ty.b;
        }
    }
    if ty.kind == 9_u32 {
        unsafe {
            if ty.count != 0_u32 && (ty.first == 0_u32 || ty.first > model::field_count || ty.count > model::field_count-ty.first+1_u32) {
                bad();
            }
            if edge < ty.count {
                return model::fields[(ty.first+edge) as usize].ty;
            }
        }
    }
    return 0;
}

fn finite_layouts() -> () {
    unsafe {
        if model::type_count == 0_u32 || model::type_count > 8192_u32 || model::field_count > 32768_u32 { bad(); }
        var root:u32 = 1;
        while root <= model::type_count {
            type_state[root as usize] = 0;
            root = root+1_u32;
        }
        root = 1;
        while root <= model::type_count {
            if type_state[root as usize] == 0_u8 {
                var depth:usize = 1;
                type_stack[depth] = root;
                type_edge[depth] = 0;
                type_state[root as usize] = 1;
                while depth != 0_usize {
                    let id:u32 = type_stack[depth];
                    let child:u32 = layout_child(info(id),type_edge[depth]);
                    if child == 0_u32 {
                        type_state[id as usize] = 2;
                        depth = depth-1_usize;
                    }
                    else {
                        let checked:model::Type = info(child);
                        type_edge[depth] = type_edge[depth]+1_u32;
                        if type_state[child as usize] == 1_u8 {
                            bad();
                        }
                        if type_state[child as usize] == 0_u8 {
                            if depth >= 8192_usize {
                                bad();
                            }
                            depth = depth+1_usize;
                            type_stack[depth] = child;
                            type_edge[depth] = 0;
                            type_state[child as usize] = 1;
                        }
                    }
                }
            }
            root = root+1_u32;
        }
    }
    return ();
}

fn layouts() -> () {
    finite_layouts();
    unsafe {
        var id:u32 = 1;
        while id <= model::type_count {
            let ty:model::Type = info(id);
            var size:usize = ty.size;
            var alignment:usize = ty.align;
            if ty.kind <= 6_u32 {
                alignment = ty.size;
                if alignment == 0_usize {
                    alignment = 1;
                }
            }
            if ty.kind == 6_u32 || ty.kind == 8_u32 {
                if ty.flags > 1_u32 {
                    bad();
                }
            }
            if ty.kind == 8_u32 {
                alignment = 8;
            }
            if ty.kind == 7_u32 {
                let element:model::Type = info(ty.a);
                alignment = element.align;
                if ty.b != 0_u32 && element.size > 67108864_usize/(ty.b as usize) {
                    bad();
                }
                size = element.size*(ty.b as usize);
            }
            if ty.kind == 9_u32 {
                if ty.count != 0_u32 && (ty.first == 0_u32 || ty.first > model::field_count || ty.count > model::field_count-ty.first+1_u32) {
                    bad();
                }
                size = 0;
                alignment = 1;
                var field:u32 = 0;
                while field < ty.count {
                    let item:model::Field = model::fields[(ty.first+field) as usize];
                    let ft:model::Type = info(item.ty);
                    size = image::aligned(size,ft.align);
                    if item.offset != size || ft.size > 67108864_usize-size {
                        bad();
                    }
                    size = size+ft.size;
                    if ft.align > alignment {
                        alignment = ft.align;
                    }
                    field = field+1_u32;
                }
                size = image::aligned(size,alignment);
            }
            if ty.kind == 10_u32 {
                let ok:model::Type = info(ty.a);
                let error:model::Type = info(ty.b);
                alignment = ok.align;
                if error.align > alignment {
                    alignment = error.align;
                }
                let payload:usize = image::aligned(4,alignment);
                if (ty.first as usize) != payload {
                    bad();
                }
                if alignment < 4_usize {
                    alignment = 4;
                }
                size = ok.size;
                if error.size > size {
                    size = error.size;
                }
                if size > 67108864_usize-payload {
                    bad();
                }
                size = image::aligned(size+payload,alignment);
            }
            if ty.size != size || ty.align != alignment {
                bad();
            }
            id = id+1_u32;
        }
    }
    return ();
}

fn slot(id:u32) -> model::Slot {
    unsafe {
        if id == 0_u32 || id > model::slot_count {
            bad();
        }
        return model::slots[id as usize];
    }
}

fn scalar(ty:model::Type) -> bool {
    return ty.kind <= 6_u32;
}

fn integer(ty:model::Type) -> bool {
    return ty.kind >= 3_u32 && ty.kind <= 5_u32;
}

fn stype(id:u32) -> model::Type {
    return info(slot(id).ty);
}

fn same(a:u32,b:u32) -> () {
    if slot(a).ty != slot(b).ty {
        bad();
    }
    return ();
}

fn value(id:u32,rd:u32) -> () {
    let item:model::Slot = slot(id);
    let ty:model::Type = info(item.ty);
    if !scalar(ty) {
        bad();
    }
    load(rd,2,item.offset,ty.size);
    return ();
}

fn destination(id:u32,rd:u32) -> () {
    address(rd,2,slot(id).offset);
    return ();
}

fn normalize(rd:u32,ty:model::Type) -> () {
    if ty.kind == 3_u32 {
        i(19,1,rd,rd,56);
        i(19,5,rd,rd,56);
    }
    if ty.kind == 4_u32 {
        i(19,1,rd,rd,32);
        i(19,5,rd,rd,32);
    }
    return ();
}

fn extension(rd:u32,ty:model::Type) -> () {
    if ty.kind >= 2_u32 && ty.kind <= 4_u32 {
        i(27,0,rd,rd,0);
    }
    return ();
}

fn panic() -> () {
    unsafe {
        transfer(1,panic_symbol,true);
    }
    image::word(3221229683);
    return ();
}

fn guard(f3:u32,a:u32,b:u32) -> () {
    let good:u32 = image::fresh();
    branch(f3,a,b,good);
    panic();
    mark(good);
    return ();
}
// memmove with t0 destination, t1 source; no argument registers are clobbered.

fn copy(size:usize) -> () {
    if size == 0_usize {
        return ();
    }
    constant(7,size);
    unsafe {
        transfer(1,copy_symbol,true);
    }
    return ();
}

fn copy_body() -> () {
    let backward:u32 = image::fresh();
    let forward:u32 = image::fresh();
    let reverse:u32 = image::fresh();
    let done:u32 = image::fresh();
    branch(0,5,6,done);
    branch(6,6,5,backward);
    mark(forward);
    load(28,6,0,1);
    store(28,5,0,1);
    i(19,0,5,5,1);
    i(19,0,6,6,1);
    i(19,0,7,7,18446744073709551615);
    branch(1,7,0,forward);
    transfer(0,done,true);
    mark(backward);
    r(0,0,5,5,7);
    r(0,0,6,6,7);
    mark(reverse);
    i(19,0,5,5,18446744073709551615);
    i(19,0,6,6,18446744073709551615);
    load(28,6,0,1);
    store(28,5,0,1);
    i(19,0,7,7,18446744073709551615);
    branch(1,7,0,reverse);
    mark(done);
    i(103,0,0,1,0);
    return ();
}

fn declaration(id:u32) -> model::Decl {
    unsafe {
        if id == 0_u32 || id > model::decl_count {
            bad();
        }
        let decl:model::Decl = model::decls[id as usize];
        if decl.kind != 2_u32 && decl.kind != 3_u32 {
            bad();
        }
        if decl.count > 256_u32 || (decl.count != 0_u32 && (decl.first == 0_u32 || decl.first > model::param_count || decl.count > model::param_count-decl.first+1_u32)) {
            bad();
        }
        let result:model::Type = info(decl.ty);
        var p:u32 = 0;
        while p < decl.count {
            let ty:model::Type = info(model::params[(decl.first+p) as usize].ty);
            if decl.kind == 3_u32 && (!scalar(ty) || ty.kind == 1_u32) {
                bad();
            }
            p = p+1_u32;
        }
        if decl.kind == 3_u32 && (!scalar(result) || (decl.flags & 2_u32) == 0_u32) {
            bad();
        }
        if decl.symbol == 0_u32 || decl.symbol > model::symbol_count {
            bad();
        }
        return decl;
    }
}

fn positions(decl:model::Decl) -> usize {
    var n:usize = 0;
    let result:model::Type = info(decl.ty);
    if !scalar(result) && result.size != 0_usize {
        n = 1;
    }
    var p:u32 = 0;
    unsafe {
        while p < decl.count {
            if info(model::params[(decl.first+p) as usize].ty).size != 0_usize {
                n = n+1_usize;
            }
            p = p+1_u32;
        }
    }
    return n;
}

fn outgoing_size(decl:model::Decl) -> usize {
    let n:usize = positions(decl);
    if n <= 8_usize {
        return 0;
    }
    return image::aligned((n-8_usize)*8_usize,16);
}

fn incoming(position:usize,rd:u32) -> () {
    if position < 8_usize {
        mov(rd,10_u32+(position as u32));
    }
    else {
        load(rd,8,(position-8_usize)*8_usize,8);
    }
    return ();
}

fn outgoing(position:usize,rs:u32) -> () {
    if position < 8_usize {
        mov(10_u32+(position as u32),rs);
    }
    else {
        store(rs,2,(position-8_usize)*8_usize,8);
    }
    return ();
}

fn label(id:u32) -> u32 {
    unsafe {
        if id == 0_u32 || id > 65536_u32 {
            bad();
        }
        if labels[id as usize] == 0_u32 {
            labels[id as usize] = image::fresh();
        }
        return labels[id as usize];
    }
}

fn validate(item:model::Inst,decl:model::Decl) -> () {
    unsafe {
        here = item.span;
    }
    if item.op == 1_u32 {
        let ty:model::Type = stype(item.dst);
        if !scalar(ty) {
            bad();
        }
        if ty.kind == 1_u32 || ty.kind == 6_u32 {
            if item.bits != 0_usize {
                bad();
            }
        }
        if ty.kind == 2_u32 && item.bits > 1_usize {
            bad();
        }
        if ty.kind == 3_u32 && item.bits > 255_usize {
            bad();
        }
        if ty.kind == 4_u32 && item.bits > 4294967295_usize {
            bad();
        }
    }
    else {
        if item.op == 2_u32 {
            same(item.dst,item.a);
        }
        else {
            if item.op == 3_u32 {
                let ty:model::Type = stype(item.dst);
                let source:model::Type = stype(item.a);
                if ty.kind != 6_u32 {
                    bad();
                }
                let size:usize = info(ty.a).size;
                if item.bits > source.size || size > source.size-item.bits {
                    bad();
                }
            }
            else {
                if item.op == 4_u32 {
                    if stype(item.dst).kind != 6_u32 {
                        bad();
                    }
                    unsafe {
                        if item.a == 0_u32 || item.a > model::symbol_count {
                            bad();
                        }
                    }
                }
                else {
                    if item.op == 5_u32 || item.op == 6_u32 {
                        let ptr:model::Type = stype(item.a);
                        var v:u32 = item.dst;
                        if item.op == 6_u32 {
                            v = item.b;
                            if (ptr.flags & 1_u32) != 0_u32 {
                                bad();
                            }
                        }
                        if ptr.kind != 6_u32 || ptr.a != slot(v).ty {
                            bad();
                        }
                    }
                    else {
                        if item.op == 7_u32 {
                            // Internal layout projection may change pointee, never permission.
                            if stype(item.dst).kind != 6_u32 || stype(item.a).kind != 6_u32 || stype(item.b).kind != 5_u32 || stype(item.dst).flags != stype(item.a).flags {
                                bad();
                            }
                        }
                        else {
                            if item.op == 8_u32 {
                                same(item.a,item.b);
                                let ty:model::Type = stype(item.a);
                                if item.aux == 0_u32 || item.aux > 19_u32 {
                                    bad();
                                }
                                if item.aux >= 14_u32 {
                                    if stype(item.dst).kind != 2_u32 || (!integer(ty) && ty.kind != 2_u32 && ty.kind != 6_u32) {
                                        bad();
                                    }
                                    if item.aux >= 16_u32 && !integer(ty) {
                                        bad();
                                    }
                                }
                                else {
                                    same(item.dst,item.a);
                                    if !integer(ty) {
                                        bad();
                                    }
                                }
                            }
                            else {
                                if item.op == 9_u32 {
                                    same(item.dst,item.a);
                                    let ty:model::Type = stype(item.a);
                                    if item.aux == 1_u32 {
                                        if ty.kind != 2_u32 {
                                            bad();
                                        }
                                    }
                                    else {
                                        if (item.aux != 2_u32 && item.aux != 3_u32) || !integer(ty) {
                                            bad();
                                        }
                                    }
                                }
                                else {
                                    if item.op == 10_u32 {
                                        if !integer(stype(item.dst)) || !integer(stype(item.a)) {
                                            bad();
                                        }
                                    }
                                    else {
                                        if item.op == 11_u32 {
                                            let a:model::Type = stype(item.a);
                                            let b:model::Type = stype(item.dst);
                                            if a.kind == 6_u32 && b.kind == 6_u32 {
                                                if a.a != b.a || (a.flags & 1_u32) > (b.flags & 1_u32) {
                                                    bad();
                                                }
                                            }
                                            else {
                                                if !((a.kind == 6_u32 && b.kind == 5_u32) || (a.kind == 5_u32 && b.kind == 6_u32)) {
                                                    bad();
                                                }
                                            }
                                        }
                                        else {
                                            if item.op == 12_u32 {
                                                if stype(item.a).kind != 5_u32 || stype(item.b).kind != 5_u32 {
                                                    bad();
                                                }
                                            }
                                            else {
                                                if item.op == 13_u32 {
                                                    let target:model::Decl = declaration(item.a);
                                                    if target.count != item.c {
                                                        bad();
                                                    }
                                                    unsafe {
                                                        if item.c != 0_u32 && (item.b == 0_u32 || item.b > model::arg_count || item.c > model::arg_count-item.b+1_u32) {
                                                            bad();
                                                        }
                                                        var p:u32 = 0;
                                                        while p < item.c {
                                                            if slot(model::args[(item.b+p) as usize]).ty != model::params[(target.first+p) as usize].ty {
                                                                bad();
                                                            }
                                                            p = p+1_u32;
                                                        }
                                                    }
                                                    if info(target.ty).size != 0_usize || item.dst != 0_u32 {
                                                        if slot(item.dst).ty != target.ty {
                                                            bad();
                                                        }
                                                    }
                                                }
                                                else {
                                                    if item.op == 14_u32 || item.op == 15_u32 {
                                                        let ignored:u32 = label(item.a);
                                                    }
                                                    else {
                                                        if item.op == 16_u32 {
                                                            if stype(item.a).kind != 2_u32 {
                                                                bad();
                                                            }
                                                            let yes:u32 = label(item.b);
                                                            let no:u32 = label(item.c);
                                                        }
                                                        else {
                                                            if item.op == 17_u32 {
                                                                if info(decl.ty).size != 0_usize || item.a != 0_u32 {
                                                                    if slot(item.a).ty != decl.ty {
                                                                        bad();
                                                                    }
                                                                }
                                                            }
                                                            else {
                                                                if item.op != 18_u32 {
                                                                    bad();
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ();
}

fn binary(item:model::Inst) -> () {
    let ty:model::Type = stype(item.a);
    let op:u32 = item.aux;
    value(item.a,6);
    value(item.b,7);
    if op == 1_u32 || op == 6_u32 {
        r(0,0,5,6,7);
        if op == 1_u32 {
            guard(7,5,6);
        }
    }
    else {
        if op == 2_u32 || op == 7_u32 {
            if op == 2_u32 {
                guard(7,6,7);
            }
            r(32,0,5,6,7);
        }
        else {
            if op == 3_u32 || op == 8_u32 {
                r(1,0,5,6,7);
                if op == 3_u32 {
                    r(1,3,28,6,7);
                    guard(0,28,0);
                }
            }
            else {
                if op == 4_u32 || op == 5_u32 {
                    guard(1,7,0);
                    var f:u32 = 5;
                    if op == 5_u32 {
                        f = 7;
                    }
                    r(1,f,5,6,7);
                }
                else {
                    if op == 9_u32 || op == 10_u32 {
                        constant(28,ty.size*8_usize);
                        guard(6,7,28);
                        var f:u32 = 1;
                        if op == 10_u32 {
                            f = 5;
                        }
                        r(0,f,5,6,7);
                    }
                    else {
                        if op == 11_u32 {
                            r(0,7,5,6,7);
                        }
                        else {
                            if op == 12_u32 {
                                r(0,6,5,6,7);
                            }
                            else {
                                if op == 13_u32 {
                                    r(0,4,5,6,7);
                                }
                                else {
                                    if op == 14_u32 || op == 15_u32 {
                                        r(0,4,5,6,7);
                                        if op == 14_u32 {
                                            i(19,3,5,5,1);
                                        }
                                        else {
                                            r(0,3,5,0,5);
                                        }
                                    }
                                    else {
                                        if op == 16_u32 || op == 19_u32 {
                                            r(0,3,5,6,7);
                                            if op == 19_u32 {
                                                i(19,4,5,5,1);
                                            }
                                        }
                                        else {
                                            r(0,3,5,7,6);
                                            if op == 17_u32 {
                                                i(19,4,5,5,1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if op <= 3_u32 && ty.size < 8_usize {
        mov(28,5);
        normalize(28,ty);
        guard(0,5,28);
    }
    if op < 14_u32 {
        normalize(5,ty);
    }
    return ();
}

fn call(item:model::Inst) -> () {
    let target:model::Decl = declaration(item.a);
    let result:model::Type = info(target.ty);
    var position:usize = 0;
    if result.size != 0_usize && !scalar(result) {
        destination(item.dst,10);
        position = 1;
    }
    unsafe {
        var p:u32 = 0;
        while p < item.c {
            let ty:model::Type = info(model::params[(target.first+p) as usize].ty);
            if ty.size != 0_usize {
                let arg:u32 = model::args[(item.b+p) as usize];
                if scalar(ty) {
                    value(arg,5);
                    extension(5,ty);
                }
                else {
                    destination(arg,5);
                }
                outgoing(position,5);
                position = position+1_usize;
            }
            p = p+1_u32;
        }
    }
    transfer(1,target.symbol,true);
    if result.size != 0_usize && scalar(result) {
        store(10,2,slot(item.dst).offset,result.size);
    }
    return ();
}

fn instruction(item:model::Inst,decl:model::Decl) -> () {
    if item.op == 1_u32 {
        constant(5,item.bits);
    }
    else {
        if item.op == 2_u32 {
            destination(item.dst,5);
            destination(item.a,6);
            copy(stype(item.dst).size);
            return ();
        }
        else {
            if item.op == 3_u32 {
                address(5,2,slot(item.a).offset+item.bits);
            }
            else {
                if item.op == 4_u32 {
                    transfer(5,item.a,false);
                }
                else {
                    if item.op == 5_u32 {
                        let ty:model::Type = stype(item.dst);
                        if scalar(ty) {
                            value(item.a,6);
                            load(5,6,0,ty.size);
                        }
                        else {
                            destination(item.dst,5);
                            value(item.a,6);
                            copy(ty.size);
                            return ();
                        }
                    }
                    else {
                        if item.op == 6_u32 {
                            let ty:model::Type = stype(item.b);
                            if scalar(ty) {
                                value(item.b,5);
                                value(item.a,6);
                                store(5,6,0,ty.size);
                            }
                            else {
                                value(item.a,5);
                                destination(item.b,6);
                                copy(ty.size);
                            }
                            return ();
                        }
                        else {
                            if item.op == 7_u32 {
                                value(item.a,6);
                                value(item.b,7);
                                r(0,0,5,6,7);
                                guard(7,5,6);
                            }
                            else {
                                if item.op == 8_u32 {
                                    binary(item);
                                }
                                else {
                                    if item.op == 9_u32 {
                                        value(item.a,5);
                                        if item.aux == 1_u32 {
                                            i(19,3,5,5,1);
                                        }
                                        if item.aux == 2_u32 {
                                            i(19,4,5,5,18446744073709551615);
                                            normalize(5,stype(item.dst));
                                        }
                                        if item.aux == 3_u32 {
                                            guard(0,5,0);
                                        }
                                    }
                                    else {
                                        if item.op == 10_u32 {
                                            value(item.a,5);
                                            normalize(5,stype(item.dst));
                                        }
                                        else {
                                            if item.op == 11_u32 {
                                                value(item.a,5);
                                            }
                                            else {
                                                if item.op == 12_u32 {
                                                    value(item.a,5);
                                                    value(item.b,6);
                                                    guard(6,5,6);
                                                    return ();
                                                }
                                                else {
                                                    if item.op == 13_u32 {
                                                        call(item);
                                                        return ();
                                                    }
                                                    else {
                                                        if item.op == 14_u32 {
                                                            mark(label(item.a));
                                                            return ();
                                                        }
                                                        else {
                                                            if item.op == 15_u32 {
                                                                transfer(0,label(item.a),true);
                                                                return ();
                                                            }
                                                            else {
                                                                if item.op == 16_u32 {
                                                                    value(item.a,5);
                                                                    branch(1,5,0,label(item.b));
                                                                    transfer(0,label(item.c),true);
                                                                    return ();
                                                                }
                                                                else {
                                                                    if item.op == 17_u32 {
                                                                        let result:model::Type = info(decl.ty);
                                                                        if result.size != 0_usize {
                                                                            if scalar(result) {
                                                                                value(item.a,10);
                                                                                extension(10,result);
                                                                            }
                                                                            else {
                                                                                unsafe {
                                                                                    load(5,2,result_pointer,8);
                                                                                }
                                                                                destination(item.a,6);
                                                                                copy(result.size);
                                                                            }
                                                                        }
                                                                        unsafe {
                                                                            mov(30,8);
                                                                            load(1,2,save,8);
                                                                            load(8,2,save+8_usize,8);
                                                                            mov(2,30);
                                                                        }
                                                                        i(103,0,0,1,0);
                                                                        return ();
                                                                    }
                                                                    else {
                                                                        panic();
                                                                        return ();
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    store(5,2,slot(item.dst).offset,stype(item.dst).size);
    return ();
}

pub fn function(id:u32) -> () {
    layouts();
    let decl:model::Decl = declaration(id);
    if decl.kind != 2_u32 {
        bad();
    }
    unsafe {
        current = id;
        if model::function_decl != id || model::parameter_slot_count != decl.count || model::inst_count == 0_u32 {
            bad();
        }
        here = model::insts[1].span;
        if model::insts[1].op != 14_u32 || model::insts[1].a != 1_u32 {
            bad();
        }
        var j:usize = 0;
        while j < 65537_usize {
            labels[j] = 0;
            label_defs[j] = 0;
            j = j+1_usize;
        }
        var outgoing:usize = 0;
        var at:u32 = 1;
        var terminated:bool = true;
        while at <= model::inst_count {
            let inst:model::Inst = model::insts[at as usize];
            here = inst.span;
            validate(inst,decl);
            if inst.op == 14_u32 {
                if !terminated || label_defs[inst.a as usize] != 0_u8 {
                    bad();
                }
                label_defs[inst.a as usize] = 1;
                terminated = false;
            }
            else {
                if terminated {
                    bad();
                }
                terminated = inst.op >= 15_u32;
            }
            if inst.op == 13_u32 {
                let amount:usize = outgoing_size(declaration(inst.a));
                if amount > outgoing {
                    outgoing = amount;
                }
            }
            at = at+1_u32;
        }
        if !terminated {
            bad();
        }
        j = 1;
        while j < 65537_usize {
            if labels[j] != 0_u32 && label_defs[j] == 0_u8 {
                bad();
            }
            j = j+1_usize;
        }
        save = outgoing;
        result_pointer = outgoing+16_usize;
        frame_size = outgoing+24_usize;
        frame_align = 16;
        at = 1;
        while at <= model::slot_count {
            let ty:model::Type = info(model::slots[at as usize].ty);
            if ty.align > frame_align {
                frame_align = ty.align;
            }
            frame_size = image::aligned(frame_size,ty.align);
            model::slots[at as usize].offset = frame_size;
            var size:usize = ty.size;
            if size == 0_usize {
                size = 1;
            }
            if size > 262144_usize || frame_size > 262144_usize-size {
                model::limit(frame_size+size,262144);
            }
            frame_size = frame_size+size;
            at = at+1_u32;
        }
        frame_size = image::aligned(frame_size,16);
        if frame_size+frame_align-16_usize > 262144_usize {
            model::limit(frame_size+frame_align-16_usize,262144);
        }
        if frame_size+frame_align-16_usize > model::max_frame {
            model::max_frame = frame_size+frame_align-16_usize;
        }
        mark(decl.symbol);
        mov(30,2);
        constant(31,frame_size);
        r(32,0,2,2,31);
        if frame_align > 16_usize {
            constant(31,0_usize-%frame_align);
            r(0,7,2,2,31);
        }
        store(1,2,save,8);
        store(8,2,save+8_usize,8);
        mov(8,30);
        let result:model::Type = info(decl.ty);
        var position:usize = 0;
        if result.size != 0_usize && !scalar(result) {
            store(10,2,result_pointer,8);
            position = 1;
        }
        var p:u32 = 0;
        while p < decl.count {
            let arg:u32 = model::parameter_slots[(p+1_u32) as usize];
            let param:model::Param = model::params[(decl.first+p) as usize];
            if slot(arg).ty != param.ty {
                bad();
            }
            var prior:u32 = 0;
            while prior < p {
                if model::parameter_slots[(prior+1_u32) as usize] == arg {
                    bad();
                }
                prior = prior+1_u32;
            }
            let ty:model::Type = info(param.ty);
            if ty.size != 0_usize {
                if scalar(ty) {
                    incoming(position,5);
                    store(5,2,slot(arg).offset,ty.size);
                }
                else {
                    incoming(position,6);
                    destination(arg,5);
                    copy(ty.size);
                }
                position = position+1_usize;
            }
            p = p+1_u32;
        }
        at = 1;
        while at <= model::inst_count {
            instruction(model::insts[at as usize],decl);
            at = at+1_u32;
        }
    }
    return ();
}

pub fn start(entry:u32) -> u32 {
    let first:u32 = image::fresh();
    mark(first);
    mov(27,2);
    transfer(1,entry,true);
    constant(17,93);
    image::word(115);
    image::word(3221229683);
    unsafe {
        panic_symbol = image::fresh();
        mark(panic_symbol);
    }
    constant(10,101);
    constant(17,93);
    image::word(115);
    image::word(3221229683);
    unsafe {
        copy_symbol = image::fresh();
        mark(copy_symbol);
    }
    copy_body();
    return first;
}
