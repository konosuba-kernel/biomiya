module bootstrap::types;
import bootstrap::model;
import bootstrap::rules;
import bootstrap::lex;
pub static mut token:model::Token = model::Token {
    kind:model::TOKEN_EOF,
    file:0,
    start:0,
    end:0,
    number:0,
    suffix:0
};
// Scanner cursor and diagnostic provenance are separate small state. Scanning
// owns token; AST/checker operations may update diagnostic without moving it.
pub static mut diagnostic:model::Span = model::Span {
    file:0,
    start:0,
    end:0
};
// Compilation-lifetime header/name/preparation tables; never copied by value.
static mut headers:[8193]u32 = [0;8193];
static mut ends:[8193]u32 = [0;8193];
static mut fullnames:[8193]u32 = [0;8193];
static mut preparing:[8193]u32 = [0;8193];
static mut prepare_depth:u32 = 0;
static mut type_depth:u32 = 0;
static mut constant_depth:u32 = 0;
pub static mut value_names:[8193]u32 = [0;8193];
pub static mut value_name_count:u32 = 0;

pub struct Constant {
    pub bits:usize,
    pub ty:u32
}

pub fn span() -> model::Span {
    unsafe {
        return model::Span {
            file:token.file,
            start:token.start,
            end:token.end
        };
    }
}

pub fn fail(code:u32) -> () {
    unsafe {
        model::fail(code, diagnostic.file, diagnostic.start as usize);
    }
    return ();
}

pub fn locate(location:model::Span) -> () {
    unsafe {
        diagnostic = location;
    }
    return ();
}

pub fn limit(actual:usize, capacity:usize) -> () {
    unsafe {
        model::limit_at(actual, capacity, diagnostic.file, diagnostic.start as usize);
    }
    return ();
}

pub fn at(word:[]const u8) -> bool {
    unsafe {
        return lex::is(token, word);
    }
}

pub fn advance() -> () {
    unsafe {
        token = lex::next(token.file, token.end as usize);
        diagnostic = span();
    }
    return ();
}

pub fn seek(file:u32, offset:u32) -> () {
    unsafe {
        token = lex::next(file, offset as usize);
        diagnostic = span();
    }
    return ();
}

pub fn eat(word:[]const u8) -> bool {
    if at(word) {
        advance();
        return true;
    }
    return false;
}

pub fn need(word:[]const u8) -> () {
    if !eat(word) {
        fail(model::ERROR_PARSE);
    }
    return ();
}

pub fn text(id:u32) -> []const u8 {
    unsafe {
        if id == 0_u32 || id > model::name_count {
            fail(model::ERROR_INTERNAL);
        }
        return model::names[id as usize].bytes;
    }
}

pub fn ident() -> u32 {
    unsafe {
        if token.kind != model::TOKEN_IDENT {
            fail(model::ERROR_PARSE);
        }
        let word:[]const u8 = lex::bytes(token);
        if model::equal(word, "fn") || model::equal(word, "struct") || model::equal(word, "module") || model::equal(word, "let") || model::equal(word, "var") || model::equal(word, "return") || model::equal(word, "unsafe") || model::equal(word, "true") || model::equal(word, "false") || model::equal(word, "static") || model::equal(word, "const") || model::equal(word, "pub") || model::equal(word, "if") || model::equal(word, "else") || model::equal(word, "while") || model::equal(word, "loop") || model::equal(word, "match") || model::equal(word, "break") || model::equal(word, "continue") || model::equal(word, "defer") || model::equal(word, "extern") || model::equal(word, "import") || model::equal(word, "null") || model::equal(word, "as") || model::equal(word, "_") {
            fail(model::ERROR_PARSE);
        }
        let id:u32 = model::name(word);
        advance();
        return id;
    }
}

pub fn join(a:[]const u8, b:[]const u8) -> u32 {
    if a.len == 0_usize {
        return model::name(b);
    }
    var buffer:[1024]u8 = [0;1024];
    if a.len+b.len+2_usize > 1024_usize {
        model::limit(a.len+b.len+2_usize, 1024);
    }
    unsafe {
        var i:usize = 0;
        while i < a.len {
            buffer[i] = a[i];
            i = i+1_usize;
        }
        buffer[i] = 58;
        buffer[i+1_usize] = 58;
        i = i+2_usize;
        var j:usize = 0;
        while j < b.len {
            buffer[i+j] = b[j];
            j = j+1_usize;
        }
        return model::name(core::slice_from_raw_parts(core::slice_of(buffer).data, i+j));
    }
}

pub fn view(bytes:[]const u8, start:usize, end:usize) -> []const u8 {
    if start > end || end > bytes.len {
        fail(model::ERROR_INTERNAL);
    }
    unsafe {
        return core::slice_from_raw_parts(core::ptr_add(bytes.data, start), end-start);
    }
}

pub fn path() -> u32 {
    var id:u32 = ident();
    while at("::") {
        unsafe {
            let next:model::Token = lex::next(token.file, token.end as usize);
            if lex::is(next, "<") {
                return id;
            }
        }
        advance();
        let part:u32 = ident();
        id = join(text(id), text(part));
    }
    return id;
}

pub fn close_gt() -> () {
    if eat(">") {
        return ();
    }
    if at(">>") || at(">=") || at(">>=") {
        unsafe {
            token.start = token.start+1_u32;
            diagnostic = span();
        }
        return ();
    }
    fail(model::ERROR_PARSE);
    return ();
}

pub fn find(module_id:u32, name:u32) -> u32 {
    unsafe {
        var i:u32 = 1;
        while i <= model::decl_count {
            let d:model::Decl = model::decls[i as usize];
            if d.module_id == module_id && d.name == name {
                return i;
            }
            i = i+1_u32;
        }
    }
    return 0;
}

pub fn resolve(file:u32, name:u32, public_use:bool) -> u32 {
    let raw:[]const u8 = text(name);
    unsafe {
        let source:model::Source = model::sources[file as usize];
        var full:u32 = join(text(source.module_id), raw);
        if raw.len > 6_usize && model::equal(view(raw, 0, 6), "root::") {
            full = model::name(view(raw, 6, raw.len));
        } else {
            var split:usize = 0;
            while split+1_usize < raw.len && !(raw[split] == 58_u8 && raw[split+1_usize] == 58_u8) {
                split = split+1_usize;
            }
            if split+1_usize < raw.len {
                let head:u32 = model::name(view(raw, 0, split));
                var k:u32 = 1;
                while k <= model::import_count {
                    let imp:model::Import = model::imports[k as usize];
                    if model::sources[imp.file as usize].module_id == source.module_id && imp.alias == head {
                        full = join(text(imp.module_id), view(raw, split+2_usize, raw.len));
                    }
                    k = k+1_u32;
                }
            }
        }
        var i:u32 = 1;
        while i <= model::decl_count {
            let d:model::Decl = model::decls[i as usize];
            if fullnames[i as usize] == full {
                if (d.flags & model::FLAG_PUBLIC) == 0_u32 && (d.module_id != source.module_id || public_use) {
                    fail(model::ERROR_NAME);
                }
                return i;
            }
            i = i+1_u32;
        }
    }
    return 0;
}

pub fn info(id:u32) -> model::Type {
    unsafe {
        if id == 0_u32 || id > model::type_count {
            fail(model::ERROR_INTERNAL);
        }
        return model::types[id as usize];
    }
}

fn size_add(value:usize, extra:usize) -> usize {
    let result:rules::SizeRule = rules::add_size(value, extra);
    if !result.ok {
        limit(extra, 0xffffffffffffffff_usize-value);
    }
    return result.size;
}

pub fn align(value:usize, alignment:usize) -> usize {
    if alignment == 0_usize || (alignment&(alignment-1_usize)) != 0_usize {
        fail(model::ERROR_INTERNAL);
    }
    let result:rules::SizeRule = rules::align_up(value, alignment);
    if !result.ok {
        limit(alignment-1_usize, 0xffffffffffffffff_usize-value);
    }
    return result.size;
}

pub fn intern(kind:u32, a:u32, b:u32, flags:u32) -> u32 {
    unsafe {
        var i:u32 = 1;
        while i <= model::type_count {
            let t:model::Type = model::types[i as usize];
            if t.kind == kind && t.a == a && t.b == b && t.flags == flags {
                return i;
            }
            i = i+1_u32;
        }
        var size:usize = 8;
        var alignment:usize = 8;
        var payload:u32 = 0;
        if kind == model::TYPE_ARRAY {
            layout(a);
            let t:model::Type = info(a);
            if t.size != 0_usize && (b as usize) > 67108864_usize/t.size {
                limit(b as usize, 67108864_usize/t.size);
            }
            size = t.size*(b as usize);
            alignment = t.align;
        }
        if kind == model::TYPE_SLICE {
            size = 16;
        }
        if kind == model::TYPE_RESULT {
            layout(a);
            layout(b);
            let ta:model::Type = info(a);
            let tb:model::Type = info(b);
            alignment = ta.align;
            if tb.align > alignment {
                alignment = tb.align;
            }
            if alignment < 4_usize {
                alignment = 4;
            }
            let off:usize = align(4, alignment);
            payload = off as u32;
            var body:usize = ta.size;
            if tb.size > body {
                body = tb.size;
            }
            size = align(size_add(off, body), alignment);
        }
        return model::add_type(model::Type {
            kind:kind,
            a:a,
            b:b,
            flags:flags,
            size:size,
            align:alignment,
            first:payload,
            count:0
        });
    }
}

pub fn pointer(target:u32, const_:bool) -> u32 {
    var flag:u32 = 0;
    if const_ {
        flag = model::TYPE_CONST;
    }
    return intern(model::TYPE_POINTER, target, 0, flag);
}

pub fn scalar(ty:u32) -> bool {
    let kind:u32 = info(ty).kind;
    return kind <= model::TYPE_POINTER;
}

pub fn integer(ty:u32) -> bool {
    return rules::integer(info(ty).kind);
}

pub fn max(ty:u32) -> usize {
    return rules::max(info(ty).kind);
}

fn scalar_value(result:rules::ScalarRule) -> usize {
    if !result.ok {
        fail(model::ERROR_TYPE);
    }
    return result.bits;
}

pub fn literal(bits:usize, ty:u32) -> usize {
    if ty == model::TYPE_INVALID {
        fail(model::ERROR_TYPE);
    }
    return scalar_value(rules::literal(bits, info(ty).kind));
}

pub fn unary(op:u32, value:Constant) -> Constant {
    return Constant {
        bits:scalar_value(rules::unary(op, value.bits, info(value.ty).kind)),
        ty:value.ty
    };
}

pub fn cast(value:Constant, ty:u32) -> Constant {
    return Constant {
        bits:scalar_value(rules::cast(value.bits, info(value.ty).kind, info(ty).kind)),
        ty:ty
    };
}

pub fn type_expr(public_use:bool) -> u32 {
    unsafe {
        if type_depth >= 64_u32 {
            limit((type_depth as usize)+1_usize, 64);
        }
        type_depth = type_depth+1_u32;
    }
    let result:u32 = type_inner(public_use);
    unsafe {
        type_depth = type_depth-1_u32;
    }
    return result;
}

fn type_inner(public_use:bool) -> u32 {
    if eat("(") {
        need(")");
        return model::TYPE_UNIT;
    }
    if eat("*") {
        if at("user") || at("phys") || at("mmio") {
            fail(model::ERROR_UNSUPPORTED);
        }
        let ignored:bool = eat("kernel");
        let const_:bool = eat("const");
        return pointer(type_expr(public_use), const_);
    }
    if eat("[") {
        if eat("]") {
            var flags:u32 = 0;
            if eat("const") {
                flags = model::TYPE_CONST;
            }
            return intern(model::TYPE_SLICE, type_expr(public_use), 0, flags);
        }
        let length:Constant = constant(0, model::TYPE_USIZE);
        need("]");
        if !integer(length.ty) {
            fail(model::ERROR_TYPE);
        }
        if length.bits > 4294967295_usize {
            unsafe {
                limit(length.bits, 4294967295);
            }
        }
        return intern(model::TYPE_ARRAY, type_expr(public_use), length.bits as u32, 0);
    }
    if at("fn") || at("unsafe") || at("extern") || at("!") || at("Option") {
        fail(model::ERROR_UNSUPPORTED);
    }
    let name:u32 = path();
    if shadowed(name) {
        fail(model::ERROR_TYPE);
    }
    let word:[]const u8 = text(name);
    if model::equal(word, "bool") {
        return model::TYPE_BOOL;
    }
    if model::equal(word, "u8") {
        return model::TYPE_U8;
    }
    if model::equal(word, "u32") {
        return model::TYPE_U32;
    }
    if model::equal(word, "usize") {
        return model::TYPE_USIZE;
    }
    if model::equal(word, "u16") || model::equal(word, "u64") || model::equal(word, "isize") || model::equal(word, "i32") {
        fail(model::ERROR_UNSUPPORTED);
    }
    if model::equal(word, "Result") && eat("<") {
        let a:u32 = type_expr(public_use);
        need(",");
        let b:u32 = type_expr(public_use);
        close_gt();
        return intern(model::TYPE_RESULT, a, b, 0);
    }
    unsafe {
        let d:u32 = resolve(token.file, name, public_use);
        if d == 0_u32 {
            fail(model::ERROR_NAME);
        }
        if model::decls[d as usize].kind != model::DECL_STRUCT {
            fail(model::ERROR_TYPE);
        }
        return model::decls[d as usize].ty;
    }
}

pub fn precedence() -> u32 {
    if at("||") {
        return 1;
    }
    if at("&&") {
        return 2;
    }
    if at("==") || at("!=") {
        return 3;
    }
    if at("<") || at("<=") || at(">") || at(">=") {
        return 4;
    }
    if at("|") {
        return 5;
    }
    if at("^") {
        return 6;
    }
    if at("&") {
        return 7;
    }
    if at("<<") || at(">>") {
        return 8;
    }
    if at("+") || at("-") || at("+%") || at("-%") {
        return 9;
    }
    if at("*") || at("/") || at("%") || at("*%") {
        return 10;
    }
    return 0;
}

pub fn binop() -> u32 {
    if at("+") {
        return model::BIN_ADD;
    }
    if at("-") {
        return model::BIN_SUB;
    }
    if at("*") {
        return model::BIN_MUL;
    }
    if at("/") {
        return model::BIN_DIV;
    }
    if at("%") {
        return model::BIN_REM;
    }
    if at("+%") {
        return model::BIN_WRAP_ADD;
    }
    if at("-%") {
        return model::BIN_WRAP_SUB;
    }
    if at("*%") {
        return model::BIN_WRAP_MUL;
    }
    if at("<<") {
        return model::BIN_SHL;
    }
    if at(">>") {
        return model::BIN_SHR;
    }
    if at("&") {
        return model::BIN_BIT_AND;
    }
    if at("|") {
        return model::BIN_BIT_OR;
    }
    if at("^") {
        return model::BIN_BIT_XOR;
    }
    if at("==") {
        return model::BIN_EQ;
    }
    if at("!=") {
        return model::BIN_NE;
    }
    if at("<") {
        return model::BIN_LT;
    }
    if at("<=") {
        return model::BIN_LE;
    }
    if at(">") {
        return model::BIN_GT;
    }
    if at(">=") {
        return model::BIN_GE;
    }
    if at("&&") {
        return model::BIN_AND;
    }
    if at("||") {
        return model::BIN_OR;
    }
    fail(model::ERROR_PARSE);
    return model::BIN_INVALID;
}

pub fn apply(op:u32, a:usize, b:usize, ty:u32) -> usize {
    return scalar_value(rules::binary(op, a, b, info(ty).kind));
}

pub fn constant(minimum:u32, expected:u32) -> Constant {
    unsafe {
        if constant_depth >= 64_u32 {
            limit((constant_depth as usize)+1_usize, 64);
        }
        constant_depth = constant_depth+1_u32;
    }
    let result:Constant = constant_inner(minimum, expected);
    unsafe {
        constant_depth = constant_depth-1_u32;
    }
    return result;
}

fn constant_inner(minimum:u32, expected:u32) -> Constant {
    var value:Constant = Constant {
        bits:0,
        ty:expected
    };
    unsafe {
        if token.kind == model::TOKEN_NUMBER {
            value.bits = token.number;
            value.ty = token.suffix;
            if value.ty == model::TYPE_INVALID {
                value.ty = expected;
            }
            if value.ty == model::TYPE_INVALID {
                value.ty = model::TYPE_USIZE;
            }
            value.bits = literal(value.bits, value.ty);
            advance();
        } else if eat("true") {
            value.bits = 1;
            value.ty = model::TYPE_BOOL;
        } else if eat("false") {
            value.bits = 0;
            value.ty = model::TYPE_BOOL;
        } else if eat("(") {
            value = constant(0, expected);
            need(")");
        } else if at("sizeof") || at("alignof") {
            let size:bool = at("sizeof");
            advance();
            need("(");
            let ty:u32 = type_expr(false);
            need(")");
            layout(ty);
            value.ty = model::TYPE_USIZE;
            value.bits = info(ty).align;
            if size {
                value.bits = info(ty).size;
            }
        } else if at("~") || at("!") || at("-") {
            let logical:bool = at("!");
            let negative:bool = at("-");
            advance();
            value = constant(11, expected);
            var op:u32 = model::UNARY_BIT_NOT;
            if logical {
                op = model::UNARY_NOT;
            }
            if negative {
                op = model::UNARY_NEG;
            }
            value = unary(op, value);
        } else {
            let name:u32 = path();
            if shadowed(name) {
                fail(model::ERROR_TYPE);
            }
            let id:u32 = resolve(token.file, name, false);
            if id == 0_u32 {
                fail(model::ERROR_NAME);
            }
            if model::decls[id as usize].kind != model::DECL_CONST {
                fail(model::ERROR_TYPE);
            }
            prepare(id);
            let d:model::Decl = model::decls[id as usize];
            value.bits = d.bits;
            value.ty = d.ty;
        }

        loop {
            if minimum <= 11_u32 && eat("as") {
                let ty:u32 = type_expr(false);
                value = cast(value, ty);
                continue;
            }
            let power:u32 = precedence();
            if power == 0_u32 || power < minimum {
                break;
            }
            let op:u32 = binop();
            advance();
            let right:Constant = constant(power+1_u32, value.ty);
            if right.ty != value.ty {
                fail(model::ERROR_TYPE);
            }
            value.bits = apply(op, value.bits, right.bits, value.ty);
            if op >= model::BIN_EQ {
                value.ty = model::TYPE_BOOL;
            }
        }
    }
    return value;
}

pub fn layout(ty:u32) -> () {
    let t:model::Type = info(ty);
    if t.align != 0_usize {
        return ();
    }
    unsafe {
        var id:u32 = 1;
        while id <= model::decl_count {
            if model::decls[id as usize].kind == model::DECL_STRUCT && model::decls[id as usize].ty == ty {
                prepare(id);
                return ();
            }
            id = id+1_u32;
        }
    }
    fail(model::ERROR_INTERNAL);
    return ();
}

pub fn prepare(id:u32) -> () {
    unsafe {
        if id == 0_u32 || id > model::decl_count {
            fail(model::ERROR_INTERNAL);
        }
        if preparing[id as usize] == 2_u32 {
            return ();
        }
        if preparing[id as usize] == 1_u32 {
            fail(model::ERROR_TYPE);
        }
        if prepare_depth >= 32_u32 {
            limit((prepare_depth as usize)+1_usize, 32);
        }
        prepare_depth = prepare_depth+1_u32;
        preparing[id as usize] = 1;
        let saved:model::Token = token;
        let saved_diagnostic:model::Span = diagnostic;
        var d:model::Decl = model::decls[id as usize];
        seek(d.file, headers[id as usize]);
        if d.kind == model::DECL_STRUCT {
            need("{");
            // Nested layout resolution may append other fields, so collect locally first.
            var fields:[256]model::Field = [model::Field {
                name:0,
                ty:0,
                flags:0,
                offset:0,
                span:model::Span {
                    file:0,
                    start:0,
                    end:0
                }
            };256];
            var count:u32 = 0;
            var size:usize = 0;
            var alignment:usize = 1;
            while !eat("}") {
                var flags:u32 = 0;
                if eat("pub") {
                    flags = model::FLAG_PUBLIC;
                }
                if (d.flags&model::FLAG_PUBLIC) != 0_u32 && flags == 0_u32 {
                    fail(model::ERROR_UNSUPPORTED);
                }
                let sp:model::Span = span();
                let name:u32 = ident();
                need(":");
                let ty:u32 = type_expr((d.flags&model::FLAG_PUBLIC) != 0_u32);
                var j:u32 = 0;
                while j < count {
                    if fields[j as usize].name == name {
                        fail(model::ERROR_NAME);
                    }
                    j = j+1_u32;
                }
                layout(ty);
                let t:model::Type = info(ty);
                size = align(size, t.align);
                if count >= 256_u32 {
                    model::limit((count as usize)+1_usize, 256);
                }
                fields[count as usize] = model::Field {
                    name:name,
                    ty:ty,
                    flags:flags,
                    offset:size,
                    span:sp
                };
                count = count+1_u32;
                size = size_add(size, t.size);
                if t.align > alignment {
                    alignment = t.align;
                }
                if !eat(",") {
                    need("}");
                    break;
                }
            }
            let first:u32 = model::field_count+1_u32;
            var k:u32 = 0;
            while k < count {
                let ignored:u32 = model::add_field(fields[k as usize]);
                k = k+1_u32;
            }
            model::types[d.ty as usize] = model::Type {
                kind:model::TYPE_STRUCT,
                a:id,
                b:0,
                flags:0,
                size:align(size, alignment),
                align:alignment,
                first:first,
                count:count
            };
        } else if d.kind == model::DECL_FUNCTION || d.kind == model::DECL_EXTERN {
            need("(");
            d.first = model::param_count+1_u32;
            d.count = 0;
            while !eat(")") {
                let sp:model::Span = span();
                let name:u32 = ident();
                need(":");
                let ty:u32 = type_expr((d.flags&model::FLAG_PUBLIC) != 0_u32);
                layout(ty);
                var k:u32 = 0;
                while k < d.count {
                    if model::params[(d.first+k) as usize].name == name {
                        fail(model::ERROR_NAME);
                    }
                    k = k+1_u32;
                }
                if d.kind == model::DECL_EXTERN && (!scalar(ty) || ty == model::TYPE_UNIT) {
                    fail(model::ERROR_UNSUPPORTED);
                }
                let ignored:u32 = model::add_param(model::Param {
                    name:name,
                    ty:ty,
                    span:sp
                });
                d.count = d.count+1_u32;
                if d.count > 256_u32 {
                    model::limit(d.count as usize, 256);
                }
                if !eat(",") {
                    need(")");
                    break;
                }
            }
            need("->");
            d.ty = type_expr((d.flags&model::FLAG_PUBLIC) != 0_u32);
            layout(d.ty);
            if d.kind == model::DECL_EXTERN && !scalar(d.ty) {
                fail(model::ERROR_UNSUPPORTED);
            }
            if d.kind == model::DECL_EXTERN {
                need(";");
            } else {
                d.start = token.start;
                if !at("{") {
                    fail(model::ERROR_PARSE);
                }
            }
        } else {
            need(":");
            d.ty = type_expr((d.flags&model::FLAG_PUBLIC) != 0_u32);
            layout(d.ty);
            need("=");
            d.init_start = token.start;
            if d.kind == model::DECL_CONST {
                if !scalar(d.ty) || d.ty == model::TYPE_UNIT || info(d.ty).kind == model::TYPE_POINTER {
                    fail(model::ERROR_UNSUPPORTED);
                }
                let value:Constant = constant(0, d.ty);
                if value.ty != d.ty {
                    fail(model::ERROR_TYPE);
                }
                d.bits = value.bits;
                need(";");
            }
            d.init_end = ends[id as usize];
        }

        d.state = 2;
        model::decls[id as usize] = d;
        preparing[id as usize] = 2;
        token = saved;
        diagnostic = saved_diagnostic;
        prepare_depth = prepare_depth-1_u32;
    }
    return ();
}

pub fn headers_collect() -> () {
    unsafe {
        value_name_count = 0;
        var file:u32 = 1;
        while file <= model::source_count {
            seek(file, 0);
            var module_id:u32 = model::name("");
            if eat("module") {
                module_id = path();
                need(";");
            }
            if prefix(text(module_id), "core") || prefix(text(module_id), "root") {
                fail(model::ERROR_NAME);
            }
            var src:model::Source = model::sources[file as usize];
            src.module_id = module_id;
            src.import_first = model::import_count+1_u32;
            src.import_count = 0;
            while eat("import") {
                let sp:model::Span = span();
                var name:u32 = path();
                var raw:[]const u8 = text(name);
                if raw.len > 6_usize && model::equal(view(raw, 0, 6), "root::") {
                    name = model::name(view(raw, 6, raw.len));
                    raw = text(name);
                }
                var cut:usize = 0;
                var p:usize = 0;
                while p+1_usize < raw.len {
                    if raw[p] == 58_u8 && raw[p+1_usize] == 58_u8 {
                        cut = p+2_usize;
                    }
                    p = p+1_usize;
                }
                let alias:u32 = model::name(view(raw, cut, raw.len));
                var k:u32 = 0;
                while k < src.import_count {
                    if model::imports[(src.import_first+k) as usize].alias == alias {
                        fail(model::ERROR_NAME);
                    }
                    k = k+1_u32;
                }
                let ignored:u32 = model::add_import(model::Import {
                    file:file,
                    module_id:name,
                    alias:alias,
                    span:sp
                });
                src.import_count = src.import_count+1_u32;
                need(";");
            }
            model::sources[file as usize] = src;
            while token.kind != model::TOKEN_EOF {
                var flags:u32 = 0;
                if eat("pub") {
                    flags = model::FLAG_PUBLIC;
                }
                var kind:u32 = 0;
                if eat("struct") {
                    kind = model::DECL_STRUCT;
                } else if eat("const") {
                    kind = model::DECL_CONST;
                } else if eat("static") {
                    kind = model::DECL_STATIC;
                    if eat("mut") {
                        flags = flags|model::FLAG_MUTABLE;
                    }
                } else {
                    if at("enum") || at("type") || at("impl") || at("resource") {
                        fail(model::ERROR_UNSUPPORTED);
                    }
                    kind = model::DECL_FUNCTION;
                    if eat("extern") {
                        kind = model::DECL_EXTERN;
                        need("abi");
                        need("(");
                        need("C");
                        need(")");
                        flags = flags|model::FLAG_UNSAFE;
                    }
                    if eat("unsafe") {
                        flags = flags|model::FLAG_UNSAFE;
                    }
                    need("fn");
                }

                let name:u32 = ident();
                if model::equal(text(name), "core") || model::equal(text(name), "root") || find(module_id, name) != 0_u32 {
                    fail(model::ERROR_NAME);
                }
                var k:u32 = 0;
                while k < src.import_count {
                    if model::imports[(src.import_first+k) as usize].alias == name {
                        fail(model::ERROR_NAME);
                    }
                    k = k+1_u32;
                }
                let head:u32 = token.start;
                var symbol:u32 = 0;
                var ty:u32 = 0;
                if kind == model::DECL_STRUCT {
                    ty = model::add_type(model::Type {
                        kind:model::TYPE_STRUCT,
                        a:0,
                        b:0,
                        flags:0,
                        size:0,
                        align:0,
                        first:0,
                        count:0
                    });
                }
                if kind == model::DECL_FUNCTION {
                    symbol = model::symbol(0, model::SYMBOL_FUNCTION);
                }
                if kind == model::DECL_EXTERN {
                    symbol = model::symbol(name, model::SYMBOL_FUNCTION);
                }
                if kind == model::DECL_STATIC {
                    symbol = model::symbol(0, model::SYMBOL_DATA);
                }
                var depth:u32 = 0;
                var bracket:u32 = 0;
                var paren:u32 = 0;
                loop {
                    if token.kind == model::TOKEN_EOF {
                        fail(model::ERROR_PARSE);
                    }
                    if at("{") {
                        depth = depth+1_u32;
                    }
                    if at("}") {
                        if depth == 0_u32 {
                            fail(model::ERROR_PARSE);
                        }
                        depth = depth-1_u32;
                        if depth == 0_u32 && (kind == model::DECL_STRUCT || kind == model::DECL_FUNCTION) {
                            advance();
                            break;
                        }
                    }
                    if at("[") {
                        bracket = bracket+1_u32;
                    }
                    if at("]") {
                        if bracket == 0_u32 {
                            fail(model::ERROR_PARSE);
                        }
                        bracket = bracket-1_u32;
                    }
                    if at("(") {
                        paren = paren+1_u32;
                    }
                    if at(")") {
                        if paren == 0_u32 {
                            fail(model::ERROR_PARSE);
                        }
                        paren = paren-1_u32;
                    }
                    if at(";") && depth == 0_u32 && bracket == 0_u32 && paren == 0_u32 {
                        advance();
                        break;
                    }
                    advance();
                }
                let id:u32 = model::add_decl(model::Decl {
                    kind:kind,
                    name:name,
                    module_id:module_id,
                    file:file,
                    flags:flags,
                    ty:ty,
                    first:0,
                    count:0,
                    start:head,
                    end:token.start,
                    init_start:0,
                    init_end:0,
                    symbol:symbol,
                    bits:0,
                    state:0
                });
                fullnames[id as usize] = join(text(module_id), text(name));
                headers[id as usize] = head;
                ends[id as usize] = token.start;
                preparing[id as usize] = 0;
            }
            file = file+1_u32;
        }
        var declared:u32 = 1;
        while declared <= model::decl_count {
            let d:model::Decl = model::decls[declared as usize];
            if has_module(join(text(d.module_id), text(d.name))) {
                model::fail(model::ERROR_NAME, d.file, headers[declared as usize] as usize);
            }
            declared = declared+1_u32;
        }
        var imp:u32 = 1;
        while imp <= model::import_count {
            let item:model::Import = model::imports[imp as usize];
            let owner:u32 = model::sources[item.file as usize].module_id;
            let sp:model::Span = item.span;
            if !has_module(item.module_id) || model::equal(text(item.alias), "core") || model::equal(text(item.alias), "root") || find(owner, item.alias) != 0_u32 || has_module(join(text(owner), text(item.alias))) {
                model::fail(model::ERROR_NAME, sp.file, sp.start as usize);
            }
            var previous:u32 = 1;
            while previous < imp {
                let old:model::Import = model::imports[previous as usize];
                if model::sources[old.file as usize].module_id == owner && old.alias == item.alias {
                    model::fail(model::ERROR_NAME, sp.file, sp.start as usize);
                }
                previous = previous+1_u32;
            }
            imp = imp+1_u32;
        }
        var id:u32 = 1;
        while id <= model::decl_count {
            prepare(id);
            id = id+1_u32;
        }
    }
    return ();
}

fn prefix(full:[]const u8, part:[]const u8) -> bool {
    if full.len < part.len || !model::equal(view(full, 0, part.len), part) {
        return false;
    }
    if full.len == part.len {
        return true;
    }
    unsafe {
        return full.len >= part.len+2_usize && full[part.len] == 58_u8 && full[part.len+1_usize] == 58_u8;
    }
}

fn has_module(name:u32) -> bool {
    unsafe {
        var i:u32 = 1;
        while i <= model::source_count {
            if prefix(text(model::sources[i as usize].module_id), text(name)) {
                return true;
            }
            i = i+1_u32;
        }
    }
    return false;
}

pub fn shadowed(name:u32) -> bool {
    unsafe {
        var i:u32 = value_name_count;
        while i != 0_u32 {
            if value_names[i as usize] == name {
                return true;
            }
            i = i-1_u32;
        }
    }
    return false;
}

pub fn value_name(name:u32) -> () {
    unsafe {
        if value_name_count >= 8192_u32 {
            limit((value_name_count as usize)+1_usize, 8192);
        }
        value_name_count = value_name_count+1_u32;
        value_names[value_name_count as usize] = name;
    }
    return ();
}
