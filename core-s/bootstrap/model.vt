        if fixup_count >= 65536_u32 { limit((fixup_count as usize)+1_usize,65536); }
        fixup_count = fixup_count+1_u32;
        fixups[fixup_count as usize] = value;
        return fixup_count;
    }
}

pub fn add_arg(value:u32) -> u32 {
    unsafe {
        if arg_count >= 65536_u32 { limit((arg_count as usize)+1_usize,65536); }
        arg_count = arg_count+1_u32; args[arg_count as usize] = value; return arg_count;
    }
}
pub fn add_parameter_slot(value:u32) -> () {
    unsafe {
        if parameter_slot_count >= 256_u32 { limit((parameter_slot_count as usize)+1_usize,256); }
        parameter_slot_count = parameter_slot_count+1_u32;
        parameter_slots[parameter_slot_count as usize] = value;
    }
    return ();
}
pub fn data_byte(value:u8) -> () {
    unsafe {
        if data_byte_count >= 8388608_usize { limit(data_byte_count+1_usize,8388608); }
        data_bytes[data_byte_count] = value; data_byte_count = data_byte_count+1_usize;
    }
    return ();
}
pub fn equal(a:[]const u8,b:[]const u8) -> bool {
    if a.len != b.len { return false; }
    var i:usize = 0;
    while i < a.len { unsafe { if a[i] != b[i] { return false; } } i = i+1_usize; }
    return true;
}
pub fn name(text:[]const u8) -> u32 {
    var hash:usize = 2166136261;
    var i:usize = 0;
    unsafe {
        while i < text.len { hash = (hash ^ (text[i] as usize))*%16777619_usize; i = i+1_usize; }
        var id:u32 = 1;
        while id <= name_count {
            let item:Name = names[id as usize];
            if item.hash == hash && equal(item.bytes,text) { return id; }
            id = id+1_u32;
        }
        if text.len > 2097152_usize-name_byte_count { limit(name_byte_count+text.len,2097152); }
        let start:usize = name_byte_count;
        i = 0;
        while i < text.len { name_bytes[name_byte_count] = text[i]; name_byte_count = name_byte_count+1_usize; i = i+1_usize; }
        let saved:[]const u8 = core::slice_from_raw_parts(core::ptr_add(core::slice_of(name_bytes).data,start),text.len);
        return add_name(Name { bytes:saved,hash:hash });
    }
}
pub fn symbol(name_id:u32,kind:u32) -> u32 {
    unsafe {
        if name_id != 0_u32 {
            var i:u32 = 1;
            while i <= symbol_count {
                if symbols[i as usize].name == name_id {
                    if symbols[i as usize].kind != 0_u32 && kind != 0_u32 && symbols[i as usize].kind != kind { fail(9,0,0); }
                    if symbols[i as usize].kind == 0_u32 { symbols[i as usize].kind = kind; }
                    return i;
                }
                i = i+1_u32;
            }
        }
        return add_symbol(Symbol { name:name_id,region:0,offset:0,size:0,align:1,defined:0,kind:kind });
    }
}
pub fn reset_function() -> () {
    unsafe {
        if (inst_count as usize) > max_ir { max_ir = inst_count as usize; }
        slot_count = 0; inst_count = 0; arg_count = 0; parameter_slot_count = 0; function_decl = 0;
    }
    return ();
}
pub fn reset_all() -> () {
    unsafe {
        source_count = 0; assembly_count = 0; name_count = 0; name_byte_count = 0;
        import_count = 0; type_count = 0; field_count = 0; decl_count = 0; param_count = 0;
        data_count = 0; data_relocation_count = 0; symbol_count = 0; fixup_count = 0; data_byte_count = 0;
        max_ast = 0; max_ir = 0; max_frame = 0; source_bytes = 0;
        error_code = 0; error_file = 0; error_offset = 0;
        reset_function(); max_ir = 0;
        var kind:u32 = 1;
        while kind <= 5_u32 {
            var size:usize = 1;
            if kind == 1_u32 { size = 0; }
            if kind == 4_u32 { size = 4; }
            if kind == 5_u32 { size = 8; }
            var alignment:usize = size;
            if alignment == 0_usize { alignment = 1; }
            let id:u32 = add_type(Type { kind:kind,a:0,b:0,flags:0,size:size,align:alignment,first:0,count:0 });
            kind = kind+1_u32;
        }
    }
    return ();
}
