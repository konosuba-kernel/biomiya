struct Pattern {
    key:usize,
    binding:model::NameId,
    payload:model::TypeId,
    offset:usize,
    wildcard:bool
}

fn checked_pattern(node:parse::NodeId, ty:model::TypeId) -> Pattern {
    location(node);
    let n:parse::Node = parse::get(node);
    let t:model::Type = types::info(ty);
    var result:Pattern = make Pattern {
        key:0,
        binding:model::no_name(),
        payload:model::no_type(),
        offset:0,
        wildcard:false
    };
    match n.syntax {
        parse::Syntax::Empty => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Integer(part) => {
            if !types::integer(ty) {
                types::fail(model::ERROR_TYPE);
            }
            let k:types::Constant = types::constant_value(node, ty);
            if !model::same_type(k.ty, ty) {
                types::fail(model::ERROR_TYPE);
            }
            result.key = k.bits;
        },
        parse::Syntax::Boolean(part) => {
            if !model::same_type(ty, model::bool_type()) {
                types::fail(model::ERROR_TYPE);
            }
            if part {
                result.key = 1;
            }
        },
        parse::Syntax::Unit => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Null => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Zero => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Name(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::String(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Unary(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Binary(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Cast(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Call(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Field(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Index(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Record(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::FieldValue(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Array(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Repeat(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::SizeOf(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::AlignOf(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Pointer(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::VariantPattern(part) => {
            let v:types::Variant = types::variant(n.span.file, part.path);
            if !v.found || !model::same_type(v.ty, ty) || v.has_payload != part.has_payload {
                types::fail(model::ERROR_TYPE);
            }
            result.key = v.tag as usize;
            result.binding = part.binding;
            result.payload = v.payload;
            result.offset = v.offset;
        },
        parse::Syntax::Wildcard => {
            if t.kind == model::TYPE_ENUM {
                types::fail(model::ERROR_TYPE);
            }
            result.wildcard = true;
        },
        parse::Syntax::MatchArm(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Block(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Bind(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Assign(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Expression(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Unsafe(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::If(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::While(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Loop(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Return(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Break => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Continue => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Defer(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::Match(part) => {
            types::fail(model::ERROR_TYPE);
        },
        parse::Syntax::EmptyStatement => {
            types::fail(model::ERROR_TYPE);
        },
    }
    return result;
}

fn match_statement(n:parse::MatchValue) -> bool {
    let value:ir::SlotId = expr(n.value, model::no_type());
    let ty:model::TypeId = ir::type_of(value);
    let t:model::Type = types::info(ty);
    if !model::same_type(ty, model::bool_type()) && !types::integer(ty) && t.kind != model::TYPE_ENUM {
        types::fail(model::ERROR_TYPE);
    }
    var patterns:[256]usize = zero;
    var count:u32 = 0;
    var wildcard:bool = false;
    var arm:parse::NodeId = n.arms;
    while !parse::is_none(arm) {
        let item:parse::MatchArm = match_arm(arm);
        let p:Pattern = checked_pattern(item.pattern, ty);
        if wildcard {
            types::fail(model::ERROR_TYPE);
        }
        if p.wildcard {
            wildcard = true;
        } else {
            unsafe {
                var j:u32 = 0;
                while j < count {
                    if patterns[j as usize] == p.key {
                        types::fail(model::ERROR_TYPE);
                    }
                    j = j+1_u32;
                }
                if count >= 256_u32 {
                    model::limit((count as usize)+1_usize, 256);
                }
                patterns[count as usize] = p.key;
            }
            count = count+1_u32;
        }
        arm = parse::next(arm);
    }
    var required:u32 = 2;
    if t.kind == model::TYPE_ENUM {
        required = t.count;
    }
    if !wildcard && (types::integer(ty) || count != required) {
        types::fail(model::ERROR_TYPE);
    }
    var tested:ir::SlotId = value;
    if t.kind == model::TYPE_ENUM {
        tested = ir::load(ir::local_address(value, model::u32_type(), 0, true), model::u32_type());
    }
    let end:ir::LabelId = ir::label_id();
    var falls:bool = false;
    arm = n.arms;
    while !parse::is_none(arm) {
        let item:parse::MatchArm = match_arm(arm);
        let p:Pattern = checked_pattern(item.pattern, ty);
        let body:ir::LabelId = ir::label_id();
        let next:ir::LabelId = ir::label_id();
        if p.wildcard {
            ir::jump(body);
        } else {
            let condition:ir::SlotId = ir::binary(model::BIN_EQ, tested, ir::value(ir::type_of(tested), p.key), model::bool_type());
            ir::branch(condition, body, next);
        }
        ir::label(body);
        unsafe {
            let mark:u32 = binding_count;
            depth = depth+1_u32;
            if !model::is_no_name(p.binding) {
                let target:ir::SlotId = bind(p.binding, p.payload, false);
                ir::copy_to(target, ir::load(ir::local_address(value, p.payload, p.offset, true), p.payload));
            }
            let f:bool = block(item.body);
            falls = falls || f;
            ir::jump(end);
            binding_count = mark;
            depth = depth-1_u32;
        }
        ir::label(next);
        arm = parse::next(arm);
    }
    ir::panic_();
    if falls {
        ir::label(end);
    }
    return falls;
}

// The driver owns the complete lifetime; no reader may retain body/slot IDs.
static mut active:bool = false;
pub fn begin_function(decl:u32) -> parse::NodeId {
    unsafe {
        if active {
            types::fail(model::ERROR_INTERNAL);
        }
        active = true;
    }
    unsafe {
        if decl == 0_u32 || decl > model::decl_count() {
            types::fail(model::ERROR_INTERNAL);
        }
        let d:model::Decl = model::get_decl(decl);
        if d.kind != model::DECL_FUNCTION {
            types::fail(model::ERROR_INTERNAL);
        }
        // Sole production owner of function initialization. Tables stay in
        // their modules; only counts and small context fields are reset.
        parse::reset(d.file);
        ir::begin_function(decl);
        binding_count = 0;
        expression_depth = 0;
        place_depth = 0;
        depth = 0;
        unsafe_depth = 0;
        defer_count = 0;
        loop_count = 0;
        output = model::TypeEntry::Value(d.ty);
        file = d.file;
        parse::seek(d.file, d.start);
        let body:parse::NodeId = parse::block();
        types::bind_function_types();
        ir::locate(make model::Span {
            file:d.file,
            start:d.start,
            end:d.end
        });
        ir::label(ir::label_id());
        var i:u32 = 0;
        while i < d.count {
            let param:model::Param = model::get_param((d.first+i));
            let slot:ir::SlotId = bind(param.name, param.ty, false);
            ir::mark_parameter(slot);
            i = i+1_u32;
        }
        return body;
    }
}

pub fn check_body(body:parse::NodeId) -> () {
    unsafe {
        if !active {
            types::fail(model::ERROR_INTERNAL);
        }
        if block(body) {
            types::fail(model::ERROR_TYPE);
        }
        if !ir::is_closed() {
            ir::panic_();
        }
        types::finish_layouts();
        ir::finish_ir();
        if (ir::inst_count() as usize) > model::max_ir {
            model::max_ir = ir::inst_count() as usize;
        }
        if (parse::node_count() as usize) > model::max_ast {
            model::max_ast = parse::node_count() as usize;
        }
    }
    return ();
}

pub fn end_function() -> () {
    unsafe {
        if !active {
            types::fail(model::ERROR_INTERNAL);
        }
        active = false;
        binding_count = 0;
        defer_count = 0;
        loop_count = 0;
        parse::reset(0);
        ir::end_function();
    }
    return ();
}
