// Must compile, then panic 101: nominal types do not prove arena lifetime.
module trial::main;
import trial::arena;
fn run() -> u32 {
    arena::begin_function();
    let old:u32 = arena::literal(42);
    arena::end_function();
    arena::begin_function();
    let current:u32 = arena::literal(7);
    let invalid:u32 = arena::add(old,current);
    return 0;
}
