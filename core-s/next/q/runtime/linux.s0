# Linux RV64 C ABI. Preserve x27, which holds the initial process stack.
__b2_syscall6:
addi x17, x10, 0
addi x10, x11, 0
addi x11, x12, 0
addi x12, x13, 0
addi x13, x14, 0
addi x14, x15, 0
addi x15, x16, 0
ecall
jalr x0, 0(x1)
__b2_argc:
ld x10, 0(x27)
jalr x0, 0(x1)
__b2_argv:
slli x10, x10, 3
add x10, x27, x10
ld x10, 8(x10)
jalr x0, 0(x1)
