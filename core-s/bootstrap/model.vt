// Shared concrete B3 records. IDs are one-based; capacity is checked before append.
module bootstrap::model;
extern abi(C) fn __b2_syscall6(n:usize,a:usize,b:usize,c:usize,d:usize,e:usize,f:usize) -> usize;

pub struct Span { pub file:u32, pub start:u32, pub end:u32 }
pub struct Source { pub path:[]const u8, pub bytes:[]const u8, pub module_id:u32, pub import_first:u32, pub import_count:u32 }
pub struct Token { pub kind:u32, pub file:u32, pub start:u32, pub end:u32, pub number:usize, pub suffix:u32 }
pub struct Name { pub bytes:[]const u8, pub hash:usize }
pub struct Import { pub file:u32, pub module_id:u32, pub alias:u32, pub span:Span }
pub struct Type { pub kind:u32, pub a:u32, pub b:u32, pub flags:u32, pub size:usize, pub align:usize, pub first:u32, pub count:u32 }
pub struct Field { pub name:u32, pub ty:u32, pub flags:u32, pub offset:usize, pub span:Span }
pub struct Decl { pub kind:u32, pub name:u32, pub module_id:u32, pub file:u32, pub flags:u32, pub ty:u32, pub first:u32, pub count:u32, pub start:u32, pub end:u32, pub init_start:u32, pub init_end:u32, pub symbol:u32, pub bits:usize, pub state:u32 }
pub struct Param { pub name:u32, pub ty:u32, pub span:Span }
pub struct Slot { pub ty:u32, pub flags:u32, pub offset:usize, pub span:Span }
pub struct Inst { pub op:u32, pub dst:u32, pub a:u32, pub b:u32, pub c:u32, pub aux:u32, pub bits:usize, pub span:Span }
pub struct Data { pub symbol:u32, pub region:u32, pub align:usize, pub size:usize, pub first:usize, pub count:usize }
pub struct DataRelocation { pub object:u32, pub offset:usize, pub target:u32, pub addend:usize }
pub struct Symbol { pub name:u32, pub region:u32, pub offset:usize, pub size:usize, pub align:usize, pub defined:u32, pub kind:u32 }
pub struct Fixup { pub region:u32, pub kind:u32, pub offset:usize, pub symbol:u32, pub addend:usize }

pub const SOURCE_CAP:u32 = 32;
pub static mut sources:[33]Source = [Source { path:"", bytes:"", module_id:0, import_first:0, import_count:0 };33];
pub static mut source_count:u32 = 0;
pub const ASSEMBLY_CAP:u32 = 8;
pub static mut assemblies:[9]Source = [Source { path:"", bytes:"", module_id:0, import_first:0, import_count:0 };9];
pub static mut assembly_count:u32 = 0;
pub const NAME_CAP:u32 = 8192;
pub static mut names:[8193]Name = [Name { bytes:"", hash:0 };8193];
pub static mut name_count:u32 = 0;
pub const IMPORT_CAP:u32 = 1024;
pub static mut imports:[1025]Import = [Import { file:0, module_id:0, alias:0, span:Span { file:0, start:0, end:0 } };1025];
pub static mut import_count:u32 = 0;
pub const TYPE_CAP:u32 = 8192;
pub static mut types:[8193]Type = [Type { kind:0, a:0, b:0, flags:0, size:0, align:0, first:0, count:0 };8193];
pub static mut type_count:u32 = 0;
pub const FIELD_CAP:u32 = 32768;
pub static mut fields:[32769]Field = [Field { name:0, ty:0, flags:0, offset:0, span:Span { file:0, start:0, end:0 } };32769];
pub static mut field_count:u32 = 0;
pub const DECL_CAP:u32 = 8192;
pub static mut decls:[8193]Decl = [Decl { kind:0, name:0, module_id:0, file:0, flags:0, ty:0, first:0, count:0, start:0, end:0, init_start:0, init_end:0, symbol:0, bits:0, state:0 };8193];
pub static mut decl_count:u32 = 0;
pub const PARAM_CAP:u32 = 32768;
pub static mut params:[32769]Param = [Param { name:0, ty:0, span:Span { file:0, start:0, end:0 } };32769];
pub static mut param_count:u32 = 0;
pub const SLOT_CAP:u32 = 32768;
pub static mut slots:[32769]Slot = [Slot { ty:0, flags:0, offset:0, span:Span { file:0, start:0, end:0 } };32769];
pub static mut slot_count:u32 = 0;
pub const INST_CAP:u32 = 65536;
pub static mut insts:[65537]Inst = [Inst { op:0, dst:0, a:0, b:0, c:0, aux:0, bits:0, span:Span { file:0, start:0, end:0 } };65537];
pub static mut inst_count:u32 = 0;
pub const DATA_CAP:u32 = 16384;
pub static mut data_objs:[16385]Data = [Data { symbol:0, region:0, align:0, size:0, first:0, count:0 };16385];
pub static mut data_count:u32 = 0;
pub const DATA_RELOCATION_CAP:u32 = 32768;
pub static mut data_relocations:[32769]DataRelocation = [DataRelocation { object:0, offset:0, target:0, addend:0 };32769];
pub static mut data_relocation_count:u32 = 0;
pub const SYMBOL_CAP:u32 = 32768;
pub static mut symbols:[32769]Symbol = [Symbol { name:0, region:0, offset:0, size:0, align:0, defined:0, kind:0 };32769];
pub static mut symbol_count:u32 = 0;
pub const FIXUP_CAP:u32 = 65536;
pub static mut fixups:[65537]Fixup = [Fixup { region:0, kind:0, offset:0, symbol:0, addend:0 };65537];
pub static mut fixup_count:u32 = 0;

pub static mut args:[65537]u32 = [0;65537];
pub static mut arg_count:u32 = 0;
pub static mut parameter_slots:[257]u32 = [0;257];
pub static mut parameter_slot_count:u32 = 0;
pub static mut function_decl:u32 = 0;
pub static mut data_bytes:[8388608]u8 = [0;8388608];
pub static mut data_byte_count:usize = 0;
pub static mut name_bytes:[2097152]u8 = [0;2097152];
pub static mut name_byte_count:usize = 0;
pub static mut max_ast:usize = 0;
pub static mut max_ir:usize = 0;
pub static mut max_frame:usize = 0;
pub static mut source_bytes:usize = 0;
pub static mut error_code:u32 = 0;
pub static mut error_file:u32 = 0;
pub static mut error_offset:usize = 0;

// Diagnostic output is intentionally primitive and independent of lexer/driver.
fn output(text:[]const u8) -> () {
    var done:usize = 0;
    unsafe {
        while done < text.len {
            let remaining:usize = text.len-done;
            let written:usize = __b2_syscall6(64,2,core::addr(core::ptr_add(text.data,done)),remaining,0,0,0);
            if written != 0xfffffffffffffffc_usize {
                if written == 0_usize || written > remaining { return (); }
                done = done+written;
            }
        }
    }
    return ();
}
fn decimal(value:usize) -> () {
    var digits:[20]u8 = [0;20];
    var n:usize = value;
    var at:usize = 20;
    loop {
        at = at-1_usize;
        unsafe { digits[at] = ((n%10_usize) as u8)+48_u8; }
        n = n/10_usize;
        if n == 0_usize { break; }
    }
    unsafe { output(core::slice_from_raw_parts(core::ptr_add(core::slice_of(digits).data,at),20_usize-at)); }
    return ();
}

pub fn fail(code:u32, file:u32, offset:usize) -> () {
    unsafe { error_code = code; error_file = file; error_offset = offset; }
    if code == 1_u32 { output("E_PARSE"); }
    else { if code == 2_u32 { output("E_NAME"); }
    else { if code == 3_u32 { output("E_TYPE"); }
    else { if code == 4_u32 { output("E_PERMISSION"); }
    else { if code == 5_u32 { output("I_UNSUPPORTED"); }
    else { if code == 6_u32 { output("I_LIMIT"); }
    else { if code == 7_u32 { output("I_INTERNAL"); }
    else { if code == 8_u32 { output("E_IO"); }
    else { output("E_LINK"); } } } } } } } }
    output(" file="); decimal(file as usize); output(" byte="); decimal(offset); output("\n");
    unsafe { let ignored:usize = __b2_syscall6(93,1,0,0,0,0,0); }
    loop { }
    return ();
}
pub fn limit_at(actual:usize, capacity:usize, file:u32, offset:usize) -> () {
    output("actual="); decimal(actual); output(" limit="); decimal(capacity); output(" ");
    fail(6,file,offset);
    return ();
}

pub fn limit(actual:usize, capacity:usize) -> () {
    limit_at(actual,capacity,0,0);
    return ();
}

pub fn add_source(value:Source) -> u32 {
    unsafe {
        if source_count >= 32_u32 { limit((source_count as usize)+1_usize,32); }
        source_count = source_count+1_u32;
        sources[source_count as usize] = value;
        return source_count;
    }
}

pub fn add_assembly(value:Source) -> u32 {
    unsafe {
        if assembly_count >= 8_u32 { limit((assembly_count as usize)+1_usize,8); }
        assembly_count = assembly_count+1_u32;
        assemblies[assembly_count as usize] = value;
        return assembly_count;
    }
}

pub fn add_name(value:Name) -> u32 {
    unsafe {
        if name_count >= 8192_u32 { limit((name_count as usize)+1_usize,8192); }
        name_count = name_count+1_u32;
        names[name_count as usize] = value;
        return name_count;
    }
}

pub fn add_import(value:Import) -> u32 {
    unsafe {
        if import_count >= 1024_u32 { limit((import_count as usize)+1_usize,1024); }
        import_count = import_count+1_u32;
        imports[import_count as usize] = value;
        return import_count;
    }
}

