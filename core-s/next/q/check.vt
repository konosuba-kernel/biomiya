    }
}

fn block(node:parse::NodeId) -> bool {
    unsafe {
        let binding_mark:u32 = binding_count;
        let cleanup_mark:u32 = defer_count;
        depth = depth+1_u32;
        var item:parse::NodeId = block_first(node);
        var falls:bool = true;
        while !parse::is_none(item) {
            ir::ensure();
            let next:bool = statement(item);
            falls = falls && next;
            item = parse::get(item).next;
        }
        if falls {
            cleanup(cleanup_mark);
            if ir::is_closed() {
                falls = false;
            }
        } else if !ir::is_closed() {
            ir::panic_();
        }
        binding_count = binding_mark;
        defer_count = cleanup_mark;
        depth = depth-1_u32;
        return falls;
    }
}

