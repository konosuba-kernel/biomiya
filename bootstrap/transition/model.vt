    }
}

pub fn complete_type(id:u32, value:Type) -> () {
    let old:Type = get_type(id);
    if old.align != 0_usize || value.align == 0_usize || old.kind != value.kind || old.a != value.a || old.flags != value.flags {
        fail(ERROR_INTERNAL, 0, 0);
    }
    if old.kind == TYPE_ARRAY && old.b != value.b {
        fail(ERROR_INTERNAL, 0, 0);
    }
    unsafe {
        types[id as usize] = value;
    }
    return ();
}

pub fn complete_decl(id:u32, value:Decl) -> () {
    let old:Decl = get_decl(id);
    if old.state != 0_u32 || value.state != 2_u32 || old.kind != value.kind || old.name != value.name || old.file != value.file || old.module_id != value.module_id || old.flags != value.flags || old.symbol != value.symbol {
        fail(ERROR_INTERNAL, 0, 0);
    }
    unsafe {
        decls[id as usize] = value;
    }
    return ();
}

pub fn current_function() -> u32 {
    unsafe {
        return function_decl;
    }
}

pub fn select_function(id:u32) -> () {
    let d:Decl = get_decl(id);
    unsafe {
        if function_decl != 0_u32 || d.kind != DECL_FUNCTION || d.state != 2_u32 {
            fail(ERROR_INTERNAL, 0, 0);
        }
        function_decl = id;
        function_version = function_version+1_u32;
    }
    return ();
}

pub fn function_revision() -> u32 {
    unsafe {
        return function_version;
    }
}

pub fn add_source(value:Source) -> u32 {
    unsafe {
        if source_count >= 32_u32 {
            limit((source_count as usize)+1_usize, 32);
        }
        source_count = source_count+1_u32;
        sources[source_count as usize] = value;
        return source_count;
    }
}

pub fn add_assembly(value:Source) -> u32 {
    unsafe {
        if assembly_count >= 8_u32 {
            limit((assembly_count as usize)+1_usize, 8);
        }
        assembly_count = assembly_count+1_u32;
        assemblies[assembly_count as usize] = value;
        return assembly_count;
    }
}

pub fn add_name(value:Name) -> u32 {
    unsafe {
        if name_count >= 8192_u32 {
            limit((name_count as usize)+1_usize, 8192);
        }
        name_count = name_count+1_u32;
        names[name_count as usize] = value;
        return name_count;
    }
}

pub fn add_import(value:Import) -> u32 {
    unsafe {
        if import_count >= 1024_u32 {
            limit((import_count as usize)+1_usize, 1024);
        }
        import_count = import_count+1_u32;
        imports[import_count as usize] = value;
        return import_count;
    }
}

pub fn add_type(value:Type) -> u32 {
    unsafe {
        if type_used >= 8192_u32 {
            limit((type_used as usize)+1_usize, 8192);
        }
        type_used = type_used+1_u32;
        types[type_used as usize] = value;
        return type_used;
    }
}

pub fn add_field(value:Field) -> u32 {
    unsafe {
        if field_used >= 32768_u32 {
            limit((field_used as usize)+1_usize, 32768);
        }
        field_used = field_used+1_u32;
        fields[field_used as usize] = value;
        return field_used;
    }
}

pub fn add_decl(value:Decl) -> u32 {
    unsafe {
        if decl_used >= 8192_u32 {
            limit((decl_used as usize)+1_usize, 8192);
        }
        decl_used = decl_used+1_u32;
        decls[decl_used as usize] = value;
        return decl_used;
    }
}

pub fn add_param(value:Param) -> u32 {
    unsafe {
        if param_used >= 32768_u32 {
            limit((param_used as usize)+1_usize, 32768);
        }
        param_used = param_used+1_u32;
        params[param_used as usize] = value;
        return param_used;
    }
}

pub fn add_slot(value:Slot) -> u32 {
    unsafe {
        function_version = function_version+1_u32;
        if slot_used >= 32768_u32 {
            limit((slot_used as usize)+1_usize, 32768);
        }
        slot_used = slot_used+1_u32;
        slots[slot_used as usize] = value;
        return slot_used;
    }
}

pub fn add_inst(value:Inst) -> u32 {
    unsafe {
        function_version = function_version+1_u32;
        if inst_used >= 65536_u32 {
            limit((inst_used as usize)+1_usize, 65536);
        }
        inst_used = inst_used+1_u32;
        insts[inst_used as usize] = value;
        return inst_used;
    }
}

pub fn add_data(value:Data) -> u32 {
    unsafe {
        if data_count >= 16384_u32 {
            limit((data_count as usize)+1_usize, 16384);
        }
        data_count = data_count+1_u32;
        data_objs[data_count as usize] = value;
        return data_count;
    }
}

pub fn add_data_relocation(value:DataRelocation) -> u32 {
    unsafe {
        if data_relocation_count >= 32768_u32 {
            limit((data_relocation_count as usize)+1_usize, 32768);
        }
        data_relocation_count = data_relocation_count+1_u32;
        data_relocations[data_relocation_count as usize] = value;
        return data_relocation_count;
    }
}

pub fn add_symbol(value:Symbol) -> u32 {
    unsafe {
        if symbol_count >= 32768_u32 {
            limit((symbol_count as usize)+1_usize, 32768);
        }
        symbol_count = symbol_count+1_u32;
        symbols[symbol_count as usize] = value;
        return symbol_count;
    }
}

pub fn add_fixup(value:Fixup) -> u32 {
    unsafe {
        if fixup_count >= 65536_u32 {
            limit((fixup_count as usize)+1_usize, 65536);
        }
        fixup_count = fixup_count+1_u32;
        fixups[fixup_count as usize] = value;
        return fixup_count;
    }
}

pub fn add_arg(value:u32) -> u32 {
    unsafe {
        function_version = function_version+1_u32;
        if arg_used >= 65536_u32 {
            limit((arg_used as usize)+1_usize, 65536);
        }
        arg_used = arg_used+1_u32;
        args[arg_used as usize] = value;
        return arg_used;
    }
}

pub fn mark_parameter(value:u32) -> () {
    unsafe {
        require_id(value, slot_used);
        if slots[value as usize].flags != 0_u32 {
            fail(ERROR_INTERNAL, 0, 0);
        }
        slots[value as usize].flags = SLOT_PARAMETER;
        function_version = function_version+1_u32;
        if parameter_slot_used >= 256_u32 {
            limit((parameter_slot_used as usize)+1_usize, 256);
        }
        parameter_slot_used = parameter_slot_used+1_u32;
        parameter_slots[parameter_slot_used as usize] = value;
    }
    return ();
}

pub fn data_byte(value:u8) -> () {
    unsafe {
        if data_byte_count >= 8388608_usize {
            limit(data_byte_count+1_usize, 8388608);
        }
        data_bytes[data_byte_count] = value;
        data_byte_count = data_byte_count+1_usize;
    }
    return ();
}

pub fn equal(a:[]const u8, b:[]const u8) -> bool {
    if a.len != b.len {
        return false;
    }
    var i:usize = 0;
    while i < a.len {
        unsafe {
            if a[i] != b[i] {
                return false;
            }
        }
        i = i+1_usize;
    }
    return true;
}

pub fn name(text:[]const u8) -> u32 {
    var hash:usize = 2166136261;
    var i:usize = 0;
    unsafe {
        while i < text.len {
            hash = (hash ^ (text[i] as usize))*%16777619_usize;
            i = i+1_usize;
        }
        var id:u32 = 1;
        while id <= name_count {
            let item:Name = names[id as usize];
            if item.hash == hash && equal(item.bytes, text) {
                return id;
            }
            id = id+1_u32;
        }
        if text.len > 2097152_usize-name_byte_count {
            limit(name_byte_count+text.len, 2097152);
        }
        let start:usize = name_byte_count;
        i = 0;
        while i < text.len {
            name_bytes[name_byte_count] = text[i];
            name_byte_count = name_byte_count+1_usize;
            i = i+1_usize;
        }
        let saved:[]const u8 = core::slice_from_raw_parts(core::ptr_add(core::slice_of(name_bytes).data, start), text.len);
        return add_name(Name {
            bytes:saved,
            hash:hash
        });
    }
}

pub fn symbol(name_id:u32, kind:u32) -> u32 {
    unsafe {
        if name_id != 0_u32 {
            var i:u32 = 1;
            while i <= symbol_count {
                if symbols[i as usize].name == name_id {
                    if symbols[i as usize].kind != SYMBOL_UNSPECIFIED && kind != SYMBOL_UNSPECIFIED && symbols[i as usize].kind != kind {
                        fail(ERROR_LINK, 0, 0);
                    }
                    if symbols[i as usize].kind == SYMBOL_UNSPECIFIED {
                        symbols[i as usize].kind = kind;
                    }
                    return i;
                }
                i = i+1_u32;
            }
        }
        return add_symbol(Symbol {
            name:name_id,
            region:0,
            offset:0,
            size:0,
            align:1,
            defined:0,
            kind:kind
        });
    }
}

// Storage-layer reset, invoked by check::function for each function, reset_all
// for a new compilation, and the driver when leaving the source-function phase.
// Global types/declarations/data/symbols and target work tables are unaffected.
pub fn reset_function() -> () {
    unsafe {
        function_version = function_version+1_u32;
        if (inst_used as usize) > max_ir {
            max_ir = inst_used as usize;
        }
        slot_used = 0;
        inst_used = 0;
        arg_used = 0;
        parameter_slot_used = 0;
        function_decl = 0;
    }
    return ();
}

pub fn reset_all() -> () {
    unsafe {
        source_count = 0;
        assembly_count = 0;
        name_count = 0;
        name_byte_count = 0;
        import_count = 0;
        type_used = 0;
        field_used = 0;
        decl_used = 0;
        param_used = 0;
        data_count = 0;
        data_relocation_count = 0;
        symbol_count = 0;
        fixup_count = 0;
        data_byte_count = 0;
        max_ast = 0;
        max_ir = 0;
        max_frame = 0;
        source_bytes = 0;
        error_code = 0;
        error_file = 0;
        error_offset = 0;
        reset_function();
        max_ir = 0;
        var kind:u32 = TYPE_UNIT;
        while kind <= TYPE_USIZE {
            var size:usize = 1;
            if kind == TYPE_UNIT {
                size = 0;
            }
            if kind == TYPE_U32 {
                size = 4;
            }
            if kind == TYPE_USIZE {
                size = 8;
            }
            var alignment:usize = size;
            if alignment == 0_usize {
                alignment = 1;
            }
            let id:u32 = add_type(Type {
                kind:kind,
                a:0,
                b:0,
                flags:0,
                size:size,
                align:alignment,
                first:0,
                count:0
            });
            kind = kind+1_u32;
        }
    }
    return ();
}
