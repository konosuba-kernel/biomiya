module probe;
import bootstrap::model;
import bootstrap::lex;
import bootstrap::input;
import runtime::linux;
pub fn run() -> u32 {
 model::reset_all();
 var path:[]const u8 = "";
 match linux::argument(1) { linux::BytesResult::Value(p)=>{path=p;},linux::BytesResult::Failed(e)=>{return 2;}, }
 input::load(path);
 unsafe {
  if !model::equal(input::entry_name(),"probe::run") {return 3;}
  var file:u32 = 1;
  while file <= input::source_count() {
   var offset:usize = 0;
   loop {let t:model::Token=lex::next(file,offset);if t.kind==0_u32 {break;} offset=t.end as usize;}
   file=file+1_u32;
  }
  input::save(input::source(1).bytes);
 }
 return 0;
}
pub fn tokens() -> u32 {
 model::reset_all();
 unsafe {
  input::begin_compile();
  let file:u32 = input::add_source("test", "/*a /*b*/ */ 0xff_u8 123_456_usize abc \"a\\x00\" <<");
  input::freeze();
  let a:model::Token=lex::next(1,0);
  if a.kind!=2_u32 || a.number!=255_usize || a.suffix!=3_u32 || a.start!=13_u32 || a.end!=20_u32 {return 1;}
  let b:model::Token=lex::next(1,a.end as usize);
  if b.number!=123456_usize || b.suffix!=5_u32 {return 2;}
  let c:model::Token=lex::next(1,b.end as usize);
  if !lex::is(c,"abc") {return 3;}
  let d:model::Token=lex::next(1,c.end as usize);
  var out:[4]u8=[0;4];let n:usize=lex::decode(d,core::slice_of_mut(out));
  if n!=2_usize || out[0]!=97_u8 || out[1]!=0_u8 {return 4;}
  let e:model::Token=lex::next(1,d.end as usize);if !lex::is(e,"<<") {return 5;}
  let f:model::Token=lex::next(1,e.end as usize);if f.kind!=0_u32 {return 6;}
 }
 return 0;
}

// Direct client boundary and repeated-header lifecycle. This bypasses manifest
// load so a forgotten add_source guard or high-index reset cannot hide behind it.
pub fn capacity() -> u32 {
 model::reset_all();
 var overflow:bool = false;
 match linux::argument(1) {
  linux::BytesResult::Value(mode)=>{overflow=model::equal(mode,"overflow");},
  linux::BytesResult::Failed(e)=>{return e;},
 }
 var round:u32 = 0;
 while round < 2_u32 {
  input::begin_compile();
  var file:u32 = 1;
  while file <= 64_u32 {
   let added:u32 = input::add_source("memory", "module sample;");
   if added != file {return 10;}
   file=file+1_u32;
  }
  if overflow {let rejected:u32=input::add_source("extra", "");return 11;}
  input::freeze();
  if input::source_count()!=64_u32 || !model::equal(input::source(64).bytes,"module sample;") {return 12;}
  let name:model::NameId=model::name("sample");
  file=1;
  while file <= 64_u32 {
   input::complete_header(file,name,1,0);
   if !model::same_name(input::source(file).module_id,name) {return 13;}
   file=file+1_u32;
  }
  round=round+1_u32;
 }
 return 0;
}
