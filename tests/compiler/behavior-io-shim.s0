# Test only. argv[1] contains one lowercase mode byte; arm uppercases it only
# after input loading. Linux argv storage is writable for process lifetime.
# __behavior_arm: no args/result; clobbers x5,x6; preserves sp,x27 and callee saves.
__behavior_arm:
ld x5,16(x27)
lbu x6,0(x5)
addi x6,x6,-32
sb x6,0(x5)
jalr x0,0(x1)

# __b2_syscall6 keeps the production C ABI. Inject only armed file operations,
# never stderr. Modes: N normal, S short, W write error, Z zero progress,
# M chmod error, C close error, U write+unlink, V write+close+unlink,
# H chmod+unlink, L close+unlink. Trace markers [O/W/M/C/U] describe attempts.
__b2_syscall6:
ld x5,16(x27)
lbu x6,0(x5)
addi x5,x0,97
bgeu x6,x5,.Lreal
addi x5,x0,56
beq x10,x5,.Lopen
addi x5,x0,35
beq x10,x5,.Lunlink
sltiu x5,x11,3
bne x5,x0,.Lreal
addi x5,x0,64
beq x10,x5,.Lwrite
addi x5,x0,52
beq x10,x5,.Lmode
addi x5,x0,57
beq x10,x5,.Lclose
jump __b2_real
.Lopen:
addi x5,x0,79
jump .Ltrace
.Lwrite:
addi x5,x0,87
jump .Ltrace
.Lmode:
addi x5,x0,77
jump .Ltrace
.Lclose:
addi x5,x0,67
jump .Ltrace
.Lunlink:
addi x5,x0,85
.Ltrace:
# Preserve all syscall arguments and return address across stderr tracing.
addi x2,x2,-80
sd x1,0(x2)
sd x10,16(x2)
sd x11,24(x2)
sd x12,32(x2)
sd x13,40(x2)
sd x14,48(x2)
sd x15,56(x2)
sd x16,64(x2)
sd x17,72(x2)
addi x7,x0,91
sb x7,8(x2)
sb x5,9(x2)
addi x7,x0,93
sb x7,10(x2)
addi x17,x0,64
addi x10,x0,2
addi x11,x2,8
addi x12,x0,3
ecall
ld x1,0(x2)
ld x10,16(x2)
ld x11,24(x2)
ld x12,32(x2)
ld x13,40(x2)
ld x14,48(x2)
ld x15,56(x2)
ld x16,64(x2)
ld x17,72(x2)
addi x2,x2,80
ld x5,16(x27)
lbu x6,0(x5)
addi x5,x0,64
beq x10,x5,.Lwrite_result
addi x5,x0,52
beq x10,x5,.Lmode_result
addi x5,x0,57
beq x10,x5,.Lclose_result
addi x5,x0,35
beq x10,x5,.Lunlink_result
jump __b2_real
.Lwrite_result:
addi x5,x0,83
beq x6,x5,.Lshort
addi x5,x0,90
beq x6,x5,.Lzero
addi x5,x0,87
beq x6,x5,.Lpartial
addi x5,x0,85
beq x6,x5,.Lpartial
addi x5,x0,86
beq x6,x5,.Lpartial
jump __b2_real
.Lshort:
sltiu x5,x13,8
bne x5,x0,.Lreal
addi x13,x0,7
jump __b2_real
.Lpartial:
addi x5,x0,32
bne x13,x5,.Lio_error
addi x13,x0,7
jump __b2_real
.Lzero:
addi x10,x0,0
jalr x0,0(x1)
.Lmode_result:
addi x5,x0,77
beq x6,x5,.Lpermission
addi x5,x0,72
beq x6,x5,.Lpermission
jump __b2_real
.Lclose_result:
addi x5,x0,67
beq x6,x5,.Lclosed_error
addi x5,x0,76
beq x6,x5,.Lclosed_error
addi x5,x0,86
beq x6,x5,.Lclosed_error
jump __b2_real
.Lclosed_error:
# Simulate Linux close failure after releasing fd, so the caller must not retry.
addi x2,x2,-16
sd x1,0(x2)
call __b2_real
ld x1,0(x2)
addi x2,x2,16
jump .Lio_error
.Lunlink_result:
addi x5,x0,85
beq x6,x5,.Lpermission
addi x5,x0,86
beq x6,x5,.Lpermission
addi x5,x0,72
beq x6,x5,.Lpermission
addi x5,x0,76
beq x6,x5,.Lpermission
.Lreal:
jump __b2_real
.Lpermission:
addi x10,x0,-13
jalr x0,0(x1)
.Lio_error:
addi x10,x0,-5
jalr x0,0(x1)
