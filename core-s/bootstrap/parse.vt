module bootstrap::parse;
import bootstrap::model;
import bootstrap::lex;
import bootstrap::types;
// Node contract: tag is model::AST_*. Child/name/type IDs are one-based;
// zero means absent. next links argument, element, field, statement or arm lists.
// start is a source byte offset in the current function/initializer file.
// Fields not listed below are zero; bits stores an integer/bool literal value.
// INTEGER: a=optional suffix TypeId. BOOL/UNIT/NULL: no child fields.
// NAME/STRING: a=NameId. UNARY: a=UNARY_*, b=operand NodeId.
// BINARY: a=BIN_*, b=left, c=right. CAST: a=value, b=target TypeId.
// CALL: a=callee NameId, b=first argument. FIELD: a=base, b=field NameId.
// INDEX: a=base, b=index. STRUCT: a=TypeId, b=first FIELD_VALUE.
// FIELD_VALUE: a=field NameId, b=value. ARRAY: a=first element.
// REPEAT: a=value, b=element count. RESULT: a=TypeId, b=Ok/Err tag, c=payload.
// TRY: a=value. SIZEOF/ALIGNOF: a=TypeId. POINTER: a=TypeId, b=address value.
// RESULT_PATTERN: a=TypeId, b=Ok/Err tag, c=optional binding NameId,
//                 d=declared binding TypeId. WILDCARD: no fields.
// MATCH_ARM: a=pattern, b=body. BLOCK: a=first statement.
// BIND: a=NameId, b=TypeId, c=optional initializer, d=mutable (0/1).
// ASSIGN: a=place, b=value. EXPR/RETURN: a=value.
// UNSAFE/LOOP/DEFER: a=body. IF: a=condition, b=then, c=optional else.
// WHILE: a=condition, b=body. MATCH: a=value, b=first MATCH_ARM.
// BREAK/CONTINUE/EMPTY: no fields. All nodes expire on reset().

pub struct Node {
    pub tag:u32,
    pub a:u32,
    pub b:u32,
    pub c:u32,
    pub d:u32,
    pub next:u32,
    pub start:u32,
    pub bits:usize
}
pub static mut nodes:[32769]Node = [Node {
    tag:model::AST_INVALID,
    a:0,
    b:0,
    c:0,
    d:0,
    next:0,
    start:0,
    bits:0
};32769];
// Function/initializer arena: reset selects its file and expires every NodeId.
pub static mut count:u32 = 0;
static mut arena_file:u32 = 0;
static mut expression_depth:u32 = 0;
static mut block_depth:u32 = 0;
static mut statement_depth:u32 = 0;
static mut walk_depth:u32 = 0;
static mut string_buffer:[65536]u8 = [0;65536];

pub fn get(id:u32) -> Node {
    unsafe {
        if id == 0_u32 || id > count {
            types::fail(model::ERROR_INTERNAL);
        }
        return nodes[id as usize];
    }
}

pub fn add(tag:u32, a:u32, b:u32, c:u32, d:u32, bits:usize, start:u32) -> u32 {
    unsafe {
        if count >= 32768_u32 {
            model::limit((count as usize)+1_usize, 32768);
        }
        count = count+1_u32;
        nodes[count as usize] = Node {
            tag:tag,
            a:a,
            b:b,
            c:c,
            d:d,
            next:0,
            start:start,
            bits:bits
        };
        return count;
    }
}

pub fn append(tail:u32, node:u32) -> u32 {
    if tail != 0_u32 {
        unsafe {
            nodes[tail as usize].next = node;
        }
    }
    return node;
}

pub fn reset(file:u32) -> () {
    unsafe {
        if (count as usize) > model::max_ast {
            model::max_ast = count as usize;
        }
        count = 0;
        arena_file = file;
        expression_depth = 0;
        block_depth = 0;
        statement_depth = 0;
        walk_depth = 0;
    }
    return ();
}

pub fn location(node:u32) -> model::Span {
    let n:Node = get(node);
    unsafe {
        return model::Span {
            file:arena_file,
            start:n.start,
            end:n.start+1_u32
        };
    }
}

fn start() -> u32 {
    unsafe {
        return types::token.start;
    }
}

fn result_type() -> u32 {
    types::need("::");
    types::need("<");
    let a:u32 = types::type_expr(false);
    types::need(",");
    let b:u32 = types::type_expr(false);
    types::close_gt();
    return types::intern(model::TYPE_RESULT, a, b, 0);
}

pub fn expression(minimum:u32, head:bool) -> u32 {
    unsafe {
        if expression_depth >= 64_u32 {
            model::limit_at((expression_depth as usize)+1_usize, 64, types::token.file, types::token.start as usize);
        }
        expression_depth = expression_depth+1_u32;
    }
    let result:u32 = expression_inner(minimum, head);
    unsafe {
        expression_depth = expression_depth-1_u32;
    }
    return result;
}

// Opening [ has already been consumed; this function consumes the closing ].
fn array_expression(sp:u32) -> u32 {
    var value:u32 = 0;
    unsafe {
        if types::eat("]") {
            value = add(model::AST_ARRAY, 0, 0, 0, 0, 0, sp);
        } else {
            let first:u32 = expression(0, false);
            if types::eat(";") {
                let n:types::Constant = types::constant(0, model::TYPE_USIZE);
                if !types::integer(n.ty) {
                    types::fail(model::ERROR_TYPE);
                }
                if n.bits > 4294967295_usize {
                    model::limit_at(n.bits, 4294967295, types::token.file, types::token.start as usize);
                }
                types::need("]");
                value = add(model::AST_REPEAT, first, n.bits as u32, 0, 0, 0, sp);
            } else {
                var tail:u32 = first;
                while types::eat(",") && !types::at("]") {
                    tail = append(tail, expression(0, false));
                }
                types::need("]");
                value = add(model::AST_ARRAY, first, 0, 0, 0, 0, sp);
            }
        }
    }
    return value;
}

// Parse a path and its optional Result, pointer or struct constructor.
fn named_expression(sp:u32, head:bool) -> u32 {
    var value:u32 = 0;
    unsafe {
        if types::at("offsetof") || types::at("Option") {
            types::fail(model::ERROR_UNSUPPORTED);
        }
        let name:u32 = types::path();
        let text:[]const u8 = types::text(name);
        if model::equal(text, "Result") && types::at("::") {
            let ty:u32 = result_type();
            types::need("::");
            var tag:u32 = model::RESULT_OK;
            if types::eat("Ok") {
                tag = model::RESULT_OK;
            } else {
                types::need("Err");
                tag = model::RESULT_ERR;
            }
            types::need("(");
            let payload:u32 = expression(0, false);
            types::need(")");
            value = add(model::AST_RESULT, ty, tag, payload, 0, 0, sp);
        } else if model::equal(text, "core::ptr") && types::eat("::") {
            types::need("<");
            let ty:u32 = types::type_expr(false);
            types::close_gt();
            types::need("(");
            let arg:u32 = expression(0, false);
            types::need(")");
            value = add(model::AST_POINTER, ty, arg, 0, 0, 0, sp);
        } else if !head && types::eat("{") {
            if types::shadowed(name) {
                types::fail(model::ERROR_TYPE);
            }
            let decl:u32 = types::resolve(types::token.file, name, false);
            if decl == 0_u32 {
                types::fail(model::ERROR_NAME);
            }
            if model::decls[decl as usize].kind != model::DECL_STRUCT {
                types::fail(model::ERROR_TYPE);
            }
            let ty:u32 = model::decls[decl as usize].ty;
            types::layout(ty);
            var first:u32 = 0;
            var tail:u32 = 0;
            while !types::eat("}") {
                let field:u32 = types::ident();
                types::need(":");
                let expr:u32 = expression(0, false);
                let pair:u32 = add(model::AST_FIELD_VALUE, field, expr, 0, 0, 0, sp);
                if first == 0_u32 {
                    first = pair;
                }
                tail = append(tail, pair);
                if !types::eat(",") {
                    types::need("}");
                    break;
                }
            }
            value = add(model::AST_STRUCT, ty, first, 0, 0, 0, sp);
        } else {
            value = add(model::AST_NAME, name, 0, 0, 0, 0, sp);
        }

    }
    return value;
}

fn primary(sp:u32, head:bool) -> u32 {
    var value:u32 = 0;
    unsafe {
        if types::token.kind == model::TOKEN_NUMBER {
            value = add(model::AST_INTEGER, types::token.suffix, 0, 0, 0, types::token.number, sp);
            types::advance();
        } else if types::token.kind == model::TOKEN_STRING {
            let len:usize = lex::decode(types::token, core::slice_of_mut(string_buffer));
            let name:u32 = model::name(core::slice_from_raw_parts(core::slice_of(string_buffer).data, len));
            value = add(model::AST_STRING, name, 0, 0, 0, 0, sp);
            types::advance();
        } else if types::eat("true") {
            value = add(model::AST_BOOL, 0, 0, 0, 0, 1, sp);
        } else if types::eat("false") {
            value = add(model::AST_BOOL, 0, 0, 0, 0, 0, sp);
        } else if types::eat("null") {
            value = add(model::AST_NULL, 0, 0, 0, 0, 0, sp);
        } else if types::eat("(") {
            if types::eat(")") {
                value = add(model::AST_UNIT, 0, 0, 0, 0, 0, sp);
            } else {
                value = expression(0, false);
                types::need(")");
            }
        } else if types::eat("[") {
            value = array_expression(sp);
        } else if types::at("!") || types::at("~") || types::at("-") || types::at("*") {
            var op:u32 = model::UNARY_NOT;
            if types::at("~") {
                op = model::UNARY_BIT_NOT;
            }
            if types::at("-") {
                op = model::UNARY_NEG;
            }
            if types::at("*") {
                op = model::UNARY_DEREF;
            }
            types::advance();
            value = add(model::AST_UNARY, op, expression(12, head), 0, 0, 0, sp);
        } else if types::at("sizeof") || types::at("alignof") {
            var kind:u32 = model::AST_SIZEOF;
            if types::at("alignof") {
                kind = model::AST_ALIGNOF;
            }
            types::advance();
            types::need("(");
            let ty:u32 = types::type_expr(false);
            types::need(")");
            types::layout(ty);
            value = add(kind, ty, 0, 0, 0, 0, sp);
        } else {
            value = named_expression(sp, head);
        }
    }
    return value;
}

// Precedence climbing extends one primary; recursion budgets stay in expression().
fn expression_inner(minimum:u32, head:bool) -> u32 {
    let sp:u32 = start();
    var value:u32 = primary(sp, head);
    unsafe {
        loop {
            if minimum <= 13_u32 && types::eat(".") {
                value = add(model::AST_FIELD, value, types::ident(), 0, 0, 0, sp);
                continue;
            }
            if minimum <= 13_u32 && types::eat("[") {
                let index:u32 = expression(0, false);
                types::need("]");
                value = add(model::AST_INDEX, value, index, 0, 0, 0, sp);
                continue;
            }
            if minimum <= 13_u32 && types::eat("?") {
                value = add(model::AST_TRY, value, 0, 0, 0, 0, sp);
                continue;
            }
            if minimum <= 13_u32 && types::eat("(") {
                let target:Node = get(value);
                if target.tag != model::AST_NAME {
                    types::fail(model::ERROR_UNSUPPORTED);
                }
                var first:u32 = 0;
                var tail:u32 = 0;
                while !types::eat(")") {
                    let arg:u32 = expression(0, false);
                    if first == 0_u32 {
                        first = arg;
                    }
                    tail = append(tail, arg);
                    if !types::eat(",") {
                        types::need(")");
                        break;
                    }
                }
                value = add(model::AST_CALL, target.a, first, 0, 0, 0, sp);
                continue;
            }
            if minimum <= 11_u32 && types::eat("as") {
                value = add(model::AST_CAST, value, types::type_expr(false), 0, 0, 0, sp);
                continue;
            }
            let power:u32 = types::precedence();
            if power == 0_u32 || power < minimum {
                break;
            }
            let op:u32 = types::binop();
            types::advance();
            let right:u32 = expression(power+1_u32, head);
            value = add(model::AST_BINARY, op, value, right, 0, 0, sp);
        }
    }
    return value;
}

fn pattern() -> u32 {
    let sp:u32 = start();
    if types::eat("_") {
        return add(model::AST_WILDCARD, 0, 0, 0, 0, 0, sp);
    }
    if types::eat("Result") {
        let ty:u32 = result_type();
        types::need("::");
        var tag:u32 = model::RESULT_OK;
        if !types::eat("Ok") {
            types::need("Err");
            tag = model::RESULT_ERR;
        }
        types::need("(");
        var name:u32 = 0;
        var declared:u32 = 0;
        if !types::eat("_") {
            name = types::ident();
            types::need(":");
            declared = types::type_expr(false);
        }
        types::need(")");
        return add(model::AST_RESULT_PATTERN, ty, tag, name, declared, 0, sp);
    }
    unsafe {
        if types::token.kind == model::TOKEN_NUMBER || types::at("true") || types::at("false") {
            return expression(13, false);
        }
    }
    types::fail(model::ERROR_UNSUPPORTED);
    return 0;
}

pub fn block() -> u32 {
    unsafe {
        if block_depth >= 48_u32 {
            model::limit_at((block_depth as usize)+1_usize, 48, types::token.file, types::token.start as usize);
        }
        block_depth = block_depth+1_u32;
    }
    let result:u32 = block_inner();
    unsafe {
        block_depth = block_depth-1_u32;
    }
    return result;
}

fn block_inner() -> u32 {
    let sp:u32 = start();
    types::need("{");
    var mark:u32 = 0;
    unsafe {
        mark = types::value_name_count;
    }
    var first:u32 = 0;
    var tail:u32 = 0;
    while !types::eat("}") {
        let item:u32 = statement();
        if first == 0_u32 {
            first = item;
        }
        tail = append(tail, item);
    }
    unsafe {
        types::value_name_count = mark;
    }
    return add(model::AST_BLOCK, first, 0, 0, 0, 0, sp);
}

pub fn statement() -> u32 {
    unsafe {
        if statement_depth >= 64_u32 {
            model::limit_at((statement_depth as usize)+1_usize, 64, types::token.file, types::token.start as usize);
        }
        statement_depth = statement_depth+1_u32;
    }
    let result:u32 = statement_inner();
    unsafe {
        statement_depth = statement_depth-1_u32;
    }
    return result;
}

fn statement_inner() -> u32 {
    let sp:u32 = start();
    if types::eat(";") {
        return add(model::AST_EMPTY, 0, 0, 0, 0, 0, sp);
    }
    if types::at("{") {
        return block();
    }
    if types::eat("unsafe") {
        return add(model::AST_UNSAFE, block(), 0, 0, 0, 0, sp);
    }
    if types::at("let") || types::at("var") {
        var mutable:u32 = 0;
        if types::at("var") {
            mutable = 1;
        }
        types::advance();
        let name:u32 = types::ident();
        types::need(":");
        let ty:u32 = types::type_expr(false);
        types::layout(ty);
        var value:u32 = 0;
        if types::eat("=") {
            value = expression(0, false);
        }
        types::need(";");
        types::value_name(name);
        return add(model::AST_BIND, name, ty, value, mutable, 0, sp);
    }
    if types::eat("if") {
        let condition:u32 = expression(0, true);
        let then_:u32 = block();
        var other:u32 = 0;
        if types::eat("else") {
            if types::at("if") {
                let nested:u32 = statement();
                other = add(model::AST_BLOCK, nested, 0, 0, 0, 0, sp);
            } else {
                other = block();
            }
        }
        return add(model::AST_IF, condition, then_, other, 0, 0, sp);
    }
    if types::eat("while") {
        let condition:u32 = expression(0, true);
        return add(model::AST_WHILE, condition, block(), 0, 0, 0, sp);
    }
    if types::eat("loop") {
        return add(model::AST_LOOP, block(), 0, 0, 0, 0, sp);
    }
    if types::eat("return") {
        let value:u32 = expression(0, false);
        types::need(";");
        return add(model::AST_RETURN, value, 0, 0, 0, 0, sp);
    }
    if types::eat("break") {
        types::need(";");
        return add(model::AST_BREAK, 0, 0, 0, 0, 0, sp);
    }
    if types::eat("continue") {
        types::need(";");
        return add(model::AST_CONTINUE, 0, 0, 0, 0, 0, sp);
    }
    if types::eat("defer") {
        return add(model::AST_DEFER, block(), 0, 0, 0, 0, sp);
    }
    if types::eat("match") {
        let value:u32 = expression(0, true);
        types::need("{");
        var first:u32 = 0;
        var tail:u32 = 0;
        while !types::eat("}") {
            let p:u32 = pattern();
            types::need("=>");
            var mark:u32 = 0;
            unsafe {
                mark = types::value_name_count;
            }
            let pat:Node = get(p);
            if pat.tag == model::AST_RESULT_PATTERN && pat.c != 0_u32 {
                types::value_name(pat.c);
            }
            let body:u32 = block();
            unsafe {
                types::value_name_count = mark;
            }
            let arm:u32 = add(model::AST_MATCH_ARM, p, body, 0, 0, 0, sp);
            if first == 0_u32 {
                first = arm;
            }
            tail = append(tail, arm);
            if !types::eat(",") {
                types::need("}");
                break;
            }
        }
        return add(model::AST_MATCH, value, first, 0, 0, 0, sp);
    }
    if types::at("for") || types::at("resource") || types::at("enum") || types::at("type") {
        types::fail(model::ERROR_UNSUPPORTED);
    }
    let target:u32 = expression(0, false);
    if types::eat("=") {
        let value:u32 = expression(0, false);
        types::need(";");
        return add(model::AST_ASSIGN, target, value, 0, 0, 0, sp);
    }
    types::need(";");
    return add(model::AST_EXPR, target, 0, 0, 0, 0, sp);
}

fn walk_enter(node:u32) -> () {
    types::locate(location(node));
    unsafe {
        if walk_depth >= 64_u32 {
            types::limit((walk_depth as usize)+1_usize, 64);
        }
        walk_depth = walk_depth+1_u32;
    }
    return ();
}

fn walk_leave() -> () {
    unsafe {
        walk_depth = walk_depth-1_u32;
    }
    return ();
}

pub fn constant_value(node:u32, expected:u32) -> types::Constant {
    walk_enter(node);
    let result:types::Constant = constant_inner(node, expected);
    walk_leave();
    return result;
}

fn constant_inner(node:u32, expected:u32) -> types::Constant {
    let n:Node = get(node);
    var ty:u32 = expected;
    if n.tag == model::AST_INTEGER {
        if n.a != 0_u32 {
            ty = n.a;
        }
        if ty == model::TYPE_INVALID {
            ty = model::TYPE_USIZE;
        }
        let bits:usize = types::literal(n.bits, ty);
        return types::Constant {
            bits:bits,
            ty:ty
        };
    }
    if n.tag == model::AST_BOOL {
        return types::Constant {
            bits:n.bits,
            ty:model::TYPE_BOOL
        };
    }
    if n.tag == model::AST_UNIT {
        return types::Constant {
            bits:0,
            ty:model::TYPE_UNIT
        };
    }
    if n.tag == model::AST_NULL {
        if types::info(ty).kind != model::TYPE_POINTER {
            types::fail(model::ERROR_TYPE);
        }
        return types::Constant {
            bits:0,
            ty:ty
        };
    }
    if n.tag == model::AST_NAME {
        unsafe {
            let id:u32 = types::resolve(arena_file, n.a, false);
            if id == 0_u32 {
                types::fail(model::ERROR_NAME);
            }
            let d:model::Decl = model::decls[id as usize];
            if d.kind != model::DECL_CONST {
                types::fail(model::ERROR_UNSUPPORTED);
            }
            return types::Constant {
                bits:d.bits,
                ty:d.ty
            };
        }
    }
    if n.tag == model::AST_SIZEOF {
        return types::Constant {
            bits:types::info(n.a).size,
            ty:model::TYPE_USIZE
        };
    }
    if n.tag == model::AST_ALIGNOF {
        return types::Constant {
            bits:types::info(n.a).align,
            ty:model::TYPE_USIZE
        };
    }
    if n.tag == model::AST_CAST {
        let value:types::Constant = constant_value(n.a, 0);
        return types::cast(value, n.b);
    }
    if n.tag == model::AST_UNARY {
        let value:types::Constant = constant_value(n.b, expected);
        return types::unary(n.a, value);
    }
    if n.tag == model::AST_BINARY {
        let a:types::Constant = constant_value(n.b, expected);
        let b:types::Constant = constant_value(n.c, a.ty);
        if a.ty != b.ty {
            types::fail(model::ERROR_TYPE);
        }
        var result:u32 = a.ty;
        if n.a >= model::BIN_EQ {
            result = model::TYPE_BOOL;
        }
        return types::Constant {
            bits:types::apply(n.a, a.bits, b.bits, a.ty),
            ty:result
        };
    }
    types::fail(model::ERROR_UNSUPPORTED);
    return types::Constant {
        bits:0,
        ty:0
    };
}

fn field_value(list:u32, name:u32) -> u32 {
    var result:u32 = 0;
    var p:u32 = list;
    while p != 0_u32 {
        let item:Node = get(p);
        if item.a == name {
            if result != 0_u32 {
                types::fail(model::ERROR_NAME);
            }
            result = item.b;
        }
        p = item.next;
    }
    if result == 0_u32 {
        types::fail(model::ERROR_TYPE);
    }
    return result;
}

// Full static-initializer validation, with a conservative all-zero result.
// false does not prove nonzero bytes (addresses/strings remain relocations).
// Visit all aggregate items after a nonzero item; validate repeated expressions
// even when the repetition length is zero. Serialization may rely on this gate.
fn validate_static_zero(node:u32, ty:u32) -> bool {
    walk_enter(node);
    let result:bool = validate_static_zero_inner(node, ty);
    walk_leave();
    return result;
}

fn validate_static_zero_inner(node:u32, ty:u32) -> bool {
    let n:Node = get(node);
    let t:model::Type = types::info(ty);
    if n.tag == model::AST_STRING {
        if t.kind != model::TYPE_SLICE || t.a != model::TYPE_U8 || t.flags != model::TYPE_CONST {
            types::fail(model::ERROR_TYPE);
        }
        return false;
    }
    if n.tag == model::AST_CALL {
        let ignored:u32 = static_address(node, ty);
        return false;
    }
    if t.kind == model::TYPE_STRUCT {
        if n.tag != model::AST_STRUCT || n.a != ty {
            types::fail(model::ERROR_TYPE);
        }
        var i:u32 = 0;
        var all:bool = true;
        unsafe {
            while i < t.count {
                let field:model::Field = model::fields[(t.first+i) as usize];
                if !validate_static_zero(field_value(n.b, field.name), field.ty) {
                    all = false;
                }
                i = i+1_u32;
            }
        }
        var c:u32 = 0;
        var item:u32 = n.b;
        while item != 0_u32 {
            c = c+1_u32;
            item = get(item).next;
        }
        if c != t.count {
            types::fail(model::ERROR_TYPE);
        }
        return all;
    }
    if t.kind == model::TYPE_ARRAY {
        if n.tag == model::AST_REPEAT {
            if n.b != t.b {
                types::fail(model::ERROR_TYPE);
            }
            return validate_static_zero(n.a, t.a);
        }
        if n.tag != model::AST_ARRAY {
            types::fail(model::ERROR_TYPE);
        }
        var p:u32 = n.a;
        var c:u32 = 0;
        var all:bool = true;
        while p != 0_u32 {
            if !validate_static_zero(p, t.a) {
                all = false;
            }
            c = c+1_u32;
            p = get(p).next;
        }
        if c != t.b {
            types::fail(model::ERROR_TYPE);
        }
        return all;
    }
    if t.kind == model::TYPE_RESULT {
        if n.tag != model::AST_RESULT || n.a != ty {
            types::fail(model::ERROR_TYPE);
        }
        var payload:u32 = t.a;
        if n.b == model::RESULT_ERR {
            payload = t.b;
        }
        let empty:bool = validate_static_zero(n.c, payload);
        return n.b == model::RESULT_OK && empty;
    }
    if t.kind == model::TYPE_SLICE {
        types::fail(model::ERROR_UNSUPPORTED);
    }
    let value:types::Constant = constant_value(node, ty);
    if value.ty != ty {
        types::fail(model::ERROR_TYPE);
    }
    return value.bits == 0_usize;
}

pub fn put(offset:usize, bits:usize, size:usize) -> () {
    var i:usize = 0;
    unsafe {
        if offset > model::data_byte_count || size > model::data_byte_count-offset || size > 8_usize {
            types::fail(model::ERROR_INTERNAL);
        }
        while i < size {
            model::data_bytes[offset+i] = ((bits>>(i*8_usize))&255_usize) as u8;
            i = i+1_usize;
        }
    }
    return ();
}

pub fn string_data(name:u32) -> u32 {
    let bytes:[]const u8 = types::text(name);
    var size:usize = bytes.len;
    if size == 0_usize {
        size = 1;
    }
    unsafe {
        let first:usize = model::data_byte_count;
        var i:usize = 0;
        while i < bytes.len {
            model::data_byte(bytes[i]);
            i = i+1_usize;
        }
        if bytes.len == 0_usize {
            model::data_byte(0);
        }
        let symbol:u32 = model::symbol(0, model::SYMBOL_DATA);
        let ignored:u32 = model::add_data(model::Data {
            symbol:symbol,
            region:2,
            align:1,
            size:size,
            first:first,
            count:size
        });
        return symbol;
    }
}

fn static_address(node:u32, ty:u32) -> u32 {
    let n:Node = get(node);
    let t:model::Type = types::info(ty);
    unsafe {
        let name:[]const u8 = types::text(n.a);
        let mutable:bool = model::equal(name, "core::addr_of_mut") || model::equal(name, "addr_of_mut");
        if !mutable && !model::equal(name, "core::addr_of") && !model::equal(name, "addr_of") {
            types::fail(model::ERROR_UNSUPPORTED);
        }
        if n.b == 0_u32 || get(n.b).next != 0_u32 || get(n.b).tag != model::AST_NAME {
            types::fail(model::ERROR_UNSUPPORTED);
        }
        let id:u32 = types::resolve(arena_file, get(n.b).a, false);
        if id == 0_u32 {
            types::fail(model::ERROR_NAME);
        }
        let d:model::Decl = model::decls[id as usize];
        if d.kind != model::DECL_STATIC || t.kind != model::TYPE_POINTER || t.a != d.ty {
            types::fail(model::ERROR_TYPE);
        }
        if mutable && (d.flags&model::FLAG_MUTABLE) == 0_u32 {
            types::fail(model::ERROR_PERMISSION);
        }
        if t.flags == model::TYPE_MUTABLE && !mutable {
            types::fail(model::ERROR_TYPE);
        }
        return d.symbol;
    }
}

fn serialize(node:u32, ty:u32, object:u32, offset:usize) -> () {
    walk_enter(node);
    serialize_inner(node, ty, object, offset);
    walk_leave();
    return ();
}

fn serialize_inner(node:u32, ty:u32, object:u32, offset:usize) -> () {
    let n:Node = get(node);
    let t:model::Type = types::info(ty);
    unsafe {
        let destination:usize = model::data_objs[object as usize].first+offset;
        if t.kind == model::TYPE_STRUCT {
            var i:u32 = 0;
            while i < t.count {
                let field:model::Field = model::fields[(t.first+i) as usize];
                serialize(field_value(n.b, field.name), field.ty, object, offset+field.offset);
                i = i+1_u32;
            }
            return ();
        }
        if t.kind == model::TYPE_ARRAY {
            let stride:usize = types::info(t.a).size;
            if n.tag == model::AST_REPEAT {
                if t.b == 0_u32 {
                    return ();
                }
                let first:u32 = model::data_relocation_count+1_u32;
                serialize(n.a, t.a, object, offset);
                let last:u32 = model::data_relocation_count;
                var i:u32 = 1;
                while i < t.b {
                    let displacement:usize = (i as usize)*stride;
                    var byte:usize = 0;
                    while byte < stride {
                        model::data_bytes[destination+displacement+byte] = model::data_bytes[destination+byte];
                        byte = byte+1_usize;
                    }
                    var r:u32 = first;
                    while r <= last {
                        let ref:model::DataRelocation = model::data_relocations[r as usize];
                        if ref.object == object && ref.offset >= offset && ref.offset < offset+stride {
                            let ignored:u32 = model::add_data_relocation(model::DataRelocation {
                                object:object,
                                offset:ref.offset+displacement,
                                target:ref.target,
                                addend:ref.addend
                            });
                        }
                        r = r+1_u32;
                    }
                    i = i+1_u32;
                }
                return ();
            }
            var i:u32 = 0;
            var item:u32 = n.a;
            while i < t.b {
                serialize(item, t.a, object, offset+(i as usize)*stride);
                item = get(item).next;
                i = i+1_u32;
            }
            return ();
        }
        if t.kind == model::TYPE_RESULT {
            put(destination, n.b as usize, 4);
            var payload:u32 = t.a;
            if n.b == model::RESULT_ERR {
                payload = t.b;
            }
            serialize(n.c, payload, object, offset+(t.first as usize));
            return ();
        }
        if n.tag == model::AST_STRING {
            if t.kind != model::TYPE_SLICE || t.a != model::TYPE_U8 || t.flags != model::TYPE_CONST {
                types::fail(model::ERROR_TYPE);
            }
            let symbol:u32 = string_data(n.a);
            let ignored:u32 = model::add_data_relocation(model::DataRelocation {
                object:object,
                offset:offset,
                target:symbol,
                addend:0
            });
            put(destination+8_usize, types::text(n.a).len, 8);
            return ();
        }
        if n.tag == model::AST_CALL {
            let symbol:u32 = static_address(node, ty);
            let ignored:u32 = model::add_data_relocation(model::DataRelocation {
                object:object,
                offset:offset,
                target:symbol,
                addend:0
            });
            return ();
        }
        let value:types::Constant = constant_value(node, ty);
        if value.ty != ty {
            types::fail(model::ERROR_TYPE);
        }
        put(destination, value.bits, t.size);
    }
    return ();
}

pub fn collect() -> () {
    types::headers_collect();
    unsafe {
        var id:u32 = 1;
        while id <= model::decl_count {
            let d:model::Decl = model::decls[id as usize];
            if d.kind == model::DECL_STATIC {
                reset(d.file);
                types::seek(d.file, d.init_start);
                let value:u32 = expression(0, false);
                types::need(";");
                let t:model::Type = types::info(d.ty);
                let all_zero:bool = validate_static_zero(value, d.ty);
                var region:u32 = 2;
                if (d.flags&model::FLAG_MUTABLE) != 0_u32 {
                    region = 3;
                    if all_zero {
                        region = 4;
                    }
                }
                var size:usize = t.size;
                if size == 0_usize {
                    size = 1;
                }
                let first:usize = model::data_byte_count;
                var amount:usize = size;
                if region == 4_u32 {
                    amount = 0;
                }
                if amount > 8388608_usize-model::data_byte_count {
                    model::limit(model::data_byte_count+amount, 8388608);
                }
                var i:usize = 0;
                while i < amount {
                    model::data_byte(0);
                    i = i+1_usize;
                }
                let object:u32 = model::add_data(model::Data {
                    symbol:d.symbol,
                    region:region,
                    align:t.align,
                    size:size,
                    first:first,
                    count:amount
                });
                if region != 4_u32 {
                    serialize(value, d.ty, object, 0);
                }
            }
            id = id+1_u32;
        }
        // Static initializer arena is no longer needed by the function phase.
        reset(0);
    }
    return ();
}
